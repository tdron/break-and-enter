				<Item class="ModuleScript" referent="RBX00000000000000000000000000001E3C">
					<Properties>
						<string name="Name">Hud</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Hud
	---
	The always-on-screen interface:
	  * Cash + income (top left), inventory stats underneath
	  * SHOP, CAR and LOOT INDEX buttons
	  * Night/daytime clock (top centre) counting down to the next restock
	  * Alarm banner while a house's guards are chasing you
	  * Objective hint telling new players what to do next
	  * Treadmill training bar (while you run on your treadmill) and car speedometer
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local DayNight = require(script.Parent.DayNight)
local UI = require(script.Parent.UI)
local VehicleController = require(script.Parent.VehicleController)

local Hud = {}

local player = Players.LocalPlayer
local Theme = UI.Theme

export type Callbacks = {
	OnShop: () -> (),
	OnSpawnCar: () -> (),
	OnStorage: () -> (),
	OnIndex: () -> (),
}

export type Elements = {
	IndexButton: TextButton,
}

local NIGHT_COLOR = Color3.fromRGB(34, 42, 86)
local DAY_COLOR = Color3.fromRGB(235, 140, 30)

local function getNumber(name: string, default: number): number
	local value = player:GetAttribute(name)
	return if type(value) == "number" then value else default
end

local function getString(name: string): string
	local value = player:GetAttribute(name)
	return if type(value) == "string" then value else ""
end

local function makeStatRow(parent: Instance, order: number, icon: string, title: string): TextLabel
	local row: Frame = UI.new("Frame", {
		Name = title,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 26),
		LayoutOrder = order,
		Parent = parent,
	})
	UI.new("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Size = UDim2.new(0.6, 0, 1, 0),
		Font = Theme.BoldFont,
		Text = icon .. "  " .. title,
		TextColor3 = Theme.SubText,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})
	local value: TextLabel = UI.new("TextLabel", {
		Name = "Value",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.4, 0, 1, 0),
		Font = Theme.TitleFont,
		Text = "0",
		TextColor3 = Theme.Text,
		TextSize = 19,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})
	return value
end

local function makeButton(parent: Instance, order: number, text: string, color: Color3, callback: () -> ()): TextButton
	local button: TextButton = UI.new("TextButton", {
		Name = text,
		AutoButtonColor = true,
		BackgroundColor3 = color,
		Size = UDim2.fromOffset(132, 52),
		LayoutOrder = order,
		Font = Theme.TitleFont,
		Text = text,
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 22,
		TextStrokeTransparency = 0.6,
		Parent = parent,
	}, {
		UI.corner(12),
		UI.stroke(Color3.new(1, 1, 1), 2, 0.6),
		UI.gradient(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190)),
	})
	UI.bounce(button)
	button.Activated:Connect(function()
		UI.playSound(UI.Sounds.Click, 0.4, 1.4)
		callback()
	end)
	return button
end

function Hud.init(screen: ScreenGui, callbacks: Callbacks): Elements
	----------------------------------------------------------------------------
	-- Left column (kept vertically centred so it never covers the chat window)
	----------------------------------------------------------------------------
	local column: Frame = UI.new("Frame", {
		Name = "LeftColumn",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, 0),
		Size = UDim2.fromOffset(270, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		UI.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		UI.scaled(),
	})

	----------------------------------------------------------------------------
	-- Cash panel
	----------------------------------------------------------------------------
	local cashPanel: Frame = UI.new("Frame", {
		Name = "CashPanel",
		Size = UDim2.fromOffset(270, 78),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.1,
		LayoutOrder = 1,
		Parent = column,
	}, {
		UI.corner(14),
		UI.stroke(Theme.Gold, 2, 0.3),
	})
	local cashLabel: TextLabel = UI.new("TextLabel", {
		Name = "Cash",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 6),
		Size = UDim2.new(1, -28, 0, 40),
		Font = Theme.TitleFont,
		Text = "💰 $0",
		TextColor3 = Theme.Gold,
		TextSize = 34,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextStrokeTransparency = 0.7,
		Parent = cashPanel,
	})
	local incomeLabel: TextLabel = UI.new("TextLabel", {
		Name = "Income",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 46),
		Size = UDim2.new(1, -28, 0, 24),
		Font = Theme.BoldFont,
		Text = "+$0 / sec",
		TextColor3 = Theme.Green,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = cashPanel,
	})

	----------------------------------------------------------------------------
	-- Stats panel
	----------------------------------------------------------------------------
	local statsPanel: Frame = UI.new("Frame", {
		Name = "StatsPanel",
		Size = UDim2.fromOffset(270, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.15,
		LayoutOrder = 2,
		Parent = column,
	}, {
		UI.corner(14),
		UI.stroke(Theme.Stroke, 2, 0.4),
		UI.padding(10),
		UI.new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local bagValue = makeStatRow(statsPanel, 1, "🎒", "Loot Bag")
	local trunkValue = makeStatRow(statsPanel, 2, "🧳", "Car Trunk")
	local storageValue = makeStatRow(statsPanel, 3, "📦", "Warehouse")
	local speedValue = makeStatRow(statsPanel, 4, "👟", "Speed")

	----------------------------------------------------------------------------
	-- Buttons
	----------------------------------------------------------------------------
	local buttonColumn: Frame = UI.new("Frame", {
		Name = "Buttons",
		Size = UDim2.fromOffset(270, 52),
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		Parent = column,
	}, {
		UI.new("UIListLayout", {
			Padding = UDim.new(0, 6),
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	makeButton(buttonColumn, 1, "🛒 SHOP", Color3.fromRGB(255, 176, 40), callbacks.OnShop)
	makeButton(buttonColumn, 2, "🚗 CAR", Color3.fromRGB(60, 150, 255), callbacks.OnSpawnCar)
	local storageButton = makeButton(column, 3, "📦 STORAGE", Color3.fromRGB(90, 190, 130), callbacks.OnStorage)
	storageButton.Size = UDim2.fromOffset(270, 46)
	storageButton.TextSize = 21
	local indexButton = makeButton(column, 4, "📖 LOOT INDEX", Color3.fromRGB(170, 100, 255), callbacks.OnIndex)
	indexButton.Size = UDim2.fromOffset(270, 46)
	indexButton.TextSize = 21

	----------------------------------------------------------------------------
	-- Night / daytime clock
	----------------------------------------------------------------------------
	local clock: Frame = UI.new("Frame", {
		Name = "Clock",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(300, 52),
		BackgroundColor3 = NIGHT_COLOR,
		BackgroundTransparency = 0.12,
		Parent = screen,
	}, {
		UI.corner(26),
		UI.stroke(Color3.new(1, 1, 1), 2, 0.6),
		UI.scaled(),
	})
	local clockTitle: TextLabel = UI.new("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 3),
		Size = UDim2.new(1, 0, 0, 28),
		Font = Theme.TitleFont,
		Text = "",
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 24,
		TextStrokeTransparency = 0.7,
		Parent = clock,
	})
	local clockHint: TextLabel = UI.new("TextLabel", {
		Name = "Hint",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 0, 18),
		Font = Theme.BoldFont,
		Text = "",
		TextColor3 = Color3.fromRGB(225, 230, 255),
		TextSize = 14,
		Parent = clock,
	})

	----------------------------------------------------------------------------
	-- Alarm banner
	----------------------------------------------------------------------------
	local alarmBanner: Frame = UI.new("Frame", {
		Name = "AlarmBanner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 68),
		Size = UDim2.fromOffset(560, 64),
		BackgroundColor3 = Color3.fromRGB(200, 20, 30),
		Visible = false,
		Parent = screen,
	}, {
		UI.corner(14),
		UI.stroke(Color3.new(1, 1, 1), 3, 0.2),
		UI.scaled(),
	})
	local alarmText: TextLabel = UI.new("TextLabel", {
		Name = "Text",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 0.62),
		Font = Theme.TitleFont,
		Text = "🚨 ALARM! RUN! 🚨",
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 30,
		TextStrokeTransparency = 0.5,
		Parent = alarmBanner,
	})
	local alarmHint: TextLabel = UI.new("TextLabel", {
		Name = "Hint",
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0, 0.6),
		Size = UDim2.fromScale(1, 0.38),
		Font = Theme.BoldFont,
		Text = "Get off the property before the guards catch you!",
		TextColor3 = Color3.fromRGB(255, 225, 225),
		TextSize = 16,
		Parent = alarmBanner,
	})

	----------------------------------------------------------------------------
	-- Objective hint
	----------------------------------------------------------------------------
	local objective: TextLabel = UI.new("TextLabel", {
		Name = "Objective",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.fromOffset(640, 40),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.25,
		Font = Theme.BoldFont,
		Text = "",
		TextColor3 = Theme.Text,
		TextSize = 18,
		TextWrapped = true,
		Parent = screen,
	}, {
		UI.corner(12),
		UI.padding(6),
		UI.scaled(),
	})

	----------------------------------------------------------------------------
	-- Training bar
	----------------------------------------------------------------------------
	local trainingPanel: Frame = UI.new("Frame", {
		Name = "Training",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -70),
		Size = UDim2.fromOffset(440, 58),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.1,
		Visible = false,
		Parent = screen,
	}, {
		UI.corner(12),
		UI.stroke(Theme.Cyan, 2, 0.2),
		UI.scaled(),
	})
	local trainingTitle: TextLabel = UI.new("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(1, -200, 0, 24),
		Font = Theme.TitleFont,
		Text = "",
		TextColor3 = Theme.Cyan,
		TextSize = 19,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = trainingPanel,
	})
	local trainingRate: TextLabel = UI.new("TextLabel", {
		Name = "Rate",
		AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -12, 0, 4),
		Size = UDim2.fromOffset(180, 24),
		Font = Theme.BoldFont,
		Text = "",
		TextColor3 = Theme.Gold,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = trainingPanel,
	})
	local barBack: Frame = UI.new("Frame", {
		BackgroundColor3 = Color3.fromRGB(16, 18, 28),
		Position = UDim2.fromOffset(12, 32),
		Size = UDim2.new(1, -24, 0, 16),
		Parent = trainingPanel,
	}, { UI.corner(8) })
	local barFill: Frame = UI.new("Frame", {
		Name = "Fill",
		BackgroundColor3 = Theme.Cyan,
		Size = UDim2.fromScale(0, 1),
		Parent = barBack,
	}, { UI.corner(8) })

	----------------------------------------------------------------------------
	-- Speedometer
	----------------------------------------------------------------------------
	local speedo: Frame = UI.new("Frame", {
		Name = "Speedometer",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -70),
		Size = UDim2.fromOffset(170, 86),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.1,
		Visible = false,
		Parent = screen,
	}, {
		UI.corner(14),
		UI.stroke(Theme.Blue, 2, 0.3),
		UI.scaled(),
	})
	local speedoValue: TextLabel = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 58),
		Font = Theme.TitleFont,
		Text = "0",
		TextColor3 = Theme.Text,
		TextSize = 48,
		Parent = speedo,
	})
	UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 0, 24),
		Font = Theme.BoldFont,
		Text = "MPH",
		TextColor3 = Theme.SubText,
		TextSize = 16,
		Parent = speedo,
	})

	----------------------------------------------------------------------------
	-- Updating
	----------------------------------------------------------------------------
	local displayedCash = getNumber("Cash", 0)
	local targetCash = displayedCash

	local function updateStats()
		incomeLabel.Text = "+" .. Format.money(getNumber("Income", 0)) .. " / sec"
		local carried, bag = getNumber("Carried", 0), getNumber("BagCapacity", 2)
		bagValue.Text = string.format("%d / %d", carried, bag)
		bagValue.TextColor3 = if carried >= bag then Theme.Red else Theme.Text
		trunkValue.Text = string.format("%d / %d", getNumber("TrunkCount", 0), getNumber("TrunkCapacity", 4))
		local stored, storage = getNumber("StoredCount", 0), getNumber("StorageCapacity", 10)
		storageValue.Text = string.format("%d / %d", stored, storage)
		storageValue.TextColor3 = if stored >= storage then Theme.Orange else Theme.Text
		speedValue.Text = Config.speedStatForPoints(getNumber("SpeedPoints", 0))
	end

	local function updateObjective()
		local carried, bag = getNumber("Carried", 0), getNumber("BagCapacity", 2)
		local trunk = getNumber("TrunkCount", 0)
		local text: string
		if getString("AlarmHouse") ~= "" then
			text = "🚨 Escape the property! Guards won't follow you past the front fence."
		elseif player:GetAttribute("DataLoaded") ~= true then
			text = "Loading your hideout..."
		elseif player:GetAttribute("Training") == true then
			text = "🏃 Training! You can go AFK, you'll keep getting faster. Press ESCAPE to hop off."
		elseif carried >= bag then
			text = "🎒 Bag full! Load your car trunk [F] or drop the loot on your warehouse's green DEPOSIT pad."
		elseif carried > 0 then
			text = "💰 Bring your loot to the green DEPOSIT pad in your warehouse (or keep stealing!)"
		elseif trunk > 0 then
			text = "🧳 Park your car on your warehouse's yellow LOADING DOCK to unload the trunk."
		elseif DayNight.isDaytime() then
			text = "☀️ Daytime: the owners are home and every house is locked. Upgrade or train until dark!"
		elseif getNumber("StoredCount", 0) == 0 then
			text = "🏠 Spawn your 🚗 CAR, drive to a house, pick the lock and steal something!"
		else
			text = "🦝 Houses get harder down the street. Train on your treadmill to outrun the faster guard dogs!"
		end
		objective.Text = text
	end

	local function updateAlarm()
		local house = getString("AlarmHouse")
		alarmBanner.Visible = house ~= ""
		if house ~= "" then
			alarmText.Text = "🚨 ALARM AT THE " .. string.upper(house) .. "! 🚨"
			local guard = getString("AlarmGuard")
			alarmHint.Text = string.format("Get off the property before %s catch%s you!", if guard ~= "" then guard else "the guards", if guard ~= "" and string.sub(guard, -1) ~= "s" then "es" else "")
		end
	end

	local function updateTraining()
		local training = player:GetAttribute("Training") == true
		trainingPanel.Visible = training
		if training then
			local treadmillLevel = getNumber("Level_Treadmill", 1)
			local speed = Config.speedStatForPoints(getNumber("SpeedPoints", 0))
			trainingRate.Text = string.format("Lv %d · ⚡ %s", treadmillLevel, Config.treadmillText(treadmillLevel))
			trainingTitle.Text = string.format("🏃 Speed %d (%s studs/s)", speed, Format.short(getNumber("WalkSpeed", 16)))
			-- The bar fills up to the next whole speed point.
			UI.tween(barFill, 0.2, { Size = UDim2.fromScale(math.clamp(getNumber("SpeedProgress", 0), 0, 1), 1) })
		end
	end

	for _, name in { "Income", "Carried", "BagCapacity", "TrunkCount", "TrunkCapacity", "StoredCount", "StorageCapacity", "WalkSpeed" } do
		player:GetAttributeChangedSignal(name):Connect(function()
			updateStats()
			updateObjective()
		end)
	end
	player:GetAttributeChangedSignal("AlarmHouse"):Connect(function()
		updateAlarm()
		updateObjective()
	end)
	player:GetAttributeChangedSignal("DataLoaded"):Connect(updateObjective)
	local shownSeconds = -1
	local function updateClock(force: boolean?)
		local daytime = DayNight.isDaytime()
		local seconds = math.ceil(DayNight.getTimeLeft())
		if seconds == shownSeconds and not force then
			return
		end
		shownSeconds = seconds
		local countdown = string.format("%d:%02d", seconds // 60, seconds % 60)
		if daytime then
			clockTitle.Text = "☀️ DAYTIME · " .. countdown
			clockHint.Text = "Houses closed · restocking loot"
		else
			clockTitle.Text = "🌙 NIGHT · " .. countdown
			clockHint.Text = "Houses open · loot restocks at sunrise"
		end
		clock.BackgroundColor3 = if daytime then DAY_COLOR else NIGHT_COLOR
	end
	Workspace:GetAttributeChangedSignal("Daytime"):Connect(function()
		updateClock(true)
		updateObjective()
	end)
	player:GetAttributeChangedSignal("Training"):Connect(updateObjective)
	for _, name in { "Training", "SpeedPoints", "SpeedProgress", "Level_Treadmill" } do
		player:GetAttributeChangedSignal(name):Connect(updateTraining)
	end
	player:GetAttributeChangedSignal("Cash"):Connect(function()
		targetCash = getNumber("Cash", 0)
	end)

	updateStats()
	updateObjective()
	updateAlarm()
	updateTraining()
	updateClock(true)

	local pulse = 0
	RunService.RenderStepped:Connect(function(dt: number)
		-- Count the cash up/down smoothly.
		if displayedCash ~= targetCash then
			local difference = targetCash - displayedCash
			if math.abs(difference) < 1 then
				displayedCash = targetCash
			else
				displayedCash += difference * math.min(dt * 10, 1)
			end
			cashLabel.Text = "💰 " .. Format.money(math.floor(displayedCash + 0.5))
		end
		-- Pulse the alarm banner.
		if alarmBanner.Visible then
			pulse += dt * 8
			alarmBanner.BackgroundColor3 = Color3.fromRGB(150 + math.floor(70 * math.abs(math.sin(pulse))), 20, 30)
		end
		updateClock()
		-- Speedometer
		speedo.Visible = VehicleController.Driving
		if VehicleController.Driving then
			speedoValue.Text = tostring(math.floor(VehicleController.Speed + 0.5))
		end
	end)
	cashLabel.Text = "💰 " .. Format.money(displayedCash)
	return { IndexButton = indexButton }
end

return Hud
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000000000000000000000000001E3D">
					<Properties>
						<string name="Name">LootIndex</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	LootIndex
	---------
	The collection book: every stealable item in the game, grouped by the house
	it comes from, each with a little 3D picture. Items you haven't stolen yet
	are black silhouettes marked "???"; steal one and it's unlocked for good
	(the server saves the list and mirrors it in the "Discovered" attribute).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Items = require(ReplicatedStorage.Shared.Items)
local UI = require(script.Parent.UI)

local LootIndex = {}

local player = Players.LocalPlayer
local Theme = UI.Theme

type Card = {
	Item: Items.ItemDef,
	Frame: Frame,
	Picture: ViewportFrame,
	Name: TextLabel,
	Info: TextLabel,
	Unlocked: boolean,
}

type Section = {
	House: Config.HouseInfo,
	Count: TextLabel,
	Cards: { Card },
}

local window: Frame? = nil
local windowScale: UIScale? = nil
local progressLabel: TextLabel? = nil
local progressFill: Frame? = nil
local badge: TextLabel? = nil
local sections: { Section } = {}
local isOpen = false
local seen: { [string]: boolean } = {} -- discoveries already shown to the player
local unseen = 0
local baselined = false -- true once the saved collection has arrived (it never counts as "new")

local LOCKED_TINT = Color3.fromRGB(0, 0, 0)
local CARD_COLOR = Color3.fromRGB(36, 40, 62)

local function getDiscovered(): { [string]: boolean }
	local result: { [string]: boolean } = {}
	local value = player:GetAttribute("Discovered")
	if type(value) == "string" then
		for itemId in string.gmatch(value, "[^,]+") do
			result[itemId] = true
		end
	end
	return result
end

local function updateBadge()
	local label = badge
	if label then
		label.Visible = unseen > 0
		label.Text = if unseen > 9 then "9+" else tostring(unseen)
	end
end

local function makePicture(parent: Instance, def: Items.ItemDef): ViewportFrame
	-- UI.itemPicture strips the rarity aura, so the card shows the item itself.
	local picture = UI.itemPicture(parent, def.Id, UDim2.new(1, -12, 0, 92), UDim2.fromOffset(6, 6))
	picture.ImageColor3 = LOCKED_TINT
	return picture
end

local function setCard(card: Card, unlocked: boolean)
	card.Unlocked = unlocked
	local def = card.Item
	card.Picture.ImageColor3 = if unlocked then Color3.new(1, 1, 1) else LOCKED_TINT
	card.Picture.ImageTransparency = if unlocked then 0 else 0.15
	card.Name.Text = if unlocked then def.DisplayName else "???"
	card.Name.TextColor3 = if unlocked then Theme.Text else Theme.SubText
	card.Info.Text = if unlocked then string.format("%s · %s", def.Rarity, Format.money(def.Value)) else def.Rarity .. " · ???"
end

local function makeCard(parent: Instance, order: number, def: Items.ItemDef): Card
	local frame: Frame = UI.new("Frame", {
		Name = def.Id,
		BackgroundColor3 = CARD_COLOR,
		LayoutOrder = order,
		Parent = parent,
	}, {
		UI.corner(12),
		UI.stroke(Items.Rarities[def.Rarity].Color, 2, 0.55),
	})
	local picture = makePicture(frame, def)
	local name: TextLabel = UI.new("TextLabel", {
		Name = "ItemName",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(4, 101),
		Size = UDim2.new(1, -8, 0, 22),
		Font = Theme.TitleFont,
		Text = "???",
		TextColor3 = Theme.Text,
		TextScaled = true,
		Parent = frame,
	})
	local info: TextLabel = UI.new("TextLabel", {
		Name = "Info",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(4, 124),
		Size = UDim2.new(1, -8, 0, 18),
		Font = Theme.BoldFont,
		Text = def.Rarity,
		TextColor3 = Items.Rarities[def.Rarity].Color,
		TextSize = 14,
		Parent = frame,
	})
	local card: Card = { Item = def, Frame = frame, Picture = picture, Name = name, Info = info, Unlocked = false }
	setCard(card, false)
	return card
end

local function makeSection(parent: Instance, order: number, house: Config.HouseInfo): Section
	local tier = Config.HouseTiers[house.Tier]
	local guard = Config.Guards[house.Guard]
	local guardCount = if guard.Kind == "Drone" then 4 elseif house.Tier == 1 then 1 else 2
	local frame: Frame = UI.new("Frame", {
		Name = house.Id,
		BackgroundColor3 = Theme.PanelLight,
		BackgroundTransparency = 0.35,
		Size = UDim2.new(1, -10, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order,
		Parent = parent,
	}, {
		UI.corner(14),
		UI.padding(10),
		UI.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local header: Frame = UI.new("Frame", {
		Name = "Header",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 46),
		LayoutOrder = 1,
		Parent = frame,
	})
	UI.new("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -90, 0, 26),
		Font = Theme.TitleFont,
		Text = string.format("%s  %s", guard.Icon, string.upper(house.DisplayName)),
		TextColor3 = tier.Color,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = header,
	})
	UI.new("TextLabel", {
		Name = "Guard",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(1, -90, 0, 18),
		Font = Theme.BodyFont,
		Text = string.format(
			"%s%s %s · guarded by %s",
			string.rep("★", tier.Stars),
			string.rep("☆", 4 - tier.Stars),
			tier.Name,
			if guardCount == 1 then "a " .. guard.DisplayName else string.format("%d %ss", guardCount, guard.DisplayName)
		),
		TextColor3 = Theme.SubText,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = header,
	})
	local count: TextLabel = UI.new("TextLabel", {
		Name = "Count",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 6),
		Size = UDim2.fromOffset(90, 30),
		Font = Theme.TitleFont,
		Text = "0/0",
		TextColor3 = Theme.Gold,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = header,
	})
	local grid: Frame = UI.new("Frame", {
		Name = "Items",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
		Parent = frame,
	}, {
		UI.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(126, 146),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local cards: { Card } = {}
	for index, def in Items.forHouse(house.Id) do
		table.insert(cards, makeCard(grid, index, def))
	end
	return { House = house, Count = count, Cards = cards }
end

local function refresh()
	local discovered = getDiscovered()
	local found, total = 0, 0
	for _, section in sections do
		local houseFound = 0
		for _, card in section.Cards do
			local unlocked = discovered[card.Item.Id] == true
			if unlocked ~= card.Unlocked then
				setCard(card, unlocked)
			end
			if unlocked then
				houseFound += 1
			end
		end
		found += houseFound
		total += #section.Cards
		local complete = houseFound == #section.Cards and houseFound > 0
		section.Count.Text = string.format("%s%d/%d", if complete then "✅ " else "", houseFound, #section.Cards)
		section.Count.TextColor3 = if complete then Theme.Green else Theme.Gold
	end
	local label, fill = progressLabel, progressFill
	if label and fill then
		label.Text = string.format("%d / %d found", found, total)
		fill.Size = UDim2.fromScale(if total > 0 then found / total else 0, 1)
	end
	-- Count discoveries the player hasn't looked at yet (for the HUD badge).
	if isOpen or not baselined then
		seen = discovered
		unseen = 0
	else
		unseen = 0
		for itemId in discovered do
			if not seen[itemId] then
				unseen += 1
			end
		end
	end
	updateBadge()
end

function LootIndex.init(screen: ScreenGui)
	local scale = UI.scaled()
	local frame: Frame = UI.new("Frame", {
		Name = "LootIndex",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(760, 580),
		BackgroundColor3 = Theme.Panel,
		Visible = false,
		Parent = screen,
	}, {
		UI.corner(18),
		UI.stroke(Theme.Purple, 3, 0.1),
		scale,
	})
	window = frame
	windowScale = scale

	UI.new("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(20, 10),
		Size = UDim2.new(1, -90, 0, 50),
		Font = Theme.TitleFont,
		Text = "📖 LOOT INDEX",
		TextColor3 = Theme.Purple,
		TextSize = 36,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	progressLabel = UI.new("TextLabel", {
		Name = "Progress",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -74, 0, 12),
		Size = UDim2.fromOffset(260, 28),
		Font = Theme.TitleFont,
		Text = "",
		TextColor3 = Theme.Gold,
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = frame,
	})
	local bar: Frame = UI.new("Frame", {
		Name = "ProgressBar",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -74, 0, 44),
		Size = UDim2.fromOffset(260, 10),
		BackgroundColor3 = Color3.fromRGB(16, 18, 28),
		Parent = frame,
	}, { UI.corner(5) })
	progressFill = UI.new("Frame", {
		Name = "Fill",
		BackgroundColor3 = Theme.Purple,
		Size = UDim2.fromScale(0, 1),
		Parent = bar,
	}, { UI.corner(5) })
	local close: TextButton = UI.new("TextButton", {
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 14),
		Size = UDim2.fromOffset(44, 44),
		BackgroundColor3 = Theme.Red,
		Font = Theme.TitleFont,
		Text = "X",
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 26,
		Parent = frame,
	}, { UI.corner(10) })
	UI.bounce(close)
	close.Activated:Connect(function()
		LootIndex.close()
	end)

	local list: ScrollingFrame = UI.new("ScrollingFrame", {
		Name = "List",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(16, 70),
		Size = UDim2.new(1, -28, 1, -112),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Theme.Purple,
		Parent = frame,
	}, {
		UI.new("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for order, house in Config.Houses do
		table.insert(sections, makeSection(list, order, house))
	end

	UI.new("TextLabel", {
		Name = "Tip",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 20, 1, -8),
		Size = UDim2.new(1, -40, 0, 30),
		Font = Theme.BodyFont,
		Text = "💡 Every house has its own loot. Steal an item once to unlock it here forever. Rarer items show up less often!",
		TextColor3 = Theme.SubText,
		TextSize = 15,
		TextWrapped = true,
		Parent = frame,
	})

	-- Everything you'd discovered before this session counts as already seen. The server
	-- sets "Discovered" before "DataLoaded", so take the baseline once your data has loaded.
	local function takeBaseline()
		if not baselined and player:GetAttribute("DataLoaded") == true then
			seen = getDiscovered()
			baselined = true
		end
	end
	takeBaseline()
	player:GetAttributeChangedSignal("DataLoaded"):Connect(function()
		takeBaseline()
		refresh()
	end)
	player:GetAttributeChangedSignal("Discovered"):Connect(refresh)
	refresh()
end

-- Adds the little "NEW" counter to the HUD button that opens the index.
function LootIndex.attachBadge(button: GuiButton)
	badge = UI.new("TextLabel", {
		Name = "NewBadge",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -6, 0, 6),
		Size = UDim2.fromOffset(28, 28),
		BackgroundColor3 = Theme.Red,
		Font = Theme.TitleFont,
		Text = "",
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 16,
		Visible = false,
		ZIndex = 5,
		Parent = button,
	}, { UI.corner(14), UI.stroke(Color3.new(1, 1, 1), 2, 0) })
	updateBadge()
end

function LootIndex.open()
	local frame, scale = window, windowScale
	if not frame or not scale or isOpen then
		return
	end
	isOpen = true
	refresh()
	frame.Visible = true
	local target = UI.CurrentScale
	scale.Scale = target * 0.8
	UI.tween(scale, 0.18, { Scale = target }, Enum.EasingStyle.Back)
end

function LootIndex.close()
	local frame = window
	if not frame or not isOpen then
		return
	end
	isOpen = false
	frame.Visible = false
end

function LootIndex.toggle()
	if isOpen then
		LootIndex.close()
	else
		LootIndex.open()
	end
end

function LootIndex.isOpen(): boolean
	return isOpen
end

return LootIndex
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000000000000000000000000001E3E">
					<Properties>
						<string name="Name">Notifications</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Notifications
	-------------
	Toast messages that slide in on the right side of the screen.
]]

local UI = require(script.Parent.UI)

local Notifications = {}

local MAX_TOASTS = 5
local LIFETIME = 4.5

local KIND_COLORS: { [string]: Color3 } = {
	info = UI.Theme.Blue,
	success = UI.Theme.Green,
	error = UI.Theme.Red,
	money = UI.Theme.Gold,
	warning = UI.Theme.Orange,
	steal = UI.Theme.Purple,
	level = UI.Theme.Cyan,
}

local container: Frame? = nil
local order = 0
local toasts: { Frame } = {}

function Notifications.init(screen: ScreenGui)
	container = UI.new("Frame", {
		Name = "Notifications",
		-- Top-centre, under the alarm banner (the top-right is where Roblox shows the leaderboard).
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 88),
		Size = UDim2.fromOffset(440, 400),
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		UI.new("UIListLayout", {
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}),
		UI.scaled(),
	})
end

local function playKindSound(kind: string)
	local sounds = UI.Sounds
	if kind == "steal" then
		UI.playSound(sounds.Steal, 0.6, 1.1)
	elseif kind == "money" or kind == "success" then
		UI.playSound(sounds.Deposit, 0.5, 1.5)
	elseif kind == "error" then
		UI.playSound(sounds.Error, 0.4, 1.2)
	elseif kind == "level" then
		UI.playSound(sounds.LevelUp, 0.5, 1.3)
	elseif kind == "warning" then
		UI.playSound(sounds.Click, 0.5, 0.8)
	end
end

local function removeToast(toast: Frame)
	local index = table.find(toasts, toast)
	if index then
		table.remove(toasts, index)
	end
	if toast.Parent then
		toast:Destroy()
	end
end

function Notifications.show(text: string, kind: string?)
	local parent = container
	if not parent then
		return
	end
	local kindName = kind or "info"
	local color = KIND_COLORS[kindName] or UI.Theme.Blue
	order += 1

	local label: TextLabel = UI.new("TextLabel", {
		Name = "Message",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 0),
		Size = UDim2.new(1, -16, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Font = UI.Theme.BoldFont,
		Text = text,
		TextColor3 = UI.Theme.Text,
		TextSize = 17,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	local toast: Frame = UI.new("Frame", {
		Name = "Toast",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = UI.Theme.Panel,
		BackgroundTransparency = 0.05,
		LayoutOrder = order,
		Parent = parent,
	}, {
		UI.corner(10),
		UI.stroke(color, 2),
		UI.padding(10),
		UI.new("Frame", {
			Name = "Accent",
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Size = UDim2.new(0, 5, 1, 0),
		}, { UI.corner(3) }),
		label,
	})
	table.insert(toasts, toast)
	while #toasts > MAX_TOASTS do
		removeToast(toasts[1])
	end
	playKindSound(kindName)

	task.delay(LIFETIME, function()
		if not toast.Parent then
			return
		end
		UI.tween(toast, 0.35, { BackgroundTransparency = 1 })
		UI.tween(label, 0.35, { TextTransparency = 1 })
		local stroke = toast:FindFirstChildOfClass("UIStroke")
		if stroke then
			UI.tween(stroke, 0.35, { Transparency = 1 })
		end
		task.wait(0.4)
		removeToast(toast)
	end)
end

return Notifications
]]></ProtectedString>
					</Properties>
