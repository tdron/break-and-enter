	<Item class="ServerScriptService" referent="RBX00000000000000000000000000002635">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="Script" referent="RBX00000000000000000000000000002636">
			<Properties>
				<string name="Name">Server</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Steal an Item — server entry point
	==================================
	Boots every gameplay module and wires up the player lifecycle.

	  PlayerData  saving/loading + attributes the UI reads
	  Inventory   the loot you're carrying
	  Plots       personal warehouses (storage = passive income)
	  DayNight    the 5½-minute heist clock (night = steal, daytime = houses closed + restock)
	  Houses      lockpicking, loot, alarms, chases, guard defenders, lasers
	  Treadmills  each warehouse's personal (AFK-able, upgradable) treadmill
	  Economy     income ticks + the upgrade shop
	  Market      the sell point stall in the yard (loot -> cash on the spot)
]]

local Players = game:GetService("Players")

local DayNight = require(script.DayNight)
local Economy = require(script.Economy)
local Houses = require(script.Houses)
local Inventory = require(script.Inventory)
local Market = require(script.Market)
local Notify = require(script.Notify)
local PlayerData = require(script.PlayerData)
local Plots = require(script.Plots)
local Rebirth = require(script.Rebirth)
local Treadmills = require(script.Treadmills)

Plots.init()
DayNight.init()
Houses.init()
Treadmills.init()
Economy.init()
Market.init()
Rebirth.init()
PlayerData.start()

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid and humanoid:IsA("Humanoid") then
		humanoid.WalkSpeed = PlayerData.getWalkSpeed(player)
	end
	Inventory.refresh(player)

	-- Safety net: if the player didn't spawn at their warehouse (e.g. they joined
	-- before their plot was assigned), move them there.
	local root = character:WaitForChild("HumanoidRootPart", 10)
	local target = Plots.getSpawnCFrame(player)
	if root and root:IsA("BasePart") and target and (root.Position - target.Position).Magnitude > 60 then
		task.wait(0.25)
		if character.Parent then
			character:PivotTo(target)
		end
	end
end

local function onPlayerAdded(player: Player)
	-- Assign a warehouse right away so the first spawn happens there.
	Plots.assign(player)
	player.CharacterAdded:Connect(function(character: Model)
		onCharacterAdded(player, character)
	end)

	local session = PlayerData.load(player)
	if not player.Parent then
		PlayerData.release(player)
		return
	end

	Plots.refresh(player)
	Inventory.refresh(player)
	PlayerData.applyWalkSpeed(player)
	player:SetAttribute("DataLoaded", true)

	if not Plots.getPlot(player) then
		Notify.send(player, "All 6 warehouses are taken on this server. Drop loot on any DEPOSIT pad to sell it for cash.", "warning")
	end
	if not session.CanSave then
		Notify.send(player, "⚠️ " .. PlayerData.getSaveWarning(), "warning")
	end
	Notify.send(player, "Welcome to Steal an Item! 🦝 Rob houses, stash loot in your warehouse, get rich.", "info")
end

local function onPlayerRemoving(player: Player)
	Houses.onPlayerRemoving(player)
	Treadmills.onPlayerRemoving(player)
	Economy.onPlayerRemoving(player)
	Rebirth.onPlayerRemoving(player)
	Plots.release(player)
	PlayerData.release(player) -- saves (yields), so it goes last
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end
]]></ProtectedString>
			</Properties>
			<Item class="ModuleScript" referent="RBX00000000000000000000000000002637">
				<Properties>
					<string name="Name">DayNight</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	DayNight
	--------
	Runs the heist clock (every number is in Config.DayNight):
	  * NIGHT (5 min): every house is open for business.
	  * DAYTIME (30 s): the owners are home. Houses lock up, alarms end, anyone
	    still inside is shown the door, and EVERY house restocks its loot.
	    This is the only time loot comes back, once per 5½-minute cycle.

	Clients read the phase from Workspace attributes to fade the sky and show a
	countdown:
	  Daytime      boolean
	  PhaseEndsAt  Workspace:GetServerTimeNow() when the current phase ends
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Notify = require(script.Parent.Notify)

local DayNight = {}

local daytime = false
local phaseEndsAt = 0
local listeners: { (isDaytime: boolean) -> () } = {}

function DayNight.isDaytime(): boolean
	return daytime
end

-- Seconds until the current phase ends.
function DayNight.getTimeLeft(): number
	return math.max(0, phaseEndsAt - Workspace:GetServerTimeNow())
end

-- Calls `callback(isDaytime)` every time the phase changes.
function DayNight.onChanged(callback: (isDaytime: boolean) -> ())
	table.insert(listeners, callback)
end

local function setPhase(isDaytime: boolean)
	daytime = isDaytime
	local length = if isDaytime then Config.DayNight.DayLength else Config.DayNight.NightLength
	phaseEndsAt = Workspace:GetServerTimeNow() + length
	Workspace:SetAttribute("Daytime", isDaytime)
	Workspace:SetAttribute("PhaseEndsAt", phaseEndsAt)
	for _, callback in listeners do
		task.spawn(callback, isDaytime)
	end
	if isDaytime then
		Notify.all(
			string.format(
				"☀️ Daytime! The owners are home, so every house is locked for %d seconds while the loot restocks.",
				Config.DayNight.DayLength
			),
			"warning"
		)
	else
		Notify.all("🌙 Night falls! Every house is fully restocked and open. Go steal!", "info")
	end
end

-- Skips straight to the next phase (handy for testing in Studio's command bar).
function DayNight.advance()
	setPhase(not daytime)
end

function DayNight.init()
	daytime = false
	phaseEndsAt = Workspace:GetServerTimeNow() + Config.DayNight.NightLength
	Workspace:SetAttribute("Daytime", false)
	Workspace:SetAttribute("PhaseEndsAt", phaseEndsAt)
	task.spawn(function()
		while true do
			-- Wake up a few times a second so DayNight.advance() can shift the schedule.
			task.wait(0.25)
			if Workspace:GetServerTimeNow() >= phaseEndsAt then
				setPhase(not daytime)
			end
		end
	end)
end

return DayNight
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000000000000000000000000002638">
				<Properties>
					<string name="Name">Economy</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Economy
	-------
	* Pays every player their warehouse income once per second.
	* Handles upgrade purchases from the shop (validated on the server).
	* Adds the "Browse Upgrades" prompt to the shop's market stall in the yard.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local PlayerData = require(script.Parent.PlayerData)
local Plots = require(script.Parent.Plots)

local Economy = {}

local lastPurchase: { [Player]: number } = {}

local function applyUpgrade(player: Player, upgradeId: string)
	PlayerData.replicate(player)
	if upgradeId == "Storage" then
		Plots.refresh(player)
	end
	-- "Treadmill": Treadmills notices the new level by itself (its console updates every tick).
end

function Economy.purchase(player: Player, upgradeId: any): (boolean, string)
	if type(upgradeId) ~= "string" then
		return false, "Invalid upgrade."
	end
	local upgrade = Config.UpgradesById[upgradeId]
	if not upgrade then
		return false, "Unknown upgrade."
	end
	local session = PlayerData.get(player)
	if not session then
		return false, "Still loading your data..."
	end
	local now = os.clock()
	if (lastPurchase[player] or 0) + 0.2 > now then
		return false, "Slow down!"
	end
	lastPurchase[player] = now

	local level = session.Profile.Levels[upgradeId] or 1
	if level >= #upgrade.Values then
		return false, upgrade.DisplayName .. " is already maxed out!"
	end
	local cost = upgrade.Costs[level + 1]
	if not PlayerData.trySpend(player, cost) then
		return false, string.format("You need %s more cash!", Format.money(cost - session.Profile.Cash))
	end
	session.Profile.Levels[upgradeId] = level + 1
	applyUpgrade(player, upgradeId)

	return true,
		string.format(
			"%s %s upgraded to level %d (%s)!",
			upgrade.Icon,
			upgrade.DisplayName,
			level + 1,
			Config.describeUpgrade(upgradeId, level + 1)
		)
end

local function addShopPrompt()
	local map = Workspace:WaitForChild("Map")
	local counter = map:FindFirstChild("ShopCounter", true) -- the counter of one of the yard's two market stalls
	if not (counter and counter:IsA("BasePart")) then
		warn("[Economy] No ShopCounter part found; the shop is still available from the HUD button.")
		return
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "OpenShopPrompt"
	prompt.ActionText = "Browse Upgrades"
	prompt.ObjectText = "Upgrade Shop"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = counter
end

local function incomeLoop()
	while true do
		task.wait(1)
		for _, player in Players:GetPlayers() do
			local session = PlayerData.get(player)
			if session and session.Income > 0 then
				PlayerData.addCash(player, session.Income)
			end
		end
	end
end

function Economy.onPlayerRemoving(player: Player)
	lastPurchase[player] = nil
end

function Economy.init()
	ReplicatedStorage.Remotes.Purchase.OnServerInvoke = function(player: Player, upgradeId: any)
		local ok, message = Economy.purchase(player, upgradeId)
		return { Ok = ok, Message = message }
	end
	addShopPrompt()
	task.spawn(incomeLoop)
end

return Economy
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000000000000000000000000002639">
				<Properties>
					<string name="Name">Houses</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Houses
	------
	The heist part of the game:
	  * Locked doors you open with a "Pick Lock" prompt (harder houses take longer).
	  * Every house has its own set of loot (see Items) that spawns on furniture.
	  * Stealing anything trips the alarm: after a short wind-up the house's
	    defenders give chase. Who lives where is Config.Houses / Config.Guards:
	    a tuxedo cat, then a puppy, a labrador, a guard dog, the home owner, an
	    off-duty officer, a wizard, a T-Rex, security bots and finally the museum's
	    fleet of security cars. Get caught = BUSTED: you ragdoll where you were
	    caught instead of teleporting to the warehouse. Inside, the defender throws
	    you through the front door into the road; outside, it recovers your loot
	    and heads home with it.
	  * They do NOT give up at the property line any more: they chase you all the
	    way back down the street and turn around at the canyon mouth, so the yard
	    is the only safe place. While anybody is on a property (you or them)
	    everyone moves at the standard Roblox speed; the moment you are through
	    the front gate the real speeds apply — yours from the treadmill, theirs
	    from Config.Guards.Speed (and the late-game ones are very, very fast).
	  * The hardest houses also have blinking laser tripwires.
	  * Defenders are physical: each one drags a collider the size of its body around and is
	    stopped by walls, doors and furniture like anybody else. They get where they are going
	    by feeling for the wall first (Workspace:Blockcast) and stepping off their straight
	    line round it, and if an opening is too small for them - the T-Rex is 5.6 studs wide,
	    the cars 5.3 - they take the roomiest way past instead of grinding in the doorway.
	  * Anything with legs walks there: a deliberately choppy stop-motion cycle (see
	    WalkCycle / Config.Walk) driven by how fast the body is really moving, so a defender
	    pinned against a wall stops stepping instead of moonwalking on the spot. Hoverers
	    (drones), rollers (the museum's fleet) and the tracked security bots get nothing.
	  * DAYTIME (see DayNight): houses lock up, anyone inside is shown the door
	    and every house restocks. That's the only time loot comes back.

	Map layout expected (built by tools/map_builder.py):
	  Workspace.Map.Houses.<HouseId>  (Model named after its Config.Houses id; attributes Tier & DisplayName)
	    Zone        Part covering the whole property (invisible)
	    ItemSpots   Folder of Parts marking where loot appears
	    GuardDocks  Folder of Parts where the guards rest (pet beds / drone pads)
	    Doors       Folder of Models: a "Hinge" part + door parts (attribute OpenAngle)
	    Lasers      Folder of Parts (attribute Phase)
	    Route       Folder of invisible markers (Door, Hall, the room vias, Gate, Street) that a
	                defender walks between: the doorways, and the way in off the street, so that
	                one crossing the house goes through the openings rather than at the walls
	                around them.
	    Rooms       Invisible boxes over each room, attribute Via naming the Route node that is
	                that room's way out, so "get to the thing in the next room" is answered with
	                a doorway rather than a straight line at the wall between them.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Guards = require(ReplicatedStorage.Shared.Guards)
local WalkCycle = require(ReplicatedStorage.Shared.WalkCycle)
local ItemModels = require(ReplicatedStorage.Shared.ItemModels)
local Items = require(ReplicatedStorage.Shared.Items)
local DayNight = require(script.Parent.DayNight)
local Inventory = require(script.Parent.Inventory)
local Notify = require(script.Parent.Notify)
local PlayerData = require(script.Parent.PlayerData)

local BustedEvent = ReplicatedStorage.Remotes.Busted

type Spot = {
	Part: BasePart,
	Item: Model?,
	ItemId: string?,
}

-- A stable, serialisable description of the exact world spot from which a bag
-- item came. Inventory keeps this alongside each carried item until it is sold,
-- deposited, or reclaimed during a bust.
type ReturnedLoot = {
	ItemId: string,
	HouseId: string,
	SpotId: string,
}

type Guard = {
	Look: Guards.GuardModel,
	Root: BasePart,
	AlignPosition: AlignPosition,
	AlignOrientation: AlignOrientation,
	Home: CFrame, -- where the root rests
	Filter: RaycastParams, -- the cast filter: a defender never feels its own body with it
	ProbeParams: RaycastParams, -- the same, plus whatever the body is standing on or leaning on (see probe)
	Hidden: { any }, -- that list, one entry per thing hidden: resets itself on every look at the way ahead
	Flying: boolean,
	State: string, -- "Idle" | "Windup" | "Chase"
	ActivateAt: number,
	Bob: number, -- phase offset for the trotting bounce
	Trot: number, -- how bouncy this kind of defender is (cars don't bounce)
	Walk: WalkCycle.Cycle, -- the stop-motion legs (no limbs: nothing steps)
	LastPosition: Vector3, -- where the body was last frame, for measuring its real speed
	Move: Vector3?, -- the line it is currently walking, if the last look at the way ahead is
	MoveClear: number, -- still usable ... and how far that line is clear
	MoveDetour: boolean, -- the cached line is a step off the straight line, not the line itself
	Sight: number, -- seconds that look at the way ahead stays good for, before it looks again
	SlideSide: number, -- -1 / 0 / 1: the side it stepped off on, so it commits to a way round
	Blocked: number, -- looks in a row that found the straight line blocked (see wayAhead)
	ClearLooks: number, -- looks in a row that found it clear, before it stops leaning to a side
	Stuck: number, -- seconds it has wanted to move without actually moving
	Sidestep: number,
	Sidestepped: boolean,
	Pinned: number,
	LastWay: Vector3?,
	Way: Vector3?, -- the doorway or gate it is making for, until it is through it (see routeTo) -- seconds left of walking sideways rather than forwards
	RecoveredLoot: { ReturnedLoot }, -- returned only once this specific catcher reaches home
	RecoveredSack: BasePart?, -- visible proof that the road catcher took the loot
}

type Door = {
	Model: Model,
	Spot: Vector3, -- the hinge: where a defender walking home has to be to be let in
	Prompt: ProximityPrompt,
	Angle: NumberValue,
	Slam: Sound,
	OpenAngle: number,
	IsOpen: boolean,
	CloseAt: number,
}

type House = {
	Model: Model,
	Id: string,
	Name: string,
	LootHouse: string, -- whose loot table to roll from (normally Id)
	Tier: number,
	Settings: Config.HouseTier,
	GuardId: string,
	GuardInfo: Config.GuardInfo,
	ZoneCFrame: CFrame,
	ZoneHalfSize: Vector3,
	FrontInset: number, -- how far the front wall sits inside the property
	GuardSpeed: number, -- the defenders' speed once they are out on the street
	ChaseMaxX: number, -- chases never go further east than this house's own property
	Loot: Folder,
	Spots: { Spot },
	SpotById: { [string]: Spot },
	Guards: { Guard },
	Doors: { Door },
	Route: { [string]: Vector3 }, -- the doorways to thread (Rooms.<name>.Via names one; see routeTo)
	Rooms: { BasePart }, -- invisible boxes over the floors, named after the room they cover
	Via: { [string]: Vector3 }, -- the doorway out of each room, by room name
	Lasers: { BasePart },
	AlarmActive: boolean,
	LastOccupiedAt: number,
	Intruders: { [Player]: boolean },
}

type Thief = { Player: Player, Root: BasePart, Humanoid: Humanoid }

type MotorState = { Motor: Motor6D, Enabled: boolean }
type PartState = { Part: BasePart, CanCollide: boolean }
type Ragdoll = {
	Humanoid: Humanoid,
	Motors: { MotorState },
	Parts: { PartState },
	Constraints: { Instance },
	AutoRotate: boolean,
	PlatformStand: boolean,
	RequiresNeck: boolean,
}

local FEET_BELOW_ROOT = 3 -- a standard character's HumanoidRootPart floats this high above its feet
local CATCH_HEIGHT = 7 -- guards can't reach thieves this far above/below them
local SLEEPING = "💤"
local ALERT = "❗"
-- How much each kind of defender bounces while it runs (its size sets the catch radius).
local TROT = { Cat = 0.4, Dog = 0.4, Beast = 0.55, Human = 0.12, Wizard = 0.12, Robot = 0, Vehicle = 0 }

local Houses = {}

local houses: { House } = {}
local housesById: { [string]: House } = {}
-- Declared up here because the alarm opens the front door before the door code is defined.
local setDoorOpen: (door: Door, open: boolean, slam: boolean?) -> ()
local restoreRecoveredLoot: (loot: { ReturnedLoot }) -> number
local updateRecoveredSack: (guard: Guard) -> ()
local rng = Random.new()
local bustedUntil: { [Player]: number } = {}
local laserCooldown: { [Player]: number } = {}
local ragdolls: { [Model]: Ragdoll } = {}

local function playerFromHit(hit: BasePart): Player?
	local model = hit:FindFirstAncestorOfClass("Model")
	if not model then
		return nil
	end
	return Players:GetPlayerFromCharacter(model)
end

local function isInZone(house: House, position: Vector3): boolean
	local relative = house.ZoneCFrame:PointToObjectSpace(position)
	local half = house.ZoneHalfSize
	return math.abs(relative.X) <= half.X and math.abs(relative.Y) <= half.Y and math.abs(relative.Z) <= half.Z
end

-- A point on the ground, in the property's own coordinates: +Z points from the house out to the street.
local function lotPoint(house: House, localX: number, localZ: number): Vector3
	local half = house.ZoneHalfSize
	return house.ZoneCFrame:PointToWorldSpace(Vector3.new(localX, -half.Y + FEET_BELOW_ROOT, localZ))
end

-- Is this position still inside the building (rather than out in the front yard)?
local function insideHouse(house: House, position: Vector3): boolean
	return house.ZoneCFrame:PointToObjectSpace(position).Z < house.ZoneHalfSize.Z - house.FrontInset
end

-- Where a defender on the wrong side of the front door heads for: the middle of the doorway
-- itself. Everything a defender has to get through is on the house's centre line - the doorway,
-- the porch, the path and the gate in the fence - so asking for the doorway is asking for the one
-- line it can walk out (or in) on, rather than a diagonal at a door jamb it does not fit past.
-- Returns nil when there is no door in the way, or when the body is already in it.
local function throughTheDoor(house: House, from: Vector3, target: Vector3): Vector3?
	local wall = house.ZoneHalfSize.Z - house.FrontInset
	local here = house.ZoneCFrame:PointToObjectSpace(from).Z
	local there = house.ZoneCFrame:PointToObjectSpace(target).Z
	if (here < wall) == (there < wall) then
		return nil
	end
	-- A stud past the wall, on the far side: aiming there puts the body in the opening, and once
	-- it is in it the straight line to where it is really going goes through the opening too.
	local doorway = lotPoint(house, 0, (if here < wall then wall + 1 else wall - 1))
	if (Vector3.new(from.X - doorway.X, 0, from.Z - doorway.Z)).Magnitude <= 2.5 then
		return nil
	end
	return doorway
end

-- How far a chase can go: this house's own property, plus the street from the front door
-- all the way back west to the canyon mouth. Inside the yard (past the mouth) it is over.
local function inChaseArea(house: House, position: Vector3): boolean
	if isInZone(house, position) then
		return true
	end
	if position.X < Config.Alarm.SafeX or position.X > house.ChaseMaxX then
		return false
	end
	return math.abs(position.Z) <= Config.Alarm.LaneHalfWidth
end

-- Keeps a chasing defender inside that area (but it is free to roam its own property).
local function clampToChase(house: House, position: Vector3): Vector3
	if isInZone(house, position) then
		return position
	end
	return Vector3.new(
		math.clamp(position.X, Config.Alarm.SafeX, house.ChaseMaxX),
		position.Y,
		math.clamp(position.Z, -Config.Alarm.LaneHalfWidth, Config.Alarm.LaneHalfWidth)
	)
end

-- Inside a property everybody moves at the standard Roblox speed: a defender only gets to use
-- its listed speed once it is out on the street (and so does the thief, with whatever the
-- treadmill has given them).
local function chaseSpeed(house: House, position: Vector3): number
	return if Houses.isOnProperty(position) then Config.Alarm.InsideSpeed else house.GuardSpeed
end

-- Big defenders (the T-Rex, the cars) catch you with their body, not their centre point.
local function catchRadius(guard: Guard): number
	local size = guard.Look.Size
	return math.max(Config.Alarm.CatchRadius, math.max(size.X, size.Z) * 0.5)
end

local function isImmune(player: Player, now: number): boolean
	return (bustedUntil[player] or 0) > now
end

--------------------------------------------------------------------------------
-- Walking there without walking through things
--
-- A defender with a body cannot be dragged at a wall: it would scrape along it for ever, or jam
-- in a doorway it does not fit through. So each one works out its own way forward, a fraction of
-- a second at a time, out of one question asked of the engine - "how far can I go this way?" -
-- with a block cast shaped like the body:

--   * straight on while the way is clear,
--   * the first small turn off that line which opens up real ground when it is not, preferring
--     the side it already leaned to so it commits to a way round instead of dithering, and
--   * the roomiest line of all when it is boxed in (a wall it cannot walk round, a doorway too
--     narrow for it), which is also what slides a corner along a wall rather than into it.

-- The cast is shaped like the body, not its centre: the root's own collider, so a corner can no
-- more be walked through than the wall on either side of it.

local WAYPOINT_REACHED = 3 -- close enough to a doorway to count as through it
local WAYPOINT_THROUGH = 3 -- how far past a doorway to aim, so a body walks through instead of at it
local HALL_ROOM = "Hall" -- the room every other one opens off, and the way to the street
local RETURN_RADIUS = 2.5 -- close enough to its bed to be home again (studs)
local DOOR_RADIUS = 12 -- how close a defender walking home has to be for a door to be opened for it
local STEP_UP = 1.4 -- the tallest step (porch stairs, kerb) a defender walks up in one move
local PROBE_HEIGHT = 9 -- how high the floor probe starts above the body
local SIGHT_TIME = 0.12 -- seconds a look at the way ahead stays good before it looks again
local FLOOR_NORMAL = 0.7 -- a surface facing up at least this steeply is a floor to walk on, not a wall
local HEAD_ON = 0.75 -- how squarely a body has to be facing a surface it is touching to be stopped by it
local TOUCHING = 0.05 -- a hit nearer than this is something the body is already up against
local PROBE_TRIES = 4 -- things a look at the way ahead may discount before it gives up and says clear
local SIDESTEP_TIME = 0.4 -- how long a body that gets nowhere walks sideways for (see updateGuards)
local SIDESTEP_REACH = 2.5 -- how far it tries to walk sideways (studs)
local ROAD_Z = 20 -- the middle of the pavement: where a defender off the street walks back to
local OFF_ROAD = 6 -- and how far off it has to be before walking back is what it should be doing
-- (the gateway itself sits on the property line, so the trigger has to clear it)
local STUCK_SPEED = 4 -- slower than this and a defender is not walking, it is shuffling at something
local AIM_CLOSE = 1.5 -- being this close to where it was told to go is arrival, not being stuck
local PINNED_TIME = 1.5 -- standing still this long at one of its own doorways is wedged on the frame
local SQUEEZE_STEP = 2.0 -- and that much of a step is enough to be through it

local function distance_of(aim: Vector3, from: Vector3): number
	local flat = Vector3.new(aim.X - from.X, 0, aim.Z - from.Z)
	return flat.Magnitude
end

local function halfExtent(guard: Guard, direction: Vector3): number
	local size = guard.Root.Size
	return math.abs(direction.X) * size.X * 0.5
		+ math.abs(direction.Y) * size.Y * 0.5
		+ math.abs(direction.Z) * size.Z * 0.5
end

-- How far ahead a defender looks: further at speed (or it steps into the wall it just found),
-- capped so even a security car does not probe across the whole map.
-- The floor this defender is standing over, from a ray dropped straight down from above its head.
-- Something at hip height (a table it has walked under, a fence rail) is not a floor, so anything
-- higher than a step above its feet is ignored. Returns the height of the surface to stand on.
local function floorBelow(guard: Guard, position: Vector3): number?
	local origin = Vector3.new(position.X, position.Y + PROBE_HEIGHT, position.Z)
	local hit = Workspace:Raycast(origin, Vector3.new(0, -(PROBE_HEIGHT + STEP_UP + 4), 0), guard.Filter)
	if not hit then
		return nil
	end
	if hit.Position.Y > position.Y - guard.Look.RootHeight + STEP_UP then
		return nil
	end
	return hit.Position.Y
end

local function lookahead(speed: number): number
	return math.min(Config.Alarm.WallLookahead + speed * Config.Alarm.WallLookaheadPerSpeed, Config.Alarm.WallLookaheadMax)
end

-- One block cast from the body, in place, pointed where it wants to go. The guard's own model is
-- filtered out of it (its body starts inside that, and everything else it wears is CanQuery =
-- false), so what it feels is the world: walls, doors, furniture, and the other defenders.
-- Returns how many studs are clear, and the surface normal only when something is really there.
local function probe(guard: Guard, direction: Vector3, length: number, at: Vector3?): (number, Vector3?)
	if length <= 0 then
		return 0, nil
	end
	local root = guard.Root
	-- `at` asks the same question from a point along the way ("if I got that far, what then?").
	local base = if at then root.CFrame + (at - root.Position) else root.CFrame
	-- A cast reports the *nearest* thing it meets, and a body is always already touching things:
	-- the floor under its feet, the wall its shoulder is against. Anything it is touching comes
	-- back as a hit at no distance at all, and answering that would say "wedged" whichever way it
	-- was asked - including the ways it can plainly walk. So whatever it turns out to be leaning
	-- on or standing in is taken out of the cast and the cast is asked again; that is also the
	-- only way to look past it, because the floor under a body's feet is under them the whole way
	-- along the line.
	local hidden = guard.Hidden
	for index = #hidden, 2, -1 do
		hidden[index] = nil
	end
	for _ = 1, PROBE_TRIES do
		local hit = Workspace:Blockcast(base, root.Size, direction * length, guard.ProbeParams)
		if not hit then
			return length, nil
		end
		local normal = hit.Normal
		if normal.Magnitude < 0.5 then
			return length, nil
		end
		local distance = math.clamp(hit.Distance, 0, length)
		local touching = distance < TOUCHING
		local floor = normal.Y > FLOOR_NORMAL
		local glancing = direction:Dot(normal) > -HEAD_ON
		-- Something it can walk over rather than up against: a kerb, the garden path, the lip of
		-- a step, the rise onto a porch. Whichever face of it a cast reports, a surface low
		-- enough to stand on is not a wall - and that is the whole point of asking at any
		-- distance, because a body walking *at* a low step hits the step's face studs before it
		-- gets there, which reads as a wall and has it working its way along the edge instead of
		-- stepping up onto it.
		local underfoot = false
		local part = hit.Instance
		if part and part:IsA("BasePart") then
			underfoot = part.Position.Y + part.Size.Y * 0.5 <= root.Position.Y - guard.Look.RootHeight + STEP_UP
		end
		local walkOver = underfoot or (touching and (floor or glancing))
		if walkOver and hit.Instance then
			table.insert(hidden, hit.Instance)
			continue
		end
		-- Facing it squarely (or something genuinely in the way further along the line).
		return distance, normal
	end
	return length, nil
end

-- The name of the room this position is standing in, or nothing when it is not in one of them
-- (outside, or on its way through a doorway). See House.Rooms.
local function roomOf(house: House, position: Vector3): string?
	for _, roomPart in house.Rooms do
		local relative = roomPart.CFrame:PointToObjectSpace(position)
		local half = roomPart.Size / 2
		if math.abs(relative.X) <= half.X and math.abs(relative.Y) <= half.Y and math.abs(relative.Z) <= half.Z then
			return roomPart.Name
		end
	end
	return nil
end

-- Where a defender should head for to reach `aim` from where it is.
--
-- Out in the open that is simply the aim, and so is anything in the same room - furniture in the
-- way of something in the same room is just furniture, and the steering walks round it. But the
-- walls between rooms are another matter: every room in a house opens off the hall, and the hall
-- onto the street, so the way to anything in another room is out of this room's doorway
-- (Rooms.<name>.Via, put there by the map), down the hall, and in through the other room's. That
-- is a route a body can walk - and one that never asks it to find its way through a wall.
-- A few studs past a waypoint, on the line the body is walking: a doorway is something to go
-- *through*, and a body that stops dead in the middle of one - or clips a jamb coming at it
-- side-on - turns a clean walk through into a scrape along the frame. Aiming through it walks it
-- through. (For an opening the body is already level with, this is just a nudge along.)
local function throughPoint(from: Vector3, node: Vector3): Vector3
	local offset = Vector3.new(node.X - from.X, 0, node.Z - from.Z)
	if offset.Magnitude < 1e-3 then
		return node
	end
	return node + offset.Unit * WAYPOINT_THROUGH
end

local function routeTo(house: House, guard: Guard, aim: Vector3): Vector3
	local from = guard.Root.Position
	-- A waypoint it has already picked stays picked until it is through it. Asking the room boxes
	-- again every frame is what has a body standing in a doorway dithering between the room it
	-- just left and the one it is walking into, one stud either side of the line between them.
	local way = guard.Way
	if way and distance_of(way, from) > WAYPOINT_REACHED then
		return throughPoint(from, way)
	end
	guard.Way = nil

	local here, there = roomOf(house, from), roomOf(house, aim)
	-- A defender that has been shoved off the street - over the kerb, round a lamp post, along
	-- the pickets - walks back onto it before anything else. The road is the one stretch of
	-- ground every way in and out of a lot runs along, and a body working its way along a garden
	-- fence instead is how it ends up stuck in the corner of somebody's yard with its own gate
	-- on the far side of the fence.
	if here == nil and not Houses.isOnProperty(from) and math.abs(from.Z) - ROAD_Z > OFF_ROAD then
		local off = math.abs(from.Z) - ROAD_Z
		if off > OFF_ROAD then
			local road = Vector3.new(from.X, from.Y, if from.Z < 0 then -ROAD_Z else ROAD_Z)
			return Vector3.new(road.X, road.Y, road.Z)
		end
	end
	-- Off the lot and going back to it (or on it and going off): the way in and out is the garden
	-- gate - the one gap in the front fence, in the middle of the path. Walking at the house
	-- across the front fence, or at the street across it, is how a body ends up pacing along the
	-- pickets for ever: the gate is on the house's centre line, and so is everything else it has
	-- to get through, so the way in and out of a lot is one straight line through the gate.
	if here == nil then
		local gate = house.Route.Gate
		local leaving = Houses.isOnProperty(from) and not Houses.isOnProperty(aim)
		local coming = not Houses.isOnProperty(from) and Houses.isOnProperty(aim)
		-- The way in or out of a lot. Leaving is the gateway and then the street; coming home it
		-- is the other way round, so that the walk in is made along the fence and the turn
		-- through the gateway happens square in front of it rather than across the pickets.
		--
		-- Which of the two a body coming home is walking to is decided by where it is, not by
		-- which one it has most recently been near: "the far one" is what has a body stepping
		-- over its own marker and straight back out to the marker it just left, for ever. Past
		-- the pavement marker the gateway is the nearer of the two, and that is the sign that
		-- the approach is done with and the way in is through the gate.
		local street = house.Route.Street
		if leaving then
			if distance_of(gate, from) > WAYPOINT_REACHED then
				guard.Way = gate
				return throughPoint(from, gate)
			end
		elseif coming then
			local approaching = street
				and distance_of(gate, from) > distance_of(gate, street)
				and distance_of(street, from) > WAYPOINT_REACHED
			if approaching then
				guard.Way = street
				return throughPoint(from, street)
			end
			if distance_of(gate, from) > WAYPOINT_REACHED then
				guard.Way = gate
				return throughPoint(from, gate)
			end
		end
		-- Out of doors and going indoors (the bed in its own room, the quarry in one of ours):
		-- in through the front door first. Its marker stands in the middle of the doorway - the
		-- door leaf is one more thing to walk round, and a body aimed at the middle of the
		-- opening has the room to do it - and the marker for the hall, the room every doorway
		-- opens off, stands a few studs inside it.
		if there ~= nil then
			local door, hall = house.Route.Door, house.Route.Hall
			if door and distance_of(door, from) > WAYPOINT_REACHED then
				guard.Way = door
				return throughPoint(from, door)
			end
			if hall and distance_of(hall, from) > WAYPOINT_REACHED then
				guard.Way = hall
				return throughPoint(from, hall)
			end
		end
	end
	if here == there then
		return aim
	end
	local goal = throughTheDoor(house, from, aim) or aim
	-- A room: its own way out is the doorway onto the hall. From the hall, the way on is the
	-- doorway of the room it is heading for. Out of doors there is nothing to thread - the door
	-- in the front wall is the aim (see throughTheDoor).
	local room = if here == HALL_ROOM then there elseif here ~= nil then here else nil
	local via = if room then house.Via[room] else nil
	if via and distance_of(via, from) > WAYPOINT_REACHED then
		guard.Way = via
		return throughPoint(from, via)
	end
	return goal
end

local function aroundTheCorner(guard: Guard, from: Vector3, aim: Vector3, direction: Vector3): (Vector3?, number?)
	local reach = lookahead(guard.AlignPosition.MaxVelocity or 0)
	local side = if guard.SlideSide ~= 0 then guard.SlideSide else 1
	local bestAlong: number? = nil
	local bestWay: Vector3? = nil
	for _, turn in { side, -side } do
		local turned = CFrame.Angles(0, math.rad(90 * turn), 0) * direction
		local clear = select(1, probe(guard, turned, reach * 3))
		for _, along in { 3, 6, 10, 16 } do
			if along <= clear and (bestAlong == nil or along < bestAlong) then
				local point = from + turned * along
				local toGoal = Vector3.new(aim.X - point.X, 0, aim.Z - point.Z)
				local left = toGoal.Magnitude
				local towards = if left > 0.1 then toGoal / left else direction
				-- Stepping sideways is a way round something; stepping *away* from where it is
				-- going is how a body that just follows clear ground ends up deeper in a dead end
				-- (behind a fence, in somebody's front yard) with nothing but walls left.
				if turned:Dot(towards) < -0.05 then
					continue
				end
				-- And the point has to have a line on to the goal, looked at far enough ahead
				-- that the wall it is stepping round shows up in the answer.
				if left > 0.1 and not select(2, probe(guard, towards, math.min(left, math.max(reach * 2, 24)), point)) then
					bestAlong, bestWay = along, turned
				end
			end
		end
	end
	if bestWay and bestAlong then
		guard.SlideSide = if bestWay:Dot(CFrame.Angles(0, math.rad(90), 0) * direction) > 0 then 1 else -1
		return bestWay, bestAlong
	end
	return nil
end

-- Which line to walk. The expensive half of steering, so it is asked for a few times a second at
-- most (see steer): a clear look costs one cast, and working out a way round costs several.
--
-- When the straight line is blocked the defender first looks for a one-turn detour (above), and
-- failing that goes *round*: it turns off its line the same way every time - the side it first
-- found room on - until something opens up, which is how anything with a body works its way
-- along a wall and round the end of it. Turning back the way it came as soon as that looks clear
-- too is what has it dithering in corners instead of getting anywhere.
local TURNS = { 30, 50, 70, 90, 110, 130, 150 }
local GIVE_UP = 60 -- blocked looks in a row before it tries going round the other way instead
local COMMITTED = 3 -- clear looks in a row before it stops leaning to that side

local function wayAhead(guard: Guard, direction: Vector3, aim: Vector3, from: Vector3): (Vector3, number, number, boolean)
	local reach = lookahead(guard.AlignPosition.MaxVelocity or 0)
	local clear, blocked = probe(guard, direction, reach)
	if not blocked then
		guard.Blocked = 0
		guard.ClearLooks += 1
		if guard.ClearLooks >= COMMITTED then
			guard.SlideSide = 0
		end
		return direction, clear, distance_of(aim, from) + 1, false
	end

	guard.ClearLooks = 0
	local corner, along = aroundTheCorner(guard, from, aim, direction)
	if corner and along then
		-- Round the corner and straight at it from there: walk exactly that far, then look again.
		return corner, along, along, true
	end

	guard.Blocked += 1
	if guard.Blocked > GIVE_UP then
		-- Been trying to get round something for a while now: it is probably the wrong way round.
		guard.Blocked, guard.SlideSide = 0, -guard.SlideSide
	end
	if guard.SlideSide == 0 then
		-- First look at this obstacle: lean to whichever side has the more room on it.
		local right = select(1, probe(guard, CFrame.Angles(0, math.rad(30), 0) * direction, reach))
		local left = select(1, probe(guard, CFrame.Angles(0, math.rad(-30), 0) * direction, reach))
		guard.SlideSide = if right >= left then 1 else -1
	end

	for _, degrees in TURNS do
		local turned = CFrame.Angles(0, math.rad(degrees * guard.SlideSide), 0) * direction
		local turnedClear, turnedBlocked = probe(guard, turned, reach)
		if not turnedBlocked then
			return turned, turnedClear, distance_of(aim, from) + 1, true
		end
	end
	-- Everything up to facing the other way is blocked too (a doorway it does not fit, a wall it
	-- has walked into side-on): press on at where it is going and let the body slide along
	-- whatever it meets. Walking off on the roomiest line found - which is usually straight back
	-- the way it came - is how a defender ends up pacing the same stretch of fence for ever;
	-- the dodge for a body that really is pinned is in updateGuards.
	return direction, clear, distance_of(aim, from) + 1, true
end

-- Where to drag this defender this frame to get it closer to `aim`. Returns a point rather than a
-- direction: defenders are moved by an AlignPosition, so the thing they are told is a place to go.
local function steer(guard: Guard, aim: Vector3, followFloor: boolean): Vector3
	local from = guard.Root.Position
	local flat = Vector3.new(aim.X - from.X, 0, aim.Z - from.Z)
	local distance = flat.Magnitude
	if distance < 0.05 then
		return aim
	end
	local direction = flat / distance

	-- Walking a line it has already checked costs no casts at all, so a settled defender only
	-- feels for the way ahead when the line has gone stale or no longer points at where it is
	-- going. (The body itself is what stops it if the line has quietly run out.) Staleness is
	-- counted in game seconds by updateGuards rather than read off the clock, so a defender
	-- behaves the same however many frames a second the server manages.
	local line = guard.Move
	local way, clear, ceiling
	if guard.Sidestep > 0 then
		-- A body that wants to be somewhere and cannot get there (see updateGuards) walks
		-- sideways along whatever is stopping it for a moment instead of pushing at it. This is
		-- the way round an engine that reports nothing at all about the thing it is against.
		local left = CFrame.Angles(0, math.rad(90), 0) * direction
		local right = CFrame.Angles(0, math.rad(-90), 0) * direction
		local leftClear, leftBlocked = probe(guard, left, SIDESTEP_REACH)
		local rightClear, rightBlocked = probe(guard, right, SIDESTEP_REACH)
		local side = guard.SlideSide
		if side == 0 then
			-- Both sides are usually open along a wall, so the one to take is the one that ends up
			-- closer to where it is going - along the wall towards the door, not away from it.
			local leftward = distance_of(aim, from + left * SIDESTEP_REACH)
			local rightward = distance_of(aim, from + right * SIDESTEP_REACH)
			side = if leftward <= rightward then 1 else -1
		end
		-- Unless the side it wanted is shut, in which case the other one: the whole point of the
		-- walk sideways is to find the way round, and the way round is the one that opens up.
		if side > 0 and leftBlocked and not rightBlocked then
			side = -1
		elseif side < 0 and rightBlocked and not leftBlocked then
			side = 1
		end
		guard.SlideSide = side
		way = if side > 0 then left else right
		clear, ceiling = if side > 0 then leftClear else rightClear, SIDESTEP_REACH
	elseif line and guard.Sight > 0 and (guard.MoveDetour or line:Dot(direction) > 0.9) then
		way, clear, ceiling = line, guard.MoveClear, distance + 1
	else
		local turned
		way, clear, ceiling, turned = wayAhead(guard, direction, aim, from)
		-- A detour is a place to be, not a new goal: walk to it, then think again.
		guard.Move, guard.MoveClear, guard.Sight, guard.MoveDetour = way, clear, SIGHT_TIME, turned
		ceiling = if turned then math.min(ceiling, clear) else ceiling
	end

	local height = aim.Y
	if followFloor then
		local ahead = from + way * (halfExtent(guard, way) + 1.5)
		local floor = floorBelow(guard, from) or floorBelow(guard, ahead)
		if floor then
			height = math.min(math.max(floor + guard.Look.RootHeight, from.Y - STEP_UP), from.Y + STEP_UP)
		end
	end

	-- Never past what the last look said was clear, and never further than the goal needs.
	guard.LastWay = way
	local reach = math.min(clear, ceiling)
	return Vector3.new(from.X + way.X * reach, height, from.Z + way.Z * reach)
end

-- A defender going home cannot pick a lock: anything shut within reach of it is opened for it.
local function letThemIn(house: House, position: Vector3)
	if DayNight.isDaytime() then
		return -- the houses are locked up: nobody is let in during the day
	end
	for _, door in house.Doors do
		if not door.IsOpen and (door.Spot - position).Magnitude <= DOOR_RADIUS then
			setDoorOpen(door, true)
		end
	end
end

local function defendersComingHome(house: House): boolean
	for _, guard in house.Guards do
		if guard.State == "Return" then
			return true
		end
	end
	return false
end

-- Everything a defender does when it is not chasing you: the walk cycle follows whatever its body
-- is really doing (so being shoved into a wall stops the legs), and one on its way home is walked
-- there through the front door rather than teleported.
local function updateGuards(house: House, dt: number, now: number)
	for _, guard in house.Guards do
		local from = guard.Root.Position
		local moved = Vector3.new(from.X - guard.LastPosition.X, 0, from.Z - guard.LastPosition.Z).Magnitude
		guard.LastPosition = from
		WalkCycle.update(guard.Walk, dt, if dt > 0 then moved / dt else 0)
		guard.Sight = math.max(0, guard.Sight - dt)
		guard.Sidestep = math.max(0, guard.Sidestep - dt)

		-- Nobody walks on the spot. A defender that is being dragged somewhere and has not
		-- moved is up against something the casts will not tell us about, so it steps sideways
		-- along it for a moment - the way an animal that bumps into a wall works along it.
		-- Wedged on a door frame. The casts cannot always tell a body pressed into an opening
		-- from one pressed into the wall around it, and a defender that spends a second and a
		-- half standing in the same spot at one of its own house's doorways is on the frame
		-- rather than at anything real: it takes the step through and carries on.
		local seeking = (guard.AlignPosition.Position - from).Magnitude > AIM_CLOSE
		if seeking and (guard.State == "Chase" or guard.State == "Return") and moved < STUCK_SPEED * dt then
			guard.Pinned += dt
			if guard.Pinned >= PINNED_TIME then
				guard.Pinned = 0
				local near, nearDistance = nil, WAYPOINT_REACHED + 0.5
				for _, node in house.Route do
					local distance = distance_of(node, from)
					if distance < nearDistance then
						near, nearDistance = node, distance
					end
				end
				if near then
					-- Along the line it was walking, not at the marker: a body standing on the
					-- marker has no way to go but the way it was already going. The step is only
					-- taken if the far side of the frame is open, so this is walking through the
					-- doorway, never through the wall around it.
					local heading = guard.LastWay
					if heading == nil or heading.Magnitude < 0.5 then
						local offset = Vector3.new(near.X - from.X, 0, near.Z - from.Z)
						heading = if offset.Magnitude > 1e-3 then offset.Unit else nil
					end
					if heading then
						local ahead = from + heading * (halfExtent(guard, heading) + 0.5)
						if not select(2, probe(guard, heading, SQUEEZE_STEP, ahead)) then
							guard.Root.CFrame = guard.Root.CFrame + heading * SQUEEZE_STEP
							guard.LastPosition = guard.Root.Position
							guard.Move, guard.Sight, guard.Stuck, guard.LastWay = nil, 0, 0, nil
						end
					end
				end
			end
			guard.Stuck += dt
			if guard.Stuck >= SIDESTEP_TIME and guard.Sidestep <= 0 then
				guard.Stuck = 0
				if guard.Sidestepped then
					-- The last dodge went nowhere either: walk the other side of the obstacle.
					guard.SlideSide = -guard.SlideSide
				else
					-- Let the steering pick the side that gets it closer to where it is going.
					guard.SlideSide = 0
				end
				guard.Move, guard.Sight = nil, 0
				guard.MoveDetour = false
				guard.Sidestepped = true
				guard.Sidestep = SIDESTEP_TIME
			end
		else
			guard.Stuck = 0
			guard.Sidestepped = false
			guard.Pinned = 0
		end

		if guard.State ~= "Return" then
			continue
		end
		local home = guard.Home.Position
		-- It may have to get back through a wall to reach the bed: through the doorway first.
		local target = home
		if not guard.Flying then
			local hop = routeTo(house, guard, home)
			target = Vector3.new(hop.X, from.Y, hop.Z)
			if insideHouse(house, from) ~= insideHouse(house, home) then
				letThemIn(house, from)
			end
		end
		local homeward = Vector3.new(from.X - home.X, 0, from.Z - home.Z).Magnitude
		if homeward <= RETURN_RADIUS and math.abs(from.Y - home.Y) <= 2 then
			-- Home again. A road catcher only puts recovered pieces back once it has made the
			-- full retreat, so its loot sack tells the story all the way home.
			if #guard.RecoveredLoot > 0 then
				restoreRecoveredLoot(guard.RecoveredLoot)
				table.clear(guard.RecoveredLoot)
				updateRecoveredSack(guard)
			end
			guard.State = "Idle"
			guard.Move = nil
			guard.MoveDetour = false
			guard.AlignPosition.Position = guard.Home.Position
			guard.AlignOrientation.CFrame = guard.Home.Rotation
			guard.Look.Status.Text = if guard.Flying then "" else SLEEPING
			WalkCycle.rest(guard.Walk)
		else
			guard.AlignPosition.MaxVelocity = Config.Alarm.GuardReturnSpeed
			-- Not clamped to the chase lane: the way home leaves the street through the gate,
			-- which is past the lane, and routeTo is what keeps it off other people's property.
			local move = steer(guard, target, not guard.Flying)
			guard.AlignPosition.Position = move
			local heading = Vector3.new(move.X - from.X, 0, move.Z - from.Z)
			if heading.Magnitude > 0.05 then
				guard.AlignOrientation.CFrame = CFrame.lookAt(Vector3.zero, heading.Unit)
			end
		end
	end
end

-- "the Ginger Cat" / "the Pugs"
local function guardPhrase(house: House): string
	local name = house.GuardInfo.DisplayName
	return if #house.Guards == 1 then "the " .. name else "the " .. name .. "s"
end

-- Is this position on any house's property? (Used to stop cars spawning inside.)
function Houses.isOnProperty(position: Vector3): boolean
	for _, house in houses do
		if isInZone(house, position) then
			return true
		end
	end
	return false
end

--------------------------------------------------------------------------------
-- Alarm
--------------------------------------------------------------------------------
local function triggerAlarm(house: House, culprit: Player?)
	local now = os.clock()
	house.LastOccupiedAt = now
	if house.AlarmActive or DayNight.isDaytime() then
		return
	end
	house.AlarmActive = true
	house.Model:SetAttribute("AlarmActive", true)
	for _, guard in house.Guards do
		guard.Way = nil
		guard.State = "Windup"
		guard.ActivateAt = now + house.Settings.AlarmWindup
		guard.Move, guard.Sight, guard.Stuck, guard.Sidestep = nil, 0, 0, 0
		guard.MoveDetour = false
		Guards.setAlert(guard.Look, house.GuardId, true)
		guard.Look.Status.Text = ALERT
		-- Drones rise up and animals jump out of bed during the wind-up, so players see them coming.
		guard.AlignPosition.Position = guard.Home.Position + Vector3.new(0, if guard.Flying then 1.5 else 0.6, 0)
	end
	-- They come out after you, so the way out is open.
	for _, door in house.Doors do
		if not door.IsOpen then
			setDoorOpen(door, true)
		end
	end
	if culprit then
		local phrase = guardPhrase(house)
		Notify.send(
			culprit,
			string.format(
				"🚨 ALARM! %s%s woke up! It moves at your speed in here — through the gate it runs at %s studs/s!",
				string.upper(string.sub(phrase, 1, 1)),
				string.sub(phrase, 2),
				Format.commas(house.GuardSpeed)
			),
			"warning"
		)
	end
end

local function clearIntruder(player: Player, house: House)
	house.Intruders[player] = nil
	if player.Parent and player:GetAttribute("AlarmHouse") == house.Name then
		player:SetAttribute("AlarmHouse", "")
		player:SetAttribute("AlarmGuard", "")
		player:SetAttribute("AlarmSpeed", 0)
	end
end

local function endAlarm(house: House, bedtime: boolean?)
	house.AlarmActive = false
	house.Model:SetAttribute("AlarmActive", false)
	for player in house.Intruders do
		clearIntruder(player, house)
	end
	for _, guard in house.Guards do
		guard.Move, guard.Sight, guard.Stuck, guard.Sidestep = nil, 0, 0, 0
		guard.MoveDetour = false
		guard.AlignPosition.MaxVelocity = Config.Alarm.GuardReturnSpeed
		Guards.setAlert(guard.Look, house.GuardId, false)
		if bedtime then
			-- Daytime: the owners are home and the doors lock behind them, so a defender that is
			-- still out on the street is called straight in to bed rather than left out all day.
			guard.State = "Idle"
			guard.AlignPosition.Position = guard.Home.Position
			guard.AlignOrientation.CFrame = guard.Home.Rotation
			WalkCycle.rest(guard.Walk)
			guard.Look.Status.Text = if guard.Flying then "" else SLEEPING
		else
			-- Home on foot (or on wheels, or hovering): a defender does not cheat back through
			-- the walls it just had to walk round. updateGuards walks it in.
			guard.Way = nil
			guard.State = "Return"
			guard.Look.Status.Text = ""
		end
	end
end

local function endRagdoll(character: Model)
	local ragdoll = ragdolls[character]
	if not ragdoll then
		return
	end
	ragdolls[character] = nil
	for _, state in ragdoll.Motors do
		if state.Motor.Parent then
			state.Motor.Enabled = state.Enabled
		end
	end
	for _, state in ragdoll.Parts do
		if state.Part.Parent then
			state.Part.CanCollide = state.CanCollide
		end
	end
	for _, constraint in ragdoll.Constraints do
		if constraint.Parent then
			constraint:Destroy()
		end
	end
	local humanoid = ragdoll.Humanoid
	if humanoid.Parent then
		humanoid.RequiresNeck = ragdoll.RequiresNeck
		humanoid.PlatformStand = ragdoll.PlatformStand
		humanoid.AutoRotate = ragdoll.AutoRotate
		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
	end
	character:SetAttribute("Ragdolled", false)
end

-- Turn the character's non-root Motor6Ds into physical ball sockets briefly. Keeping the root
-- connected preserves the camera/ownership anchor while the visible body goes limp and flies.
local function beginRagdoll(character: Model, humanoid: Humanoid)
	if ragdolls[character] then
		return
	end
	local ragdoll: Ragdoll = {
		Humanoid = humanoid,
		Motors = {},
		Parts = {},
		Constraints = {},
		AutoRotate = humanoid.AutoRotate,
		PlatformStand = humanoid.PlatformStand,
		RequiresNeck = humanoid.RequiresNeck,
	}
	ragdolls[character] = ragdoll
	character:SetAttribute("Ragdolled", true)
	humanoid.RequiresNeck = false
	humanoid.AutoRotate = false
	humanoid.PlatformStand = true
	pcall(function()
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	end)

	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") and descendant.Name ~= "HumanoidRootPart" then
			table.insert(ragdoll.Parts, { Part = descendant, CanCollide = descendant.CanCollide })
			descendant.CanCollide = true
		elseif descendant:IsA("Motor6D") then
			local part0, part1 = descendant.Part0, descendant.Part1
			if part0 and part1 and part0.Name ~= "HumanoidRootPart" and part1.Name ~= "HumanoidRootPart" then
				table.insert(ragdoll.Motors, { Motor = descendant, Enabled = descendant.Enabled })
				local attachment0 = Instance.new("Attachment")
				attachment0.Name = "BustRagdollAttachment"
				attachment0.CFrame = descendant.C0
				attachment0.Parent = part0
				local attachment1 = Instance.new("Attachment")
				attachment1.Name = "BustRagdollAttachment"
				attachment1.CFrame = descendant.C1
				attachment1.Parent = part1
				local socket = Instance.new("BallSocketConstraint")
				socket.Name = "BustRagdollJoint"
				socket.Attachment0 = attachment0
				socket.Attachment1 = attachment1
				socket.LimitsEnabled = true
				socket.TwistLimitsEnabled = true
				socket.Parent = part0
				descendant.Enabled = false
				table.insert(ragdoll.Constraints, attachment0)
				table.insert(ragdoll.Constraints, attachment1)
				table.insert(ragdoll.Constraints, socket)
			end
		end
	end
	task.delay(Config.Alarm.BustRagdollTime, function()
		endRagdoll(character)
	end)
end

local function unseat(humanoid: Humanoid)
	if humanoid.SeatPart then
		local seatWeld = humanoid.SeatPart:FindFirstChild("SeatWeld")
		if seatWeld then
			seatWeld:Destroy()
		end
		humanoid.Sit = false
	end
end

updateRecoveredSack = function(guard: Guard)
	if guard.RecoveredSack then
		guard.RecoveredSack:Destroy()
		guard.RecoveredSack = nil
	end
	local count = #guard.RecoveredLoot
	if count == 0 then
		return
	end
	local sack = Instance.new("Part")
	sack.Name = "RecoveredLoot"
	sack.Shape = Enum.PartType.Ball
	sack.Size = Vector3.new(math.min(1 + count * 0.18, 2.8), math.min(1 + count * 0.18, 2.8), math.min(1 + count * 0.18, 2.8))
	sack.Color = Color3.fromRGB(150, 110, 62)
	sack.Material = Enum.Material.Fabric
	sack.CanCollide = false
	sack.CanQuery = false
	sack.CanTouch = false
	sack.Massless = true
	local weld = Instance.new("Weld")
	weld.Name = "RecoveredLootWeld"
	weld.Part0 = guard.Root
	weld.Part1 = sack
	weld.C0 = CFrame.new(0, guard.Root.Size.Y / 2 + sack.Size.Y / 2, guard.Root.Size.Z / 2)
	weld.Parent = sack
	local label = Instance.new("BillboardGui")
	label.Name = "RecoveredLabel"
	label.Size = UDim2.fromOffset(80, 28)
	label.StudsOffsetWorldSpace = Vector3.new(0, sack.Size.Y / 2 + 0.45, 0)
	label.MaxDistance = 65
	label.LightInfluence = 0
	label.Parent = sack
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.BuilderSansBold
	text.Text = string.format("%d LOOT", count)
	text.TextColor3 = Color3.fromRGB(255, 220, 90)
	text.TextStrokeTransparency = 0.25
	text.TextScaled = true
	text.Parent = label
	sack.Parent = guard.Look.Model
	guard.RecoveredSack = sack
end

local function launch(root: BasePart, direction: Vector3, speed: number)
	local flat = Vector3.new(direction.X, 0, direction.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(0, 0, 1)
	end
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	root.AssemblyLinearVelocity = flat.Unit * speed + Vector3.new(0, Config.Alarm.BustLaunchUpward, 0)
	root.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-12, 12), rng:NextNumber(-12, 12), rng:NextNumber(-12, 12))
end

local function throwThroughDoor(house: House, character: Model, humanoid: Humanoid, root: BasePart)
	local road = lotPoint(house, 0, house.ZoneHalfSize.Z + Config.Alarm.BustRoadMiddleOffset)
	local doorway = house.Route.Door or lotPoint(house, 0, house.ZoneHalfSize.Z - house.FrontInset + 1)
	local direction = Vector3.new(road.X - doorway.X, 0, road.Z - doorway.Z)
	if direction.Magnitude < 1e-3 then
		direction = house.ZoneCFrame.LookVector
	end
	-- Place the still-rigged character just inside the threshold, then make it limp and launch it
	-- along the front-path line. This guarantees the ejection uses the real front door rather than
	-- letting furniture or a back wall eat the impulse.
	local start = doorway - direction.Unit * 1.5
	character:PivotTo(CFrame.lookAt(start, start + direction))
	for _, door in house.Doors do
		setDoorOpen(door, true)
	end
	unseat(humanoid)
	beginRagdoll(character, humanoid)
	launch(root, direction, Config.Alarm.BustIndoorLaunchSpeed)
	task.delay(Config.Alarm.BustDoorSlamDelay, function()
		if not DayNight.isDaytime() then
			for _, door in house.Doors do
				setDoorOpen(door, false, true)
			end
		end
	end)
end

local function bust(player: Player, house: House, guard: Guard)
	local now = os.clock()
	if isImmune(player, now) then
		return
	end
	bustedUntil[player] = now + Config.Alarm.BustImmunity
	clearIntruder(player, house)

	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	local caughtInside = root ~= nil and root:IsA("BasePart") and insideHouse(house, root.Position)

	local lost = Inventory.takeCarriedWithOrigins(player)
	local lostValue = 0
	local recovered: { ReturnedLoot } = {}
	for _, loot in lost do
		lostValue += Items.getValue(loot.ItemId)
		if loot.Origin then
			table.insert(recovered, {
				ItemId = loot.ItemId,
				HouseId = loot.Origin.HouseId,
				SpotId = loot.Origin.SpotId,
			})
		end
	end
	local catcher = (if #house.Guards == 1 then "The " else "A ") .. house.GuardInfo.DisplayName
	BustedEvent:FireClient(player, #lost, lostValue, house.Name, catcher, if caughtInside then "door" else "road")

	if caughtInside then
		restoreRecoveredLoot(recovered)
		if character and humanoid and root and root:IsA("BasePart") then
			throwThroughDoor(house, character, humanoid, root)
		end
	else
		for _, loot in recovered do
			table.insert(guard.RecoveredLoot, loot)
		end
		updateRecoveredSack(guard)
		if character and humanoid and root and root:IsA("BasePart") then
			unseat(humanoid)
			beginRagdoll(character, humanoid)
			launch(root, root.Position - guard.Root.Position, Config.Alarm.BustRoadLaunchSpeed)
		end
	end

	-- The successful catcher has the recovered bag on its back, then follows the normal physical
	-- home route. The original spots are refilled only when it gets there.
	endAlarm(house)
end

-- Where a guard heads to catch this position.
local function aimAt(guard: Guard, position: Vector3, now: number): Vector3
	if guard.Flying then
		return position + Vector3.new(0, Config.Alarm.DroneAimHeight, 0)
	end
	-- Animals run along the floor, with a little trotting bounce (cars and people keep their wheels on it).
	local feet = position.Y - FEET_BELOW_ROOT
	local bounce = if guard.Trot > 0 then math.abs(math.sin(now * 14 + guard.Bob)) * guard.Trot else 0
	return Vector3.new(position.X, feet + guard.Look.RootHeight + bounce, position.Z)
end

local function updateAlarm(house: House, thieves: { Thief }, now: number)
	local intruders: { Thief } = {}
	for _, thief in thieves do
		if inChaseArea(house, thief.Root.Position) and not isImmune(thief.Player, now) then
			table.insert(intruders, thief)
		end
	end

	-- Keep the "you're being chased" banner in sync.
	local present: { [Player]: boolean } = {}
	for _, thief in intruders do
		present[thief.Player] = true
		if not house.Intruders[thief.Player] then
			house.Intruders[thief.Player] = true
			thief.Player:SetAttribute("AlarmGuard", guardPhrase(house))
			thief.Player:SetAttribute("AlarmHouse", house.Name)
			thief.Player:SetAttribute("AlarmSpeed", house.GuardSpeed)
		end
	end
	for player in house.Intruders do
		if not present[player] then
			clearIntruder(player, house)
			if player.Parent and Inventory.getCarriedCount(player) > 0 and not isImmune(player, now) then
				Notify.send(player, "😎 You escaped with the loot! Now stash it in your warehouse.", "success")
			end
		end
	end

	if #intruders > 0 then
		house.LastOccupiedAt = now
	elseif now - house.LastOccupiedAt >= Config.Alarm.CalmDownTime then
		endAlarm(house)
		return
	end

	for _, guard in house.Guards do
		if guard.State == "Windup" and now >= guard.ActivateAt then
			guard.State = "Chase"
		end
		if guard.State == "Chase" then
			local target: Thief? = nil
			local bestDistance = math.huge
			local from = guard.Root.Position
			for _, thief in intruders do
				local offset = thief.Root.Position - from
				local distance = Vector3.new(offset.X, 0, offset.Z).Magnitude
				if distance < bestDistance then
					target, bestDistance = thief, distance
				end
			end
			if target then
				-- The way to it may be through the house: out of the room it is in, or in through
				-- the front door (see routeTo).
				local aimed = routeTo(house, guard, target.Root.Position)
				local aim = aimAt(guard, aimed, now)
				-- Its feet follow the aim (the thief's own height), not the floor: that is what
				-- carries the bounce, and inside a house the two are the same thing.
				local move = clampToChase(house, steer(guard, aim, false))
				guard.AlignPosition.Position = move
				-- The standard speed in the house, its real (often terrifying) speed outside.
				guard.AlignPosition.MaxVelocity = chaseSpeed(house, from)
				-- Face where it is really going: a defender that has to walk out of a doorway
				-- backwards should be walking out of it, not moonwalking round the corner.
				local heading = Vector3.new(move.X - from.X, 0, move.Z - from.Z)
				if heading.Magnitude > 0.05 then
					guard.AlignOrientation.CFrame = CFrame.lookAt(Vector3.zero, heading.Unit)
				end
				local height = math.abs(aimed.Y - from.Y)
				if bestDistance <= catchRadius(guard) and height <= CATCH_HEIGHT then
					bust(target.Player, house, guard)
				end
			end
		end
	end
end

local function getThieves(): { Thief }
	local thieves: { Thief } = {}
	for _, player in Players:GetPlayers() do
		local character = player.Character
		if character then
			local root = character:FindFirstChild("HumanoidRootPart")
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
				table.insert(thieves, { Player = player, Root = root, Humanoid = humanoid })
			end
		end
	end
	return thieves
end

local function onHeartbeat(dt: number)
	local now = os.clock()
	local thieves = getThieves()

	-- Inside a property everyone is held at the standard Roblox speed (see PlayerData).
	for _, thief in thieves do
		PlayerData.setInsideHouse(thief.Player, Houses.isOnProperty(thief.Root.Position))
	end

	for _, house in houses do
		if house.AlarmActive then
			updateAlarm(house, thieves, now)
		end
		updateGuards(house, dt, now)
	end
end

--------------------------------------------------------------------------------
-- Loot
--------------------------------------------------------------------------------
local function makeItemLabel(def: Items.ItemDef, root: BasePart)
	local rarity = Items.Rarities[def.Rarity]
	local gui = Instance.new("BillboardGui")
	gui.Name = "ItemLabel"
	gui.Size = UDim2.fromOffset(180, 50)
	gui.StudsOffsetWorldSpace = Vector3.new(0, root.Size.Y / 2 + 1.2, 0)
	gui.MaxDistance = 28
	gui.LightInfluence = 0
	gui.Parent = root

	local name = Instance.new("TextLabel")
	name.Name = "ItemName"
	name.BackgroundTransparency = 1
	name.Size = UDim2.fromScale(1, 0.55)
	name.Font = Enum.Font.FredokaOne
	name.Text = def.DisplayName
	name.TextScaled = true
	name.TextColor3 = rarity.Color
	name.TextStrokeTransparency = 0.25
	name.Parent = gui

	local value = Instance.new("TextLabel")
	value.Name = "ItemValue"
	value.BackgroundTransparency = 1
	value.Position = UDim2.fromScale(0, 0.55)
	value.Size = UDim2.fromScale(1, 0.45)
	value.Font = Enum.Font.BuilderSansBold
	value.Text = string.format("%s • %s", Format.money(def.Value), def.Rarity)
	value.TextScaled = true
	value.TextColor3 = Color3.fromRGB(130, 255, 150)
	value.TextStrokeTransparency = 0.3
	value.Parent = gui
end

local onSteal: (house: House, spot: Spot, model: Model, player: Player) -> ()

local function setStealable(spot: Spot, stealable: boolean)
	local model = spot.Item
	local root = if model then model.PrimaryPart else nil
	local prompt = if root then root:FindFirstChild("StealPrompt") else nil
	if prompt and prompt:IsA("ProximityPrompt") then
		prompt.Enabled = stealable
	end
end

local function spawnItem(house: House, spot: Spot, forcedItemId: string?)
	local itemId = forcedItemId or Items.roll(house.LootHouse, rng)
	local def = Items.get(itemId)
	local model = ItemModels.build(itemId)
	if not def or not model then
		return
	end
	model:PivotTo(spot.Part.CFrame)
	local root = model.PrimaryPart
	if root then
		makeItemLabel(def, root)
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "StealPrompt"
		prompt.ActionText = "Steal"
		prompt.ObjectText = string.format("%s (%s)", def.DisplayName, Format.money(def.Value))
		prompt.HoldDuration = Config.Stealing.HoldDuration
		prompt.MaxActivationDistance = Config.Stealing.PromptDistance
		prompt.RequiresLineOfSight = false
		prompt.Enabled = not DayNight.isDaytime()
		prompt.Parent = root
		prompt.Triggered:Connect(function(player: Player)
			onSteal(house, spot, model, player)
		end)
	end
	model.Parent = house.Loot
	spot.Item = model
	spot.ItemId = itemId
end

-- Fresh loot on every spot (the old leftovers are taken away).
local function restock(house: House)
	for _, spot in house.Spots do
		local old = spot.Item
		if old then
			old:Destroy()
		end
		spot.Item = nil
		spot.ItemId = nil
		spawnItem(house, spot)
	end
end

-- Recreate recovered loot with its original id on its original marker, never by rolling a new
-- item. If daytime has already restocked that marker, it is already safely occupied and must not
-- be duplicated.
restoreRecoveredLoot = function(loot: { ReturnedLoot }): number
	local restored = 0
	for _, entry in loot do
		local house = housesById[entry.HouseId]
		local spot = if house then house.SpotById[entry.SpotId] else nil
		if house and spot and spot.Item == nil then
			spawnItem(house, spot, entry.ItemId)
			if spot.Item then
				restored += 1
			end
		end
	end
	return restored
end

onSteal = function(house: House, spot: Spot, model: Model, player: Player)
	local itemId = spot.ItemId
	if spot.Item ~= model or not itemId or not model.Parent then
		return
	end
	if DayNight.isDaytime() or isImmune(player, os.clock()) then
		return
	end
	local ok, reason = Inventory.addCarried(player, itemId, {
		HouseId = house.Id,
		SpotId = spot.Part.Name,
	})
	if not ok then
		Notify.send(player, reason or "You can't carry that right now.", "error")
		return
	end
	spot.Item = nil
	spot.ItemId = nil
	model:Destroy()
	PlayerData.addStolen(player, 1)

	local def = Items.get(itemId)
	if def then
		Notify.send(
			player,
			string.format(
				"🦝 Stole %s (%s)! Bag: %d/%d",
				def.DisplayName,
				Format.money(def.Value),
				Inventory.getCarriedCount(player),
				PlayerData.getUpgradeValue(player, "Bag")
			),
			"steal"
		)
		if PlayerData.discover(player, itemId) then
			Notify.send(
				player,
				string.format(
					"📖 New item discovered: %s! (%d/%d in your Loot Index)",
					def.DisplayName,
					PlayerData.getDiscoveredCount(player),
					#Items.List
				),
				"level"
			)
		end
	end
	triggerAlarm(house, player)
end

--------------------------------------------------------------------------------
-- Guards
--------------------------------------------------------------------------------
local function buildGuard(house: House, dock: BasePart): Guard
	local flying = house.GuardInfo.Kind == "Drone"
	local base = if flying
		then CFrame.new(dock.Position + Vector3.new(0, Config.Alarm.DroneDockHeight, 0)) * dock.CFrame.Rotation
		else CFrame.new(dock.Position + Vector3.new(0, dock.Size.Y / 2, 0)) * dock.CFrame.Rotation
	local look = Guards.build(house.GuardId, base)
	local model = look.Model
	model:SetAttribute("Kind", house.GuardInfo.Kind)
	model:SetAttribute("Breed", house.GuardInfo.DisplayName)
	local root = look.Root
	look.Status.Text = if flying then "" else SLEEPING

	local filter = RaycastParams.new()
	filter.FilterType = Enum.RaycastFilterType.Exclude
	filter.FilterDescendantsInstances = { look.Model }
	-- The way-ahead cast keeps the same list and pushes what it is discounting onto the end of it,
	-- so nothing is allocated per look (which matters: defenders look several times a frame).
	local hidden: { any } = { look.Model }
	local probeParams = RaycastParams.new()
	probeParams.FilterType = Enum.RaycastFilterType.Exclude
	probeParams.FilterDescendantsInstances = hidden

	local attachment = Instance.new("Attachment")
	attachment.Name = "GuardAttachment"
	attachment.Parent = root

	local alignPosition = Instance.new("AlignPosition")
	alignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
	alignPosition.Attachment0 = attachment
	alignPosition.Position = root.Position
	alignPosition.MaxForce = 1000000
	alignPosition.MaxVelocity = Config.Alarm.GuardReturnSpeed
	alignPosition.Responsiveness = 80
	alignPosition.Parent = root

	local alignOrientation = Instance.new("AlignOrientation")
	alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	alignOrientation.Attachment0 = attachment
	alignOrientation.CFrame = root.CFrame.Rotation
	alignOrientation.MaxTorque = 1000000
	alignOrientation.Responsiveness = 40
	alignOrientation.Parent = root

	model.Parent = house.Model
	pcall(function()
		root:SetNetworkOwner(nil)
	end)

	return {
		Look = look,
		Root = root,
		AlignPosition = alignPosition,
		AlignOrientation = alignOrientation,
		Home = root.CFrame,
		Filter = filter,
		ProbeParams = probeParams,
		Hidden = hidden,
		Flying = flying,
		State = "Idle",
		ActivateAt = 0,
		Bob = rng:NextNumber() * math.pi * 2,
		Trot = TROT[house.GuardInfo.Kind] or 0.4,
		Walk = WalkCycle.new(look.Limbs),
		LastPosition = root.Position,
		Move = nil,
		MoveClear = 0,
		MoveDetour = false,
		Sight = 0,
		SlideSide = 0,
		Blocked = 0,
		ClearLooks = 0,
		Stuck = 0,
		Sidestep = 0,
		Sidestepped = false,
		Pinned = 0,
		LastWay = nil,
		Way = nil,
		RecoveredLoot = {},
		RecoveredSack = nil,
	}
end

--------------------------------------------------------------------------------
-- Doors
--------------------------------------------------------------------------------
setDoorOpen = function(door: Door, open: boolean, slam: boolean?)
	door.IsOpen = open
	if open then
		door.Prompt.Enabled = false
		door.CloseAt = os.clock() + Config.Doors.StayOpenTime
		TweenService:Create(door.Angle, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Value = door.OpenAngle,
		}):Play()
	else
		local duration = if slam then 0.18 else 0.9
		TweenService:Create(door.Angle, TweenInfo.new(duration, Enum.EasingStyle.Quad, if slam then Enum.EasingDirection.In else Enum.EasingDirection.InOut), {
			Value = 0,
		}):Play()
		if slam then
			door.Slam:Play()
		end
		task.delay(duration, function()
			if not door.IsOpen and not DayNight.isDaytime() then
				door.Prompt.Enabled = true
			end
		end)
	end
end

local function setupDoor(house: House, doorModel: Model): Door?
	local hinge = doorModel:FindFirstChild("Hinge")
	if not (hinge and hinge:IsA("BasePart")) then
		warn("[Houses] Door " .. doorModel:GetFullName() .. " has no Hinge part")
		return nil
	end
	local hingeCFrame = hinge.CFrame
	local pieces: { { Part: BasePart, Offset: CFrame } } = {}
	local panel: BasePart? = nil
	for _, descendant in doorModel:GetDescendants() do
		if descendant:IsA("BasePart") and descendant ~= hinge then
			table.insert(pieces, { Part = descendant, Offset = hingeCFrame:ToObjectSpace(descendant.CFrame) })
			if panel == nil or descendant.Size.Magnitude > panel.Size.Magnitude then
				panel = descendant
			end
		end
	end
	if not panel then
		return nil
	end

	local angle = Instance.new("NumberValue")
	angle.Name = "OpenAngle"
	angle.Value = 0
	angle.Parent = doorModel
	angle:GetPropertyChangedSignal("Value"):Connect(function()
		local base = hingeCFrame * CFrame.Angles(0, math.rad(angle.Value), 0)
		for _, doorPiece in pieces do
			doorPiece.Part.CFrame = base * doorPiece.Offset
		end
	end)

	local openAngle = doorModel:GetAttribute("OpenAngle")
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "LockpickPrompt"
	prompt.ActionText = "Pick Lock"
	prompt.ObjectText = house.Name
	prompt.HoldDuration = house.Settings.LockpickTime
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.Enabled = not DayNight.isDaytime()
	prompt.Parent = panel

	local slam = Instance.new("Sound")
	slam.Name = "SlamSound"
	slam.SoundId = Config.Sounds.DoorSlam
	slam.Volume = 1.35
	slam.RollOffMode = Enum.RollOffMode.InverseTapered
	slam.RollOffMinDistance = 4
	slam.RollOffMaxDistance = 70
	slam.Parent = panel

	local door: Door = {
		Model = doorModel,
		Spot = hingeCFrame.Position,
		Prompt = prompt,
		Angle = angle,
		Slam = slam,
		OpenAngle = if type(openAngle) == "number" then openAngle else -95,
		IsOpen = false,
		CloseAt = 0,
	}
	prompt.Triggered:Connect(function(player: Player)
		if door.IsOpen then
			return
		end
		if DayNight.isDaytime() then
			Notify.send(player, "☀️ The owners are home! Come back when it's dark.", "error")
			return
		end
		setDoorOpen(door, true)
		Notify.send(player, "🔓 Lock picked! Grab the loot... the alarm trips when you steal.", "info")
	end)
	return door
end

local function anyoneOnProperty(house: House): boolean
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
		if root and root:IsA("BasePart") and isInZone(house, root.Position) then
			return true
		end
	end
	return false
end

--------------------------------------------------------------------------------
-- Lasers
--------------------------------------------------------------------------------
local function setupLaser(house: House, laser: BasePart)
	laser.CanCollide = false
	laser.CanQuery = false
	laser.Touched:Connect(function(hit: BasePart)
		if laser.Transparency >= 1 or DayNight.isDaytime() then
			return
		end
		local player = playerFromHit(hit)
		if not player then
			return
		end
		local now = os.clock()
		if (laserCooldown[player] or 0) > now or isImmune(player, now) then
			return
		end
		laserCooldown[player] = now + 2
		if not house.AlarmActive then
			local phrase = guardPhrase(house)
			Notify.send(
				player,
				string.format(
					"🔴 You tripped a laser! %s%s %s awake!",
					string.upper(string.sub(phrase, 1, 1)),
					string.sub(phrase, 2),
					if #house.Guards == 1 then "is" else "are"
				),
				"warning"
			)
			triggerAlarm(house, nil)
		end
	end)
	table.insert(house.Lasers, laser)
end

local function updateLasers()
	local cycle = Config.Lasers.OnTime + Config.Lasers.OffTime
	local now = os.clock()
	local daytime = DayNight.isDaytime()
	for _, house in houses do
		for _, laser in house.Lasers do
			local phase = laser:GetAttribute("Phase")
			local offset = if type(phase) == "number" then phase else 0
			local on = not daytime and (now + offset) % cycle < Config.Lasers.OnTime
			local transparency = if on then 0.2 else 1
			if laser.Transparency ~= transparency then
				laser.Transparency = transparency
				laser.CanTouch = on
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Daytime: lock up, show everyone out, restock
--------------------------------------------------------------------------------
-- A spot on the pavement just outside the property, facing the street.
local function exitCFrame(house: House): CFrame
	local half = house.ZoneHalfSize
	local front = house.ZoneCFrame * CFrame.new(0, -half.Y + FEET_BELOW_ROOT, half.Z + 6)
	return front * CFrame.Angles(0, math.pi, 0)
end

local function showEveryoneOut()
	for _, thief in getThieves() do
		local seated = thief.Humanoid.SeatPart ~= nil
		for _, house in houses do
			if not seated and isInZone(house, thief.Root.Position) then
				local character = thief.Player.Character
				if character then
					character:PivotTo(exitCFrame(house))
				end
				Notify.send(thief.Player, "☀️ The owners came home! You slipped out just in time (and kept your loot).", "warning")
				break
			end
		end
	end
end

local function onDaytime()
	showEveryoneOut()
	for _, house in houses do
		if house.AlarmActive then
			endAlarm(house, true)
		end
		for _, door in house.Doors do
			door.Prompt.Enabled = false
			if door.IsOpen then
				setDoorOpen(door, false)
			end
		end
		restock(house)
		house.Model:SetAttribute("Open", false)
	end
end

local function onNightfall()
	for _, house in houses do
		for _, door in house.Doors do
			if not door.IsOpen then
				door.Prompt.Enabled = true
			end
		end
		for _, spot in house.Spots do
			setStealable(spot, true)
		end
		house.Model:SetAttribute("Open", true)
	end
end

--------------------------------------------------------------------------------
-- Setup & loops
--------------------------------------------------------------------------------
local function setupHouse(model: Model)
	local zone = model:FindFirstChild("Zone")
	if not (zone and zone:IsA("BasePart")) then
		warn("[Houses] " .. model:GetFullName() .. " has no Zone part, skipping")
		return
	end
	local info = Config.getHouse(model.Name)
	local tierAttribute = model:GetAttribute("Tier")
	local tier = math.clamp(
		if info then info.Tier elseif type(tierAttribute) == "number" then tierAttribute else 1,
		1,
		#Config.HouseTiers
	)
	local displayName = model:GetAttribute("DisplayName")
	local guardId = if info then info.Guard else "TuxedoCat"
	local guardInfo = Config.Guards[guardId] or Config.Guards.TuxedoCat

	-- Houses added by hand in Studio borrow the loot of a listed house of the same tier.
	local lootHouse = model.Name
	if #Items.forHouse(lootHouse) == 0 then
		for _, other in Config.Houses do
			if other.Tier == tier then
				lootHouse = other.Id
				break
			end
		end
	end

	local loot = Instance.new("Folder")
	loot.Name = "Loot"
	loot.Parent = model

	-- The map marks where the front wall sits inside the property; fall back to the Config default.
	local inset = zone:GetAttribute("FrontInset")
	local half = zone.Size / 2
	-- How far east a chase is allowed to go: the east edge of this house's own lot.
	local maxX = -math.huge
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			maxX = math.max(maxX, zone.CFrame:PointToWorldSpace(Vector3.new(sx * half.X, 0, sz * half.Z)).X)
		end
	end

	local house: House = {
		Model = model,
		Id = model.Name,
		Name = if type(displayName) == "string" then displayName elseif info then info.DisplayName else model.Name,
		LootHouse = lootHouse,
		Tier = tier,
		Settings = Config.HouseTiers[tier],
		GuardId = guardId,
		GuardInfo = guardInfo,
		ZoneCFrame = zone.CFrame,
		ZoneHalfSize = half,
		FrontInset = if type(inset) == "number" then inset else Config.Alarm.HouseFrontInset,
		GuardSpeed = guardInfo.Speed,
		ChaseMaxX = maxX + 4,
		Loot = loot,
		Spots = {},
		SpotById = {},
		Guards = {},
		Doors = {},
		Route = {},
		Rooms = {},
		Via = {},
		Lasers = {},
		AlarmActive = false,
		LastOccupiedAt = 0,
		Intruders = {},
	}
	model:SetAttribute("AlarmActive", false)
	model:SetAttribute("Open", not DayNight.isDaytime())

	local spots = model:FindFirstChild("ItemSpots")
	if spots then
		for _, part in spots:GetChildren() do
			if part:IsA("BasePart") then
				local spot: Spot = { Part = part, Item = nil, ItemId = nil }
				table.insert(house.Spots, spot)
				house.SpotById[part.Name] = spot
				spawnItem(house, spot)
			end
		end
	end

	local docks = model:FindFirstChild("GuardDocks")
	if docks then
		for _, dock in docks:GetChildren() do
			if dock:IsA("BasePart") then
				table.insert(house.Guards, buildGuard(house, dock))
			end
		end
	end

	local route = model:FindFirstChild("Route")
	if route then
		for _, node in route:GetChildren() do
			if node:IsA("BasePart") then
				-- The markers sit on the floor; the aim maths measures a character's root part, so
				-- lift each one the standard root height - the same place a thief standing there
				-- would be - and everything downstream reads them the same way.
				house.Route[node.Name] = node.Position + Vector3.new(0, FEET_BELOW_ROOT, 0)
			end
		end
	end

	local rooms = model:FindFirstChild("Rooms")
	if rooms then
		for _, roomPart in rooms:GetChildren() do
			if roomPart:IsA("BasePart") then
				table.insert(house.Rooms, roomPart)
				local via = roomPart:GetAttribute("Via")
				local node = if type(via) == "string" then house.Route[via] else nil
				if node then
					house.Via[roomPart.Name] = node
				end
			end
		end
	end

	local doors = model:FindFirstChild("Doors")
	if doors then
		for _, doorModel in doors:GetChildren() do
			if doorModel:IsA("Model") then
				local door = setupDoor(house, doorModel)
				if door then
					table.insert(house.Doors, door)
				end
			end
		end
	end

	local lasers = model:FindFirstChild("Lasers")
	if lasers then
		for _, laser in lasers:GetChildren() do
			if laser:IsA("BasePart") then
				setupLaser(house, laser)
			end
		end
	end

	table.insert(houses, house)
	housesById[house.Id] = house
end

local function doorLoop()
	while true do
		task.wait(1)
		local now = os.clock()
		for _, house in houses do
			for _, door in house.Doors do
				if door.IsOpen and now >= door.CloseAt then
					if anyoneOnProperty(house) or defendersComingHome(house) then
						door.CloseAt = now + 5 -- never slam a door on someone
					else
						setDoorOpen(door, false)
					end
				end
			end
		end
	end
end

function Houses.onPlayerRemoving(player: Player)
	bustedUntil[player] = nil
	laserCooldown[player] = nil
	Inventory.forgetPlayer(player)
	for _, house in houses do
		house.Intruders[player] = nil
	end
end

function Houses.init()
	local map = Workspace:WaitForChild("Map")
	local folder = map:WaitForChild("Houses")
	for _, model in folder:GetChildren() do
		if model:IsA("Model") then
			setupHouse(model)
		end
	end
	DayNight.onChanged(function(isDaytime: boolean)
		if isDaytime then
			onDaytime()
		else
			onNightfall()
		end
	end)
	RunService.Heartbeat:Connect(onHeartbeat)
	RunService.Heartbeat:Connect(updateLasers)
	task.spawn(doorLoop)
end

return Houses
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000000000000000000000000263A">
				<Properties>
					<string name="Name">Inventory</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Inventory
	---------
	Tracks the loot a player is carrying on foot (reclaimed to its original world
	spot if a guard busts you) and the loot stashed in the warehouse (saved). Also
	shows a loot sack on the player's back that grows with every item they carry.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Items = require(ReplicatedStorage.Shared.Items)
local PlayerData = require(script.Parent.PlayerData)

export type LootOrigin = {
	HouseId: string,
	SpotId: string,
}

export type CarriedLoot = {
	ItemId: string,
	Origin: LootOrigin?,
}

type OriginSlot = {
	Origin: LootOrigin?,
}

local Inventory = {}

-- Origins deliberately live alongside PlayerData's string-only bag. A bag can also contain an
-- item taken back off a warehouse shelf, which has no active world-loot origin. Keeping one slot
-- per carried item preserves the precise source of fresh thefts without changing the existing
-- inventory/UI format.
local carriedOrigins: { [Player]: { OriginSlot } } = {}

local SACK_COLOR = Color3.fromRGB(150, 110, 62)

local function updateSack(player: Player, count: number)
	local character = player.Character
	if not character then
		return
	end
	local existing = character:FindFirstChild("LootSack")
	if count <= 0 then
		if existing then
			existing:Destroy()
		end
		return
	end

	local torso = (character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")) :: BasePart?
	if not torso then
		return
	end

	local sack: Part
	if existing and existing:IsA("Part") then
		sack = existing
	else
		if existing then
			existing:Destroy()
		end
		sack = Instance.new("Part")
		sack.Name = "LootSack"
		sack.Shape = Enum.PartType.Ball
		sack.Material = Enum.Material.Fabric
		sack.Color = SACK_COLOR
		sack.CanCollide = false
		sack.CanQuery = false
		sack.CanTouch = false
		sack.Massless = true
		sack.TopSurface = Enum.SurfaceType.Smooth
		sack.BottomSurface = Enum.SurfaceType.Smooth

		local knot = Instance.new("Part")
		knot.Name = "Knot"
		knot.Size = Vector3.new(0.5, 0.5, 0.5)
		knot.Color = Color3.fromRGB(110, 78, 40)
		knot.Material = Enum.Material.Fabric
		knot.CanCollide = false
		knot.CanQuery = false
		knot.CanTouch = false
		knot.Massless = true
		knot.TopSurface = Enum.SurfaceType.Smooth
		knot.BottomSurface = Enum.SurfaceType.Smooth
		knot.Parent = sack

		local knotWeld = Instance.new("Weld")
		knotWeld.Name = "KnotWeld"
		knotWeld.Part0 = sack
		knotWeld.Part1 = knot
		knotWeld.Parent = knot

		local weld = Instance.new("Weld")
		weld.Name = "SackWeld"
		weld.Part0 = torso
		weld.Part1 = sack
		weld.Parent = sack

		local dollar = Instance.new("BillboardGui")
		dollar.Name = "Dollar"
		dollar.Size = UDim2.fromScale(1.2, 1.2)
		dollar.LightInfluence = 0
		dollar.MaxDistance = 80
		dollar.Parent = sack
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.FredokaOne
		label.Text = "$"
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(255, 220, 90)
		label.TextStrokeTransparency = 0.2
		label.Parent = dollar

		sack.Parent = character
	end

	local diameter = math.min(1.4 + count * 0.22, 3.8)
	sack.Size = Vector3.new(diameter, diameter, diameter)

	local weld = sack:FindFirstChild("SackWeld")
	if weld and weld:IsA("Weld") then
		weld.Part0 = torso
		weld.C0 = CFrame.new(0, 0.3, torso.Size.Z / 2 + diameter / 2 - 0.35)
	end
	local knot = sack:FindFirstChild("Knot")
	local knotWeld = if knot then knot:FindFirstChild("KnotWeld") else nil
	if knotWeld and knotWeld:IsA("Weld") then
		knotWeld.C0 = CFrame.new(0, diameter / 2, 0)
	end
end

-- Pushes inventory numbers to attributes and refreshes the loot sack.
function Inventory.refresh(player: Player)
	local session = PlayerData.get(player)
	if not session then
		return
	end
	player:SetAttribute("Carried", #session.Carried)
	player:SetAttribute("CarriedList", table.concat(session.Carried, ","))
	updateSack(player, #session.Carried)
end

function Inventory.getCarriedCount(player: Player): number
	local session = PlayerData.get(player)
	return if session then #session.Carried else 0
end

function Inventory.getCarriedValue(player: Player): number
	local session = PlayerData.get(player)
	if not session then
		return 0
	end
	local total = 0
	for _, itemId in session.Carried do
		total += Items.getValue(itemId)
	end
	return total
end

-- Tries to put an item in the player's bag. Loot taken from a world spot carries its source
-- identity, while warehouse items deliberately pass nil because they are no longer tied to a live
-- loot spot.
function Inventory.addCarried(player: Player, itemId: string, origin: LootOrigin?): (boolean, string?)
	local session = PlayerData.get(player)
	if not session then
		return false, "Still loading your data..."
	end
	local capacity = PlayerData.getUpgradeValue(player, "Bag")
	if #session.Carried >= capacity then
		return false, "🎒 Your bag is full! Bring the loot to your warehouse."
	end
	table.insert(session.Carried, itemId)
	local origins = carriedOrigins[player]
	if not origins then
		origins = {}
		carriedOrigins[player] = origins
	end
	table.insert(origins, { Origin = origin })
	Inventory.refresh(player)
	return true, nil
end

-- Removes one bag item and its matching provenance. Market sales use this instead of mutating the
-- session array directly, so an item sold before a bust can never be returned a second time.
function Inventory.removeCarried(player: Player, itemId: string): boolean
	local session = PlayerData.get(player)
	if not session then
		return false
	end
	local index = table.find(session.Carried, itemId)
	if not index then
		return false
	end
	table.remove(session.Carried, index)
	local origins = carriedOrigins[player]
	if origins then
		table.remove(origins, index)
	end
	Inventory.refresh(player)
	return true
end

-- Empties the bag with the optional source for every item intact. Only the house-catch flow needs
-- these records; deposits and sales use takeCarried below and intentionally discard them.
function Inventory.takeCarriedWithOrigins(player: Player): { CarriedLoot }
	local session = PlayerData.get(player)
	if not session then
		return {}
	end
	local items = session.Carried
	local origins = carriedOrigins[player]
	local carried: { CarriedLoot } = {}
	for index, itemId in items do
		local slot = if origins then origins[index] else nil
		table.insert(carried, { ItemId = itemId, Origin = if slot then slot.Origin else nil })
	end
	session.Carried = {}
	carriedOrigins[player] = nil
	Inventory.refresh(player)
	return carried
end

-- Empties the bag and returns item IDs for callers that only need to deposit or sell them.
function Inventory.takeCarried(player: Player): { string }
	local carried = Inventory.takeCarriedWithOrigins(player)
	local items: { string } = {}
	for _, loot in carried do
		table.insert(items, loot.ItemId)
	end
	return items
end

function Inventory.forgetPlayer(player: Player)
	carriedOrigins[player] = nil
end

return Inventory
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000000000000000000000000263B">
				<Properties>
					<string name="Name">Market</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Market
	------
	The sell point: the market stall in the middle of the yard, where loot is
	turned into cash on the spot instead of being shelved.

	  * Sells whatever the player is carrying (their bag).
	  * Pays Config.Economy.SellRatio of the item's value — the same as selling
	    straight off a warehouse shelf.

	The client window (client/SellPoint.luau) asks for the list, then sells by
	item or all at once; every sale is validated here.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Items = require(ReplicatedStorage.Shared.Items)
local Inventory = require(script.Parent.Inventory)
local Notify = require(script.Parent.Notify)
local PlayerData = require(script.Parent.PlayerData)

type Sale = { ItemId: string, Source: string }

local Market = {}

local BAG = "Bag"

-- Everything the player could sell right now.
function Market.list(player: Player): { Sale }
	local session = PlayerData.get(player)
	if not session then
		return {}
	end
	local sales: { Sale } = {}
	for _, itemId in session.Carried do
		table.insert(sales, { ItemId = itemId, Source = BAG })
	end
	return sales
end

-- Sells one item out of the bag the player is carrying.
function Market.sell(player: Player, itemId: string): (boolean, string)
	local session = PlayerData.get(player)
	local def = Items.get(itemId)
	if not session or not def then
		return false, "That item has gone missing."
	end
	if not Inventory.removeCarried(player, itemId) then
		return false, string.format("No %s in your bag.", def.DisplayName)
	end
	local value = Items.getSellValue(itemId)
	PlayerData.addCash(player, value)
	return true, string.format("💵 Sold %s for %s", def.DisplayName, Format.money(value))
end

-- Sells everything the player brought to the stall. Returns (count, total).
function Market.sellAll(player: Player): (number, number)
	local total, count = 0, 0
	for _, sale in Market.list(player) do
		local ok = Market.sell(player, sale.ItemId)
		if ok then
			total += Items.getSellValue(sale.ItemId)
			count += 1
		end
	end
	return count, total
end

local function addPrompt()
	local map = Workspace:WaitForChild("Map")
	local found = map:FindFirstChild("SellCounter", true)
	if not (found and found:IsA("BasePart")) then
		warn("[Market] No SellCounter part found; the sell point is unavailable.")
		return
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "OpenSellPrompt"
	prompt.ActionText = "Sell loot"
	prompt.ObjectText = "💰 SELL POINT"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = Config.Market.PromptDistance
	prompt.RequiresLineOfSight = false
	prompt.Parent = found
end

function Market.init()
	local remote = ReplicatedStorage.Remotes.Sell
	remote.OnServerInvoke = function(player: Player, action: any, itemId: any)
		if action == "List" then
			return {
				Ok = true,
				Sales = Market.list(player),
			}
		end
		if action == "Sell" and type(itemId) == "string" then
			local ok, message = Market.sell(player, itemId)
			if ok then
				Notify.send(player, message, "money")
			else
				Notify.send(player, message, "error")
			end
			return { Ok = ok, Message = message }
		end
		if action == "All" then
			local count, total = Market.sellAll(player)
			if count == 0 then
				return { Ok = false, Message = "You have nothing to sell — steal something first!" }
			end
			Notify.send(player, string.format("💵 Sold %d item%s for %s!", count, if count == 1 then "" else "s",
				Format.money(total)), "money")
			return {
				Ok = true,
				Message = string.format("Sold %d for %s", count, Format.money(total)),
				Count = count,
				Value = total,
			}
		end
		return { Ok = false, Message = "The trader doesn't understand that." }
	end
	addPrompt()
end

return Market
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000000000000000000000000263C">
				<Properties>
					<string name="Name">Notify</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Notify
	------
	Sends toast notifications to a player's screen.
	Kinds: "info", "success", "error", "money", "warning", "steal", "level"
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local NotifyEvent = ReplicatedStorage.Remotes.Notify

local Notify = {}

function Notify.send(player: Player, text: string, kind: string?)
	if player.Parent then
		NotifyEvent:FireClient(player, text, kind or "info")
	end
end

function Notify.all(text: string, kind: string?)
	NotifyEvent:FireAllClients(text, kind or "info")
end

return Notify
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000000000000000000000000263D">
				<Properties>
					<string name="Name">PlayerData</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	PlayerData
	----------
	Owns every player's saved profile (cash, upgrades, speed, warehouse and
	trunk contents) plus their in-session state (items currently carried).

	Important numbers are mirrored onto Player attributes so the client UI can
	react to them without any extra remotes:
	  Cash, Income, Carried, CarriedList, BagCapacity,
	  StoredCount, StorageCapacity, Speed, SpeedPoints, SpeedProgress,
	  Rebirths (production multiplier is x1 + x0.5 per rebirth: see Config.Rebirth),
	  WalkSpeed (the real speed; WalkSpeed is held at Config.Alarm.InsideSpeed
	  while InHouse is true), InHouse, Level_<UpgradeId>, Discovered
	  (comma-separated item ids for the Loot Index)

	Saving uses DataStoreService. When the place is unpublished or Studio API
	access is off, the game still works but progress is session-only.
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Items = require(ReplicatedStorage.Shared.Items)

export type Profile = {
	Cash: number,
	Levels: { [string]: number },
	SpeedPoints: number, -- trained display-speed; whole points raise the 5x Speed stat
	Rebirths: number, -- completed rebirths; drives the production multiplier (see Config.Rebirth)
	Stored: { string },
	TotalStolen: number,
	TotalEarned: number,
	Discovered: { string }, -- every item this player has ever stolen (the Loot Index)
}

export type Leaderstats = {
	Cash: IntValue,
	Stolen: IntValue,
	Speed: IntValue,
	Rebirths: IntValue,
}

export type Session = {
	Player: Player,
	Profile: Profile,
	Carried: { string },
	Income: number,
	CanSave: boolean,
	Loaded: boolean,
	Leaderstats: Leaderstats?,
}

local STORE_NAME = "StealAnItem_PlayerData_v1"
local MAX_LOAD_ATTEMPTS = 3

local PlayerData = {}

local sessions: { [Player]: Session } = {}
-- Players standing on someone's property: everyone moves at the standard Roblox
-- speed in there, so their treadmill speed is held back until they are back out.
local insideHouse: { [Player]: boolean? } = {}
local store: DataStore? = nil
local saveWarning = "Progress will not be saved in this session."

if game.PlaceId == 0 then
	saveWarning = "This place isn't published yet, so progress won't be saved. (Publish it and enable Studio API access to test saving.)"
else
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		saveWarning = "DataStores are unavailable, so progress won't be saved this session."
		warn("[PlayerData] Could not open DataStore: " .. tostring(result))
	end
end

local function dataKey(player: Player): string
	return "Player_" .. player.UserId
end

local function defaultProfile(): Profile
	local levels: { [string]: number } = {}
	for _, upgrade in Config.Upgrades do
		levels[upgrade.Id] = 1
	end
	return {
		Cash = Config.Economy.StartingCash,
		Levels = levels,
		SpeedPoints = 0,
		Rebirths = 0,
		Stored = {},
		TotalStolen = 0,
		TotalEarned = 0,
		Discovered = {},
	}
end

local function readNumber(value: any, fallback: number, minimum: number, maximum: number): number
	if type(value) ~= "number" or value ~= value then
		return fallback
	end
	return math.clamp(value, minimum, maximum)
end

local function readItemList(value: any, limit: number): { string }
	local result: { string } = {}
	if type(value) ~= "table" then
		return result
	end
	for _, itemId in value do
		if #result >= limit then
			break
		end
		if type(itemId) == "string" and Items.get(itemId) then
			table.insert(result, itemId)
		end
	end
	return result
end

-- Turns whatever came out of the DataStore into a valid profile.
local function sanitize(raw: any): Profile
	local profile = defaultProfile()
	if type(raw) ~= "table" then
		return profile
	end
	profile.Cash = math.floor(readNumber(raw.Cash, profile.Cash, 0, 1e15))
	if type(raw.Levels) == "table" then
		for _, upgrade in Config.Upgrades do
			profile.Levels[upgrade.Id] = math.floor(readNumber(raw.Levels[upgrade.Id], 1, 1, #upgrade.Values))
		end
		-- Older saves unlocked Pro/Elite treadmills at the Gym; turn those into treadmill levels.
		if raw.Levels.Treadmill == nil then
			if raw.Levels.EliteTreadmill == 2 then
				profile.Levels.Treadmill = 6
			elseif raw.Levels.ProTreadmill == 2 then
				profile.Levels.Treadmill = 3
			end
		end
	end
	-- Version 1 stored points under the old 1 point = 4 studs/s rule. Version 2
	-- counts display-speed points instead, where Speed is always 5x studs/s.
	-- Convert old saves so players keep exactly the same physical movement speed.
	local version = math.floor(readNumber(raw.Version, 0, 0, 1e9))
	local legacyLevel = readNumber(raw.SpeedLevel, 0, 0, 1e9)
	local savedPoints = readNumber(raw.SpeedPoints, -1, -1, 1e15)
	if savedPoints >= 0 then
		profile.SpeedPoints = if version >= 2 then savedPoints else savedPoints * 20
	else
		-- Very old saves used one SpeedLevel per extra stud/s.
		profile.SpeedPoints = legacyLevel * Config.Speed.DisplayMultiplier
	end
	profile.Rebirths = math.floor(readNumber(raw.Rebirths, 0, 0, 1e12)) -- rebirths never cap out
	profile.Stored = readItemList(raw.Stored, Config.getUpgradeValue("Storage", profile.Levels.Storage))
	-- The getaway car (and its trunk) is gone. Anything an old save still had in the trunk is
	-- moved onto the warehouse shelves so nobody loses loot; the overflow is written off.
	local legacyTrunk = readItemList(raw.Trunk, 0)
	for _, itemId in legacyTrunk do
		if #profile.Stored < Config.getUpgradeValue("Storage", profile.Levels.Storage) then
			table.insert(profile.Stored, itemId)
		end
	end
	profile.TotalStolen = math.floor(readNumber(raw.TotalStolen, 0, 0, 1e12))
	profile.TotalEarned = math.floor(readNumber(raw.TotalEarned, 0, 0, 1e18))
	-- Saves from before the Loot Index count the items they already own as discovered.
	local discovered = if type(raw.Discovered) == "table" then raw.Discovered else nil
	local source = discovered or table.move(legacyTrunk, 1, #legacyTrunk, #profile.Stored + 1, table.clone(profile.Stored))
	local seen: { [string]: boolean } = {}
	for _, itemId in readItemList(source, #Items.List * 4) do
		if not seen[itemId] then
			seen[itemId] = true
			table.insert(profile.Discovered, itemId)
		end
	end
	return profile
end

local function createLeaderstats(player: Player, session: Session)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"

	local cash = Instance.new("IntValue")
	cash.Name = "Cash"
	cash.Parent = folder

	local stolen = Instance.new("IntValue")
	stolen.Name = "Stolen"
	stolen.Parent = folder

	local speed = Instance.new("IntValue")
	speed.Name = "Speed"
	speed.Parent = folder

	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = folder

	folder.Parent = player
	session.Leaderstats = { Cash = cash, Stolen = stolen, Speed = speed, Rebirths = rebirths }
end

--------------------------------------------------------------------------------
-- Session access
--------------------------------------------------------------------------------
function PlayerData.get(player: Player): Session?
	local session = sessions[player]
	if session and session.Loaded then
		return session
	end
	return nil
end

function PlayerData.getSaveWarning(): string
	return saveWarning
end

function PlayerData.getUpgradeLevel(player: Player, upgradeId: string): number
	local session = sessions[player]
	if not session then
		return 1
	end
	return session.Profile.Levels[upgradeId] or 1
end

function PlayerData.getUpgradeValue(player: Player, upgradeId: string): number
	return Config.getUpgradeValue(upgradeId, PlayerData.getUpgradeLevel(player, upgradeId))
end

-- Trained speed points (a float: the treadmill trickles them in).
function PlayerData.getSpeedPoints(player: Player): number
	local session = sessions[player]
	return if session then session.Profile.SpeedPoints else 0
end

-- The player-facing Speed stat shown by the HUD, leaderboard and treadmill.
-- It is always five times the real movement speed in studs/s.
function PlayerData.getSpeedStat(player: Player): number
	return Config.speedStatForPoints(PlayerData.getSpeedPoints(player))
end

function PlayerData.getWalkSpeed(player: Player): number
	return Config.walkSpeedForPoints(PlayerData.getSpeedPoints(player))
end

-- Completed rebirths (0 for a fresh player): the production multiplier is on Config.
function PlayerData.getRebirths(player: Player): number
	local session = sessions[player]
	return if session then session.Profile.Rebirths else 0
end

--------------------------------------------------------------------------------
-- Replication to the client (attributes + leaderstats)
--------------------------------------------------------------------------------
function PlayerData.replicateCash(player: Player)
	local session = sessions[player]
	if not session then
		return
	end
	player:SetAttribute("Cash", session.Profile.Cash)
	local stats = session.Leaderstats
	if stats then
		stats.Cash.Value = session.Profile.Cash
	end
end

function PlayerData.replicate(player: Player)
	local session = sessions[player]
	if not session then
		return
	end
	local profile = session.Profile

	PlayerData.replicateCash(player)
	player:SetAttribute("Income", session.Income)
	player:SetAttribute("SpeedPoints", profile.SpeedPoints)
	player:SetAttribute("SpeedProgress", profile.SpeedPoints - math.floor(profile.SpeedPoints))
	player:SetAttribute("Speed", Config.speedStatForPoints(profile.SpeedPoints))
	player:SetAttribute("WalkSpeed", PlayerData.getWalkSpeed(player))
	player:SetAttribute("Rebirths", profile.Rebirths)
	for _, upgrade in Config.Upgrades do
		player:SetAttribute("Level_" .. upgrade.Id, profile.Levels[upgrade.Id])
	end
	player:SetAttribute("BagCapacity", PlayerData.getUpgradeValue(player, "Bag"))
	player:SetAttribute("StorageCapacity", PlayerData.getUpgradeValue(player, "Storage"))
	player:SetAttribute("Carried", #session.Carried)
	player:SetAttribute("CarriedList", table.concat(session.Carried, ","))
	player:SetAttribute("StoredCount", #profile.Stored)
	player:SetAttribute("Discovered", table.concat(profile.Discovered, ","))

	local stats = session.Leaderstats
	if stats then
		stats.Stolen.Value = profile.TotalStolen
		stats.Speed.Value = Config.speedStatForPoints(profile.SpeedPoints)
		stats.Rebirths.Value = profile.Rebirths
	end
end

--------------------------------------------------------------------------------
-- Cash, income, stats
--------------------------------------------------------------------------------
function PlayerData.addCash(player: Player, amount: number)
	local session = sessions[player]
	if not session or amount <= 0 then
		return
	end
	local whole = math.floor(amount)
	session.Profile.Cash += whole
	session.Profile.TotalEarned += whole
	PlayerData.replicateCash(player)
end

function PlayerData.trySpend(player: Player, amount: number): boolean
	local session = sessions[player]
	if not session or amount < 0 or session.Profile.Cash < amount then
		return false
	end
	session.Profile.Cash -= amount
	PlayerData.replicateCash(player)
	return true
end

function PlayerData.recalculateIncome(player: Player): number
	local session = sessions[player]
	if not session then
		return 0
	end
	local total = 0
	for _, itemId in session.Profile.Stored do
		total += Items.getIncome(itemId)
	end
	-- Rebirths multiply warehouse income (x1.5 at one rebirth, x3 at five).
	session.Income = total * Config.rebirthMultiplier(session.Profile.Rebirths)
	player:SetAttribute("Income", total)
	player:SetAttribute("StoredCount", #session.Profile.Stored)
	return total
end

function PlayerData.addStolen(player: Player, count: number)
	local session = sessions[player]
	if not session then
		return
	end
	session.Profile.TotalStolen += count
	local stats = session.Leaderstats
	if stats then
		stats.Stolen.Value = session.Profile.TotalStolen
	end
end

-- Records a stolen item in the player's Loot Index. Returns true the first time.
function PlayerData.discover(player: Player, itemId: string): boolean
	local session = sessions[player]
	if not session or not Items.get(itemId) or table.find(session.Profile.Discovered, itemId) then
		return false
	end
	table.insert(session.Profile.Discovered, itemId)
	player:SetAttribute("Discovered", table.concat(session.Profile.Discovered, ","))
	return true
end

function PlayerData.getDiscoveredCount(player: Player): number
	local session = sessions[player]
	return if session then #session.Profile.Discovered else 0
end

function PlayerData.applyWalkSpeed(player: Player)
	local walkSpeed = PlayerData.getWalkSpeed(player)
	player:SetAttribute("WalkSpeed", walkSpeed)
	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if humanoid then
		-- Inside a house the thief moves at the same standard speed as the defenders.
		humanoid.WalkSpeed = if insideHouse[player] then math.min(walkSpeed, Config.Alarm.InsideSpeed) else walkSpeed
	end
	local session = sessions[player]
	local stats = if session then session.Leaderstats else nil
	if stats then
		-- Keep the leaderboard aligned with the HUD's player-facing Speed value,
		-- not the smaller physical studs-per-second value.
		stats.Speed.Value = PlayerData.getSpeedStat(player)
	end
end

-- Called by Houses when a player steps onto (or off) a house's property.
function PlayerData.setInsideHouse(player: Player, inside: boolean)
	if (insideHouse[player] == true) == inside then
		return
	end
	insideHouse[player] = if inside then true else nil
	player:SetAttribute("InHouse", inside)
	PlayerData.applyWalkSpeed(player)
end

function PlayerData.isInsideHouse(player: Player): boolean
	return insideHouse[player] == true
end

-- Adds treadmill training. Returns how many whole speed points were gained.
function PlayerData.addSpeed(player: Player, points: number): number
	local session = sessions[player]
	if not session or points <= 0 then
		return 0
	end
	local profile = session.Profile
	-- Rebirths multiply treadmill training too.
	points = points * Config.rebirthMultiplier(profile.Rebirths)
	local before = math.floor(profile.SpeedPoints)
	profile.SpeedPoints += points
	local after = math.floor(profile.SpeedPoints)
	player:SetAttribute("SpeedPoints", profile.SpeedPoints)
	player:SetAttribute("SpeedProgress", profile.SpeedPoints - after)
	player:SetAttribute("Speed", Config.speedStatForPoints(profile.SpeedPoints))
	if after > before then
		PlayerData.applyWalkSpeed(player)
	end
	return after - before
end

-- Bash back to zero (or any value) in one go: the rebirth trade spends every trained point.
function PlayerData.setSpeedPoints(player: Player, points: number)
	local session = sessions[player]
	if not session then
		return
	end
	local profile = session.Profile
	profile.SpeedPoints = math.max(0, points)
	player:SetAttribute("SpeedPoints", profile.SpeedPoints)
	player:SetAttribute("SpeedProgress", profile.SpeedPoints - math.floor(profile.SpeedPoints))
	player:SetAttribute("Speed", Config.speedStatForPoints(profile.SpeedPoints))
	PlayerData.applyWalkSpeed(player)
end

--------------------------------------------------------------------------------
-- Loading & saving
--------------------------------------------------------------------------------
function PlayerData.load(player: Player): Session
	local session: Session = {
		Player = player,
		Profile = defaultProfile(),
		Carried = {},
		Income = 0,
		CanSave = false,
		Loaded = false,
		Leaderstats = nil,
	}
	sessions[player] = session

	local dataStore = store
	if dataStore then
		local key = dataKey(player)
		local success: boolean, result: any = false, nil
		for attempt = 1, MAX_LOAD_ATTEMPTS do
			success, result = pcall(function()
				return dataStore:GetAsync(key)
			end)
			if success then
				break
			end
			warn(string.format("[PlayerData] Load attempt %d for %s failed: %s", attempt, player.Name, tostring(result)))
			local message = tostring(result)
			if string.find(message, "403") or string.find(message, "Studio") then
				-- API access is disabled in Studio: retrying won't help.
				saveWarning = "Studio API access is off, so progress won't be saved. (Game Settings > Security > Enable Studio Access to API Services)"
				break
			end
			if attempt < MAX_LOAD_ATTEMPTS then
				task.wait(attempt * 1.5)
			end
		end
		if success then
			session.Profile = sanitize(result)
			session.CanSave = true
		else
			-- Never overwrite real saved data with a blank profile.
			session.CanSave = false
		end
	end

	session.Loaded = true
	createLeaderstats(player, session)
	PlayerData.recalculateIncome(player)
	PlayerData.replicate(player)
	return session
end

function PlayerData.save(player: Player): boolean
	local session = sessions[player]
	local dataStore = store
	if not session or not session.Loaded or not session.CanSave or not dataStore then
		return false
	end
	local profile = session.Profile
	local payload = {
		Version = 2,
		SavedAt = os.time(),
		Cash = profile.Cash,
		Levels = table.clone(profile.Levels),
		SpeedPoints = profile.SpeedPoints,
		Rebirths = profile.Rebirths,
		Stored = table.clone(profile.Stored),
		TotalStolen = profile.TotalStolen,
		TotalEarned = profile.TotalEarned,
		Discovered = table.clone(profile.Discovered),
	}
	local ok, err = pcall(function()
		dataStore:UpdateAsync(dataKey(player), function(_old: any)
			return payload
		end)
	end)
	if not ok then
		warn(string.format("[PlayerData] Failed to save %s: %s", player.Name, tostring(err)))
	end
	return ok
end

-- Saves and forgets a player (call when they leave).
function PlayerData.release(player: Player)
	insideHouse[player] = nil
	if sessions[player] then
		PlayerData.save(player)
		sessions[player] = nil
	end
end

function PlayerData.start()
	-- Autosave
	task.spawn(function()
		while true do
			task.wait(Config.Economy.AutosaveInterval)
			for player in sessions do
				task.spawn(PlayerData.save, player)
			end
		end
	end)

	-- Save everyone when the server shuts down.
	game:BindToClose(function()
		if not store then
			return
		end
		local pending = 0
		for player in sessions do
			pending += 1
			task.spawn(function()
				PlayerData.save(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return PlayerData
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000000000000000000000000263E">
				<Properties>
					<string name="Name">Plots</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Plots
	-----
	Every player gets their own warehouse (up to 6 per server). Stolen items
	dropped on the green DEPOSIT pad go onto the shelves, where each one earns
	cash every second. Owners can sell shelf items with a prompt.

	When the warehouse is full, depositing a better item automatically sells
	your cheapest item to make room (and cheaper loot is sold on the spot).

	Map layout expected (built by tools/build_place.py):
	  Workspace.Map.Warehouses.Plot<N>  (Model, attribute PlotIndex)
	    Spawn       SpawnLocation
	    DepositPad  Part
	    Dock        Part (loading dock zone, reserved)
	    Slots       Folder of Parts (attribute Index = shelf order)
	    Treadmill   Model (the owner's personal treadmill, see Treadmills.luau)
	    ...a TextLabel named "OwnerText" and one named "StatsText"
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Format = require(ReplicatedStorage.Shared.Format)
local ItemModels = require(ReplicatedStorage.Shared.ItemModels)
local Items = require(ReplicatedStorage.Shared.Items)
local Inventory = require(script.Parent.Inventory)
local Notify = require(script.Parent.Notify)
local PlayerData = require(script.Parent.PlayerData)

type Plot = {
	Index: number,
	Model: Model,
	Owner: Player?,
	Spawn: SpawnLocation?,
	DepositPad: BasePart,
	Dock: BasePart,
	Slots: { BasePart },
	SlotColors: { Color3 },
	Display: Folder,
	OwnerLabel: TextLabel?,
	StatsLabel: TextLabel?,
}

local LOCKED_SLOT_COLOR = Color3.fromRGB(120, 40, 40)

local Plots = {}

local plots: { Plot } = {}
local plotByPlayer: { [Player]: Plot } = {}
local hubSpawn: SpawnLocation? = nil
local touchCooldown: { [Player]: number } = {}

local function findTextLabel(container: Instance, name: string): TextLabel?
	local found = container:FindFirstChild(name, true)
	if found and found:IsA("TextLabel") then
		return found
	end
	return nil
end

local function playerFromHit(hit: BasePart): Player?
	local model = hit:FindFirstAncestorOfClass("Model")
	if not model then
		return nil
	end
	return Players:GetPlayerFromCharacter(model)
end

local function numberAttribute(instance: Instance, name: string): number
	local value = instance:GetAttribute(name)
	return if type(value) == "number" then value else 0
end

local function resetVisuals(plot: Plot)
	plot.Display:ClearAllChildren()
	for index, slot in plot.Slots do
		slot.Color = plot.SlotColors[index]
		slot.Transparency = 0
	end
	if plot.OwnerLabel then
		plot.OwnerLabel.Text = "EMPTY WAREHOUSE"
	end
	if plot.StatsLabel then
		plot.StatsLabel.Text = "Waiting for a new owner..."
	end
end

function Plots.getPlot(player: Player): Plot?
	return plotByPlayer[player]
end

-- The player who owns the warehouse `model` (nil while it's free).
function Plots.getOwner(model: Instance): Player?
	for _, plot in plots do
		if plot.Model == model then
			return plot.Owner
		end
	end
	return nil
end

-- How many items the player's warehouse can hold right now.
function Plots.getCapacity(player: Player): number
	local capacity = PlayerData.getUpgradeValue(player, "Storage")
	local plot = plotByPlayer[player]
	if plot and #plot.Slots > 0 then
		capacity = math.min(capacity, #plot.Slots)
	end
	return capacity
end

-- Where the player should appear after respawning or getting busted.
function Plots.getSpawnCFrame(player: Player): CFrame?
	local plot = plotByPlayer[player]
	local spawnPart: BasePart? = if plot and plot.Spawn then plot.Spawn else hubSpawn
	if spawnPart then
		return spawnPart.CFrame + Vector3.new(0, spawnPart.Size.Y / 2 + 3, 0)
	end
	return nil
end

local function updateStats(plot: Plot, player: Player)
	local session = PlayerData.get(player)
	if not plot.StatsLabel or not session then
		return
	end
	plot.StatsLabel.Text = string.format(
		"📦 Shelves: %d / %d\n💵 Income: %s / sec\n🦝 Items stolen: %s",
		#session.Profile.Stored,
		Plots.getCapacity(player),
		Format.money(session.Income),
		Format.commas(session.Profile.TotalStolen)
	)
end

function Plots.sell(player: Player, itemId: string): (boolean, string)
	local session = PlayerData.get(player)
	local def = Items.get(itemId)
	if not session or not def then
		return false, "That item has gone missing."
	end
	local index = table.find(session.Profile.Stored, itemId)
	if not index then
		return false, "That item is no longer on your shelves."
	end
	table.remove(session.Profile.Stored, index)
	local value = Items.getSellValue(itemId)
	PlayerData.addCash(player, value)
	PlayerData.recalculateIncome(player)
	Plots.refresh(player)
	return true, string.format("💵 Sold %s for %s", def.DisplayName, Format.money(value))
end

-- Everything on the player's shelves, in shelf order (the storage window lists it).
function Plots.storageList(player: Player): { string }
	local session = PlayerData.get(player)
	if not session then
		return {}
	end
	local items: { string } = {}
	for _, itemId in session.Profile.Stored do
		table.insert(items, itemId)
	end
	return items
end

local function addStoragePrompt(plot: Plot, target: BasePart, objectText: string, itemId: string?)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ShelfPrompt"
	prompt.ActionText = "Manage storage"
	prompt.ObjectText = objectText
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 6
	prompt.RequiresLineOfSight = false
	if itemId then
		prompt:SetAttribute("ItemId", itemId)
	end
	if plot.Owner then
		-- The client hides owner-only prompts from everyone else.
		prompt:SetAttribute("OwnerUserId", plot.Owner.UserId)
	end
	prompt.Parent = target
	prompt.Triggered:Connect(function(who: Player)
		if who ~= plot.Owner then
			Notify.send(who, "That's someone else's warehouse.", "error")
		end
	end)
end

-- Takes an item back off the shelves and into the player's bag (the opposite of depositing).
function Plots.take(player: Player, itemId: string): (boolean, string)
	local session = PlayerData.get(player)
	local def = Items.get(itemId)
	if not session or not def then
		return false, "That item is no longer on your shelves."
	end
	local index = table.find(session.Profile.Stored, itemId)
	if not index then
		return false, "That item is no longer on your shelves."
	end
	local capacity = PlayerData.getUpgradeValue(player, "Bag")
	if #session.Carried >= capacity then
		return false, string.format("🎒 Your bag is full (%d items). Sell something or upgrade your bag first.", capacity)
	end
	table.remove(session.Profile.Stored, index)
	Inventory.addCarried(player, itemId)
	PlayerData.recalculateIncome(player)
	Plots.refresh(player)
	return true, string.format("🎒 Took %s off the shelf (now in your bag).", def.DisplayName)
end

-- Rebuilds the shelf display, locked-slot colours and the stats board.
function Plots.refresh(player: Player)
	local plot = plotByPlayer[player]
	local session = PlayerData.get(player)
	if not plot or not session then
		return
	end
	local capacity = Plots.getCapacity(player)
	plot.Display:ClearAllChildren()
	for index, slot in plot.Slots do
		if index <= capacity then
			slot.Color = plot.SlotColors[index]
			slot.Transparency = 0
		else
			slot.Color = LOCKED_SLOT_COLOR
			slot.Transparency = 0.6
		end
	end
	for index, itemId in session.Profile.Stored do
		local slot = plot.Slots[index]
		if not slot then
			break
		end
		local model = ItemModels.build(itemId)
		if model then
			local root = model.PrimaryPart
			model:PivotTo(slot.CFrame * CFrame.new(0, slot.Size.Y / 2, 0))
			local def = Items.get(itemId)
			if root and def then
				addStoragePrompt(plot, root, string.format("%s (+%s/s)", def.DisplayName, Format.money(Items.getIncome(itemId))),
					itemId)
			end
			model.Parent = plot.Display
		end
	end
	updateStats(plot, player)
	player:SetAttribute("StorageCapacity", capacity)
	player:SetAttribute("StoredCount", #session.Profile.Stored)
end

-- Puts items into the player's warehouse, selling overflow smartly.
function Plots.deposit(player: Player, items: { string })
	local session = PlayerData.get(player)
	if not session or #items == 0 then
		return
	end
	local stored = session.Profile.Stored
	local capacity = Plots.getCapacity(player)
	local storedCount, soldCount, soldValue = 0, 0, 0

	for _, itemId in items do
		if #stored < capacity then
			table.insert(stored, itemId)
			storedCount += 1
		else
			-- Warehouse full: swap out the cheapest stored item if the new one is better.
			local cheapestIndex, cheapestValue = 0, math.huge
			for index, storedId in stored do
				local value = Items.getValue(storedId)
				if value < cheapestValue then
					cheapestIndex, cheapestValue = index, value
				end
			end
			if cheapestIndex > 0 and Items.getValue(itemId) > cheapestValue then
				soldValue += Items.getSellValue(stored[cheapestIndex])
				stored[cheapestIndex] = itemId
				storedCount += 1
			else
				soldValue += Items.getSellValue(itemId)
			end
			soldCount += 1
		end
	end

	-- Keep the most valuable items at the front of the shelves.
	table.sort(stored, function(a: string, b: string)
		return Items.getValue(a) > Items.getValue(b)
	end)

	if soldValue > 0 then
		PlayerData.addCash(player, soldValue)
	end
	PlayerData.recalculateIncome(player)
	Plots.refresh(player)

	if storedCount > 0 then
		Notify.send(
			player,
			string.format(
				"📦 Stashed %d item%s! Income: %s/sec",
				storedCount,
				if storedCount == 1 then "" else "s",
				Format.money(session.Income)
			),
			"success"
		)
	end
	if soldCount > 0 then
		Notify.send(
			player,
			string.format(
				"🏭 Warehouse full! Sold %d item%s for %s (upgrade Warehouse Space!)",
				soldCount,
				if soldCount == 1 then "" else "s",
				Format.money(soldValue)
			),
			"money"
		)
	end
end

-- Sells a list of items straight away (used when a player has no warehouse).
function Plots.sellAll(player: Player, items: { string })
	local total = 0
	for _, itemId in items do
		total += Items.getSellValue(itemId)
	end
	if total > 0 then
		PlayerData.addCash(player, total)
		Notify.send(
			player,
			string.format("💵 Sold %d item%s for %s", #items, if #items == 1 then "" else "s", Format.money(total)),
			"money"
		)
	end
end

local function onDepositTouched(plot: Plot, hit: BasePart)
	local player = playerFromHit(hit)
	if not player then
		return
	end
	local now = os.clock()
	if (touchCooldown[player] or 0) > now then
		return
	end
	touchCooldown[player] = now + 0.75
	if Inventory.getCarriedCount(player) == 0 then
		return
	end
	if plotByPlayer[player] == nil then
		-- Every warehouse is taken: let plotless players cash in their loot here.
		Plots.sellAll(player, Inventory.takeCarried(player))
		return
	end
	if plot.Owner ~= player then
		touchCooldown[player] = now + 4
		local ownerName = if plot.Owner then plot.Owner.DisplayName .. "'s" else "an empty"
		Notify.send(player, "This is " .. ownerName .. " warehouse! Follow the 🏠 marker to yours.", "warning")
		return
	end
	Plots.deposit(player, Inventory.takeCarried(player))
end

function Plots.assign(player: Player): Plot?
	local existing = plotByPlayer[player]
	if existing then
		return existing
	end
	for _, plot in plots do
		if plot.Owner == nil then
			plot.Owner = player
			plotByPlayer[player] = plot
			player:SetAttribute("PlotIndex", plot.Index)
			if plot.Spawn then
				player.RespawnLocation = plot.Spawn
			end
			if plot.OwnerLabel then
				plot.OwnerLabel.Text = string.upper(player.DisplayName) .. "'S WAREHOUSE"
			end
			if plot.StatsLabel then
				plot.StatsLabel.Text = "Loading..."
			end
			return plot
		end
	end
	-- Server is full of warehouse owners: fall back to the hub spawn.
	if hubSpawn then
		player.RespawnLocation = hubSpawn
	end
	return nil
end

function Plots.release(player: Player)
	local plot = plotByPlayer[player]
	plotByPlayer[player] = nil
	touchCooldown[player] = nil
	if plot then
		plot.Owner = nil
		resetVisuals(plot)
	end
end

function Plots.init()
	local map = Workspace:WaitForChild("Map")
	local folder = map:WaitForChild("Warehouses")
	local spawnCandidate = map:FindFirstChild("HubSpawn", true)
	if spawnCandidate and spawnCandidate:IsA("SpawnLocation") then
		hubSpawn = spawnCandidate
	end

	local models: { Model } = {}
	for _, child in folder:GetChildren() do
		if child:IsA("Model") and child:GetAttribute("PlotIndex") ~= nil then
			table.insert(models, child)
		end
	end
	table.sort(models, function(a: Model, b: Model)
		return numberAttribute(a, "PlotIndex") < numberAttribute(b, "PlotIndex")
	end)

	for _, model in models do
		local slots: { BasePart } = {}
		local slotsFolder = model:FindFirstChild("Slots")
		if slotsFolder then
			for _, slot in slotsFolder:GetChildren() do
				if slot:IsA("BasePart") then
					table.insert(slots, slot)
				end
			end
			table.sort(slots, function(a: BasePart, b: BasePart)
				return numberAttribute(a, "Index") < numberAttribute(b, "Index")
			end)
		end

		local depositPad = model:FindFirstChild("DepositPad")
		local dock = model:FindFirstChild("Dock")
		if not (depositPad and depositPad:IsA("BasePart") and dock and dock:IsA("BasePart")) then
			warn("[Plots] " .. model:GetFullName() .. " is missing DepositPad/Dock")
			continue
		end
		local spawnLocation = model:FindFirstChild("Spawn")

		local display = Instance.new("Folder")
		display.Name = "Display"
		display.Parent = model

		local plot: Plot = {
			Index = numberAttribute(model, "PlotIndex"),
			Model = model,
			Owner = nil,
			Spawn = if spawnLocation and spawnLocation:IsA("SpawnLocation") then spawnLocation else nil,
			DepositPad = depositPad,
			Dock = dock,
			Slots = slots,
			SlotColors = {},
			Display = display,
			OwnerLabel = findTextLabel(model, "OwnerText"),
			StatsLabel = findTextLabel(model, "StatsText"),
		}
		for index, slot in slots do
			plot.SlotColors[index] = slot.Color
		end
		depositPad.Touched:Connect(function(hit: BasePart)
			onDepositTouched(plot, hit)
		end)
		resetVisuals(plot)
		table.insert(plots, plot)
	end

	if #plots == 0 then
		warn("[Plots] No warehouse plots found in Workspace.Map.Warehouses")
	end

	-- The storage window (client/Storage.luau): list the shelves, take an item back
	-- into the bag, or sell it. Only the warehouse's owner may do any of it.
	local storageRemote = ReplicatedStorage.Remotes.Storage
	storageRemote.OnServerInvoke = function(player: Player, action: any, itemId: any)
		local plot = plotByPlayer[player]
		if not plot then
			return { Ok = false, Message = "You don't have a warehouse on this server.", Items = {} }
		end
		if action == "List" then
			return { Ok = true, Items = Plots.storageList(player) }
		end
		if action == "Take" and type(itemId) == "string" then
			local ok, message = Plots.take(player, itemId)
			Notify.send(player, message, if ok then "success" else "error")
			return { Ok = ok, Message = message, Items = Plots.storageList(player) }
		end
		if action == "Sell" and type(itemId) == "string" then
			local ok, message = Plots.sell(player, itemId)
			Notify.send(player, message, if ok then "money" else "error")
			return { Ok = ok, Message = message, Items = Plots.storageList(player) }
		end
		return { Ok = false, Message = "Unknown storage action.", Items = Plots.storageList(player) }
	end
end

return Plots
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000000000000000000000000263F">
				<Properties>
					<string name="Name">Rebirth</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rebirth
	-------
	Trade every speed point you have trained for a permanent production
	multiplier (treadmill training AND warehouse income, see Config.Rebirth).

	* The shrine beside the market hall (OpenRebirthPrompt) opens the client
	  window - the prompt itself is only a doorbell.
	* A rebirth costs Config.rebirthCost(count) speed points (1M, 2.5M, 6.25M, ...)
	  raises Profile.Rebirths by one, and sets your speed back to zero. The
	  multiplier itself is applied inside PlayerData (the treadmill's addSpeed
	  and the recalculateIncome totals), so this module only owns the trade.
	* All state on Remotes.Rebirth: "State" (or anything else) hands back the
	  player's rebirth info table, "Buy" attempts the rebirth.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local PlayerData = require(script.Parent.PlayerData)

local Rebirth = {}

-- One click per second per player is plenty for something this final.
local lastBuy: { [Player]: number } = {}

export type RebirthState = {
	Ok: boolean,
	Rebirths: number,
	Multiplier: number,
	NextMultiplier: number,
	Cost: number,
	SpeedPoints: number,
	CanAfford: boolean,
}

function Rebirth.state(player: Player): RebirthState
	local rebirths = PlayerData.getRebirths(player)
	local cost = Config.rebirthCost(rebirths)
	local points = PlayerData.getSpeedPoints(player)
	return {
		Ok = true,
		Rebirths = rebirths,
		Multiplier = Config.rebirthMultiplier(rebirths),
		NextMultiplier = Config.rebirthMultiplier(rebirths + 1),
		Cost = cost,
		SpeedPoints = points,
		CanAfford = points >= cost,
	}
end

function Rebirth.try(player: Player): (boolean, string)
	local session = PlayerData.get(player)
	if not session then
		return false, "Still loading your data..."
	end
	local now = os.clock()
	if (lastBuy[player] or 0) + 1.0 > now then
		return false, "Slow down!"
	end

	local rebirths = session.Profile.Rebirths
	local cost = Config.rebirthCost(rebirths)
	local points = PlayerData.getSpeedPoints(player)
	if points < cost then
		return false, string.format(
			"🔁 You need %s more speed! Keep running that treadmill.",
			Format.short(cost - points)
		)
	end

	-- The classic trade: everything you trained, for a permanent boost.
	lastBuy[player] = now
	session.Profile.Rebirths = rebirths + 1
	PlayerData.setSpeedPoints(player, 0)
	PlayerData.recalculateIncome(player) -- income now shows the new multiplier
	PlayerData.replicate(player)
	return true,
		string.format(
			"🔁 REBIRTH #%d! Everything you train and earn is x%s from now on — your speed starts from 0.",
			rebirths + 1,
			Format.decimal(Config.rebirthMultiplier(rebirths + 1), 2)
		)
end

local function addShrinePrompt()
	local map = Workspace:WaitForChild("Map")
	local shrine = map:FindFirstChild("RebirthShrine", true)
	if not (shrine and shrine:IsA("BasePart")) then
		warn("[Rebirth] No RebirthShrine part found in the map; the shrine is where players open the window.")
		return
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "OpenRebirthPrompt"
	prompt.ActionText = "Rebirth"
	prompt.ObjectText = "🔁 REBIRTH SHRINE"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = Config.Rebirth.PromptDistance
	prompt.RequiresLineOfSight = false
	prompt.Parent = shrine
end

function Rebirth.onPlayerRemoving(player: Player)
	lastBuy[player] = nil
end

function Rebirth.init()
	local remote = ReplicatedStorage.Remotes.Rebirth
	remote.OnServerInvoke = function(player: Player, action: any)
		if action == "Buy" then
			local ok, message = Rebirth.try(player)
			return { Ok = ok, Message = message }
		end
		return Rebirth.state(player)
	end
	addShrinePrompt()
end

return Rebirth
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000000000000000000000000002640">
				<Properties>
					<string name="Name">Treadmills</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Treadmills
	----------
	Every warehouse has its own treadmill out front. Walk onto yours and your
	character starts running by itself: there are no keys to hold, so you can
	go AFK and keep getting faster. ESCAPE (or Space) hops you off.

Training hands out player-facing "speed" (see Config.Speed): the displayed
Speed number is always five times the real walk speed in studs/s. It never
stops paying off - there is no speed cap - but you upgrade
	the treadmill itself (in the shop, or the prompt on its console) to train
	faster: every level doubles the speed gained and halves the wait between
	gains, so each level is four times as fast as the last.

	How a run works:
	  client  walks onto their own belt -> Remotes.Treadmill:InvokeServer("Start")
	  server  checks it's their treadmill and that they're standing on it, sets
	          the player's "Training" attribute and trains them every tick. No
	          input is needed, so AFK works. Training stops if they wander off,
	          die, sit down, lose their warehouse or leave.
	  client  ESCAPE / Space -> Remotes.Treadmill:InvokeServer("Stop")

	Map layout expected: Workspace.Map.Warehouses.Plot<N>.Treadmill (Model)
	  Belt        Part, the running surface
	  RunPoint    Part, where you run (its LookVector is the running direction)
	  ExitPoint   Part, where ESCAPE puts you (used by the client)
	  Console     Part, gets the "Upgrade" prompt
	  TreadmillText / TreadmillOwnerText  TextLabels on the console
	  Accent...   Parts recoloured to show the treadmill's level

	Attributes set on the Treadmill model for clients: OwnerUserId, Level, Running.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Economy = require(script.Parent.Economy)
local Notify = require(script.Parent.Notify)
local PlayerData = require(script.Parent.PlayerData)
local Plots = require(script.Parent.Plots)

type Treadmill = {
	Model: Model,
	PlotModel: Model,
	RunPoint: BasePart,
	Accents: { BasePart },
	Prompt: ProximityPrompt?,
	LevelLabel: TextLabel?,
	OwnerLabel: TextLabel?,
	-- What the display currently shows, so it's only rewritten when something changes.
	Shown: string,
}

type Trainer = {
	Treadmill: Treadmill,
	AwayTime: number, -- seconds spent too far from the belt
}

local TICK = 0.25
-- "Start" is accepted from further away than Config.Treadmill.MaxDistance because the
-- server sees the character a little behind where the player's own screen has it.
local START_DISTANCE = 20
local AWAY_GRACE = 2 -- seconds you may spend off the belt before training stops

local Treadmills = {}

local treadmills: { Treadmill } = {}
local trainers: { [Player]: Trainer } = {}

local function findTextLabel(container: Instance, name: string): TextLabel?
	local label = container:FindFirstChild(name, true)
	return if label and label:IsA("TextLabel") then label else nil
end

local function flatDistance(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

-- The treadmill outside the player's warehouse (nil if they don't have a warehouse).
local function treadmillFor(player: Player): Treadmill?
	local plot = Plots.getPlot(player)
	if not plot then
		return nil
	end
	for _, treadmill in treadmills do
		if treadmill.PlotModel == plot.Model then
			return treadmill
		end
	end
	return nil
end

-- Returns how far the player's character is from the treadmill, or nil if they
-- can't train right now (no character, dead, or sitting in a car).
local function distanceFrom(player: Player, treadmill: Treadmill): number?
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root and root:IsA("BasePart")) or humanoid.Health <= 0 or humanoid.SeatPart then
		return nil
	end
	return flatDistance(root.Position, treadmill.RunPoint.Position)
end

local function refreshDisplay(treadmill: Treadmill)
	local owner = Plots.getOwner(treadmill.PlotModel)
	local level = if owner then PlayerData.getUpgradeLevel(owner, "Treadmill") else 1
	local trainer = if owner then trainers[owner] else nil
	local running = trainer ~= nil and trainer.Treadmill == treadmill
	local ownerId = if owner then owner.UserId else 0
	local state = string.format("%d|%d|%s", ownerId, level, tostring(running))
	if treadmill.Shown == state then
		return
	end
	treadmill.Shown = state

	local model = treadmill.Model
	model:SetAttribute("OwnerUserId", ownerId)
	model:SetAttribute("Level", level)
	model:SetAttribute("Running", running)
	local color = Config.treadmillColor(level)
	for _, part in treadmill.Accents do
		part.Color = color
	end

	local rate = Config.treadmillText(level)
	if treadmill.LevelLabel then
		treadmill.LevelLabel.Text = if owner then string.format("LV %d\n⚡ %s", level, rate) else "EMPTY"
	end
	if treadmill.OwnerLabel then
		treadmill.OwnerLabel.Text = if owner then string.upper(owner.DisplayName) .. "'S TREADMILL" else "TREADMILL"
	end

	local prompt = treadmill.Prompt
	if prompt then
		local upgrade = Config.UpgradesById.Treadmill
		local maxed = level >= #upgrade.Costs
		prompt:SetAttribute("OwnerUserId", ownerId)
		prompt.ObjectText = string.format("Treadmill Lv %d (%s)", level, rate)
		prompt.ActionText = if maxed then "Maxed out!" else "Upgrade: " .. Format.money(upgrade.Costs[level + 1])
		prompt.Enabled = owner ~= nil and not maxed
	end
end

local function setTrainer(player: Player, trainer: Trainer?)
	if trainer then
		trainers[player] = trainer
	else
		trainers[player] = nil
	end
	player:SetAttribute("Training", trainer ~= nil)
	local treadmill = if trainer then trainer.Treadmill else treadmillFor(player)
	if treadmill then
		refreshDisplay(treadmill)
	end
end

-- Starts AFK training on the player's own treadmill. Returns (ok, reason).
function Treadmills.start(player: Player): (boolean, string)
	if trainers[player] then
		return true, ""
	end
	if not PlayerData.get(player) then
		return false, "Still loading your data..."
	end
	local treadmill = treadmillFor(player)
	if not treadmill then
		return false, "You need a warehouse to use a treadmill."
	end
	local distance = distanceFrom(player, treadmill)
	if not distance then
		return false, "You can't train right now."
	end
	if distance > START_DISTANCE then
		return false, "Walk onto your treadmill to train!"
	end
	setTrainer(player, { Treadmill = treadmill, AwayTime = 0 })
	return true, ""
end

-- Stops training (no-op if the player isn't training).
function Treadmills.stop(player: Player, reason: string?)
	local trainer = trainers[player]
	if not trainer then
		return
	end
	setTrainer(player, nil)
	if reason and player.Parent then
		Notify.send(player, reason, "info")
	end
end

function Treadmills.isTraining(player: Player): boolean
	return trainers[player] ~= nil
end

local function train(player: Player, trainer: Trainer, dt: number)
	local treadmill = trainer.Treadmill
	if treadmillFor(player) ~= treadmill then
		Treadmills.stop(player)
		return
	end
	local distance = distanceFrom(player, treadmill)
	if not distance then
		Treadmills.stop(player)
		return
	end
	if distance > Config.Treadmill.MaxDistance then
		trainer.AwayTime += dt
		if trainer.AwayTime >= AWAY_GRACE then
			Treadmills.stop(player, "🏃 You left your treadmill, so training stopped.")
		end
		return
	end
	trainer.AwayTime = 0

	-- The treadmill's level sets how fast it trains: "amount every interval",
	-- doubling the amount and halving the interval with every level.
	local level = PlayerData.getUpgradeLevel(player, "Treadmill")
	-- PlayerData replicates the displayed Speed whenever a whole point lands.
	-- The local treadmill controller turns that delta into a floating +Speed
	-- number over the runner, rather than filling a persistent HUD bar.
	PlayerData.addSpeed(player, Config.treadmillRate(level) * dt)
end

local function loop()
	local last = os.clock()
	while true do
		task.wait(TICK)
		local now = os.clock()
		local dt = math.min(now - last, 1) -- don't hand out a burst of speed after a server hitch
		last = now
		for player, trainer in trainers do
			if player.Parent then
				train(player, trainer, dt)
			else
				trainers[player] = nil
			end
		end
		-- Also picks up new owners, upgrades and players leaving.
		for _, treadmill in treadmills do
			refreshDisplay(treadmill)
		end
	end
end

local function addUpgradePrompt(treadmill: Treadmill, console: BasePart)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "UpgradeTreadmillPrompt"
	prompt.ActionText = "Upgrade"
	prompt.ObjectText = "Treadmill"
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false
	prompt:SetAttribute("OwnerUserId", 0)
	prompt.Parent = console
	prompt.Triggered:Connect(function(player: Player)
		if Plots.getOwner(treadmill.PlotModel) ~= player then
			Notify.send(player, "That's not your treadmill! Yours is outside your own warehouse.", "error")
			return
		end
		local ok, message = Economy.purchase(player, "Treadmill")
		Notify.send(player, message, if ok then "success" else "error")
		refreshDisplay(treadmill)
	end)
	treadmill.Prompt = prompt
end

local function onRequest(player: Player, action: any): { Ok: boolean, Message: string }
	if action == "Start" then
		local ok, message = Treadmills.start(player)
		return { Ok = ok, Message = message }
	elseif action == "Stop" then
		Treadmills.stop(player)
		return { Ok = true, Message = "" }
	end
	return { Ok = false, Message = "Invalid request." }
end

function Treadmills.onPlayerRemoving(player: Player)
	trainers[player] = nil
end

function Treadmills.init()
	local map = Workspace:WaitForChild("Map")
	local folder = map:WaitForChild("Warehouses")
	for _, plotModel in folder:GetChildren() do
		local model = plotModel:FindFirstChild("Treadmill")
		if not (plotModel:IsA("Model") and model and model:IsA("Model")) then
			continue
		end
		local runPoint = model:FindFirstChild("RunPoint")
		if not (runPoint and runPoint:IsA("BasePart")) then
			warn("[Treadmills] Skipping " .. model:GetFullName() .. " (it has no RunPoint part)")
			continue
		end
		local accents: { BasePart } = {}
		for _, descendant in model:GetDescendants() do
			if descendant:IsA("BasePart") and string.sub(descendant.Name, 1, 6) == "Accent" then
				table.insert(accents, descendant)
			end
		end
		local treadmill: Treadmill = {
			Model = model,
			PlotModel = plotModel,
			RunPoint = runPoint,
			Accents = accents,
			Prompt = nil,
			LevelLabel = findTextLabel(model, "TreadmillText"),
			OwnerLabel = findTextLabel(model, "TreadmillOwnerText"),
			Shown = "",
		}
		local console = model:FindFirstChild("Console")
		if console and console:IsA("BasePart") then
			addUpgradePrompt(treadmill, console)
		end
		table.insert(treadmills, treadmill)
		refreshDisplay(treadmill)
	end
	ReplicatedStorage.Remotes.Treadmill.OnServerInvoke = onRequest
	task.spawn(loop)
end

return Treadmills
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX00000000000000000000000000002641">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX00000000000000000000000000002642">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="LocalScript" referent="RBX00000000000000000000000000002643">
				<Properties>
					<string name="Name">Client</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Steal an Item — client entry point
	==================================
	Builds the HUD, shop, loot index, storage, sell point and effects, follows the
	day/night clock and listens to the server's remotes.
]]

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Make sure the shared modules and remotes have replicated before using them.
local sharedFolder = ReplicatedStorage:WaitForChild("Shared")
for _, name in { "Config", "Items", "ItemModels", "Format" } do
	sharedFolder:WaitForChild(name)
end
local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
for _, name in { "Notify", "Busted", "Purchase", "Treadmill", "Storage", "Sell", "Rebirth" } do
	remotesFolder:WaitForChild(name)
end

local BustedScreen = require(script.BustedScreen)
local DayNight = require(script.DayNight)
local Hud = require(script.Hud)
local LootIndex = require(script.LootIndex)
local Notifications = require(script.Notifications)
local Rebirth = require(script.Rebirth)
local SellPoint = require(script.SellPoint)
local Shop = require(script.Shop)
local Storage = require(script.Storage)
local TreadmillController = require(script.TreadmillController)
local UI = require(script.UI)
local WorldEffects = require(script.WorldEffects)

local Remotes = ReplicatedStorage.Remotes

local screen = Instance.new("ScreenGui")
screen.Name = "StealAnItemHUD"
screen.ResetOnSpawn = false
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screen.Parent = playerGui

-- Scale the whole HUD down on small screens (phones) and up a bit on big ones.
local function updateScale()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	UI.setScale(math.clamp(math.min(viewport.X / 1280, viewport.Y / 760), 0.55, 1.1))
end

Notifications.init(screen)
DayNight.init()
Shop.init(screen)
LootIndex.init(screen)
Rebirth.init(screen)
Storage.init(screen)
SellPoint.init(screen)

-- Only one window is ever open at a time.
local function closeWindows(keep: string?)
	if keep ~= "Shop" then
		Shop.close()
	end
	if keep ~= "Index" then
		LootIndex.close()
	end
	if keep ~= "Storage" then
		Storage.close()
	end
	if keep ~= "Sell" then
		SellPoint.close()
	end
	if keep ~= "Rebirth" then
		Rebirth.close()
	end
end

local hud = Hud.init(screen, {
	OnShop = function()
		closeWindows("Shop")
		Shop.toggle()
	end,
	OnStorage = function()
		closeWindows("Storage")
		Storage.toggle()
	end,
	OnIndex = function()
		closeWindows("Index")
		LootIndex.toggle()
	end,
})
LootIndex.attachBadge(hud.IndexButton)
BustedScreen.init(screen)
TreadmillController.init(screen)
WorldEffects.init()

updateScale()
local camera = Workspace.CurrentCamera
if camera then
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
end

Remotes.Notify.OnClientEvent:Connect(function(text: string, kind: string?)
	Notifications.show(text, kind)
end)

Remotes.Busted.OnClientEvent:Connect(function(lostCount: number, lostValue: number, houseName: string, catcher: string?, outcome: string?)
	closeWindows()
	BustedScreen.show(lostCount, lostValue, houseName, catcher, outcome)
end)

-- Prompts in the world open their window: the market stall's shop counter, the
-- trader's counter opposite it, the rebirth shrine, and the shelf prompts in your
-- own warehouse.
ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, who: Player)
	if who ~= player then
		return
	end
	if prompt.Name == "OpenShopPrompt" then
		closeWindows("Shop")
		Shop.open()
	elseif prompt.Name == "OpenSellPrompt" then
		closeWindows("Sell")
		SellPoint.open()
	elseif prompt.Name == "OpenRebirthPrompt" then
		closeWindows("Rebirth")
		Rebirth.open()
	elseif prompt.Name == "ShelfPrompt" then
		closeWindows("Storage")
		Storage.open()
	end
end)

-- Hide owner-only prompts (selling from someone else's shelves, upgrading their treadmill)
-- for everyone else.
ProximityPromptService.PromptShown:Connect(function(prompt: ProximityPrompt)
	local ownerUserId = prompt:GetAttribute("OwnerUserId")
	if ownerUserId ~= nil and ownerUserId ~= player.UserId then
		prompt.Enabled = false
	end
end)
]]></ProtectedString>
				</Properties>
				<Item class="ModuleScript" referent="RBX00000000000000000000000000002644">
					<Properties>
						<string name="Name">BustedScreen</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	BustedScreen
	------------
	The big red "BUSTED!" flash when a house guard (cat, dog or drone) catches
	you — a full-screen red vignette and a scale-popping headline while the
	server ragdolls the thief and returns recovered loot to its source spot.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage.Shared.Format)
local UI = require(script.Parent.UI)

local BustedScreen = {}

local overlay: Frame? = nil
local title: TextLabel? = nil
local subtitle: TextLabel? = nil
local titleScale: UIScale? = nil
local bars: { Frame } = {}
local showId = 0

function BustedScreen.init(screen: ScreenGui)
	local frame: Frame = UI.new("Frame", {
		Name = "Busted",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(170, 0, 20),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 50,
		Parent = screen,
	}, {
		-- Vignette feel: darker at the edges, hottest behind the headline.
		UI.gradient(Color3.fromRGB(60, 0, 10), Color3.new(1, 1, 1)),
	})
	-- Police-light bars sliding in from the top and bottom.
	local topBar: Frame = UI.new("Frame", {
		Name = "TopBar",
		BackgroundColor3 = Color3.fromRGB(120, 0, 14),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0.16, 0),
		ZIndex = 50,
		Parent = frame,
	})
	local bottomBar: Frame = UI.new("Frame", {
		Name = "BottomBar",
		BackgroundColor3 = Color3.fromRGB(120, 0, 14),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0.16, 0),
		ZIndex = 50,
		Parent = frame,
	})
	bars = { topBar, bottomBar }
	title = UI.new("TextLabel", {
		Name = "Title",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromScale(0.8, 0.2),
		Font = UI.Theme.TitleFont,
		Text = "BUSTED!",
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
		TextStrokeTransparency = 0,
		TextStrokeColor3 = Color3.fromRGB(80, 0, 0),
		ZIndex = 51,
		Parent = frame,
	})
	local scale = Instance.new("UIScale")
	scale.Name = "Pop"
	scale.Parent = title
	titleScale = scale
	subtitle = UI.new("TextLabel", {
		Name = "Subtitle",
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.5, 0.54),
		Size = UDim2.fromScale(0.8, 0.07),
		Font = UI.Theme.BoldFont,
		Text = "",
		TextColor3 = Color3.fromRGB(255, 230, 230),
		TextScaled = true,
		TextStrokeTransparency = 0.4,
		ZIndex = 51,
		Parent = frame,
	})
	overlay = frame
end

function BustedScreen.show(lostCount: number, lostValue: number, houseName: string, catcher: string?, outcome: string?)
	local frame, titleLabel, subtitleLabel = overlay, title, subtitle
	if not frame or not titleLabel or not subtitleLabel then
		return
	end
	showId += 1
	local myId = showId

	local who = catcher or "A guard"
	local location = if outcome == "door" then "threw you through the front door" elseif outcome == "road" then "caught you on the road" else "caught you"
	local recovery = if outcome == "door" then "and returned them to their original loot spots." else "and is returning them to their original loot spots."
	subtitleLabel.Text = if lostCount > 0
		then string.format(
			"%s at the %s %s! It recovered %d item%s worth %s %s",
			who,
			houseName,
			location,
			lostCount,
			if lostCount == 1 then "" else "s",
			Format.money(lostValue),
			recovery
		)
		else string.format("%s at the %s %s! Good thing your bag was empty.", who, houseName, location)

	frame.Visible = true
	frame.BackgroundTransparency = 0.25
	for _, bar in bars do
		bar.BackgroundTransparency = 0.55
	end
	titleLabel.TextTransparency = 0
	subtitleLabel.TextTransparency = 0
	titleLabel.Rotation = -8
	UI.tween(titleLabel, 0.35, { Rotation = 0 }, Enum.EasingStyle.Back)
	-- The headline pops in from small to oversized, then settles.
	local pop = titleScale
	if pop then
		pop.Scale = 0.5
		UI.tween(pop, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	UI.playSound(UI.Sounds.Busted, 0.8, 1)

	task.delay(2.6, function()
		if showId ~= myId then
			return
		end
		UI.tween(frame, 0.5, { BackgroundTransparency = 1 })
		for _, bar in bars do
			UI.tween(bar, 0.5, { BackgroundTransparency = 1 })
		end
		UI.tween(titleLabel, 0.5, { TextTransparency = 1 })
		UI.tween(subtitleLabel, 0.5, { TextTransparency = 1 })
		task.wait(0.55)
		if showId == myId then
			frame.Visible = false
		end
	end)
end

return BustedScreen
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000000000000000000000000002645">
					<Properties>
						<string name="Name">DayNight</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	DayNight (client)
	-----------------
	Follows the server's heist clock (Workspace attributes Daytime and
	PhaseEndsAt, see server/DayNight) and fades the sky between the night and
	daytime lighting presets in Config.DayNight. The clock always moves
	forward, so night -> day is a sunrise and day -> night is a sunset.
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)

local DayNight = {}

type Snapshot = Config.LightingPreset

local fadeFrom: Snapshot? = nil
local fadeTo: Snapshot = Config.DayNight.Night
local fadeStartedAt = 0
local fading = false

function DayNight.isDaytime(): boolean
	return Workspace:GetAttribute("Daytime") == true
end

-- Seconds until the current phase (night or daytime) ends.
function DayNight.getTimeLeft(): number
	local endsAt = Workspace:GetAttribute("PhaseEndsAt")
	if type(endsAt) ~= "number" then
		return 0
	end
	return math.max(0, endsAt - Workspace:GetServerTimeNow())
end

local function atmosphere(): Atmosphere?
	return Lighting:FindFirstChildOfClass("Atmosphere")
end

local function capture(): Snapshot
	local current = atmosphere()
	return {
		ClockTime = Lighting.ClockTime,
		Brightness = Lighting.Brightness,
		ExposureCompensation = Lighting.ExposureCompensation,
		Ambient = Lighting.Ambient,
		OutdoorAmbient = Lighting.OutdoorAmbient,
		FogColor = Lighting.FogColor,
		AtmosphereColor = if current then current.Color else fadeTo.AtmosphereColor,
		AtmosphereDecay = if current then current.Decay else fadeTo.AtmosphereDecay,
	}
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

local function apply(from: Snapshot, to: Snapshot, t: number)
	-- Always move the clock forward so the sun rises in the east and sets in the west.
	local forward = (to.ClockTime - from.ClockTime) % 24
	Lighting.ClockTime = (from.ClockTime + forward * t) % 24
	Lighting.Brightness = lerp(from.Brightness, to.Brightness, t)
	Lighting.ExposureCompensation = lerp(from.ExposureCompensation, to.ExposureCompensation, t)
	Lighting.Ambient = from.Ambient:Lerp(to.Ambient, t)
	Lighting.OutdoorAmbient = from.OutdoorAmbient:Lerp(to.OutdoorAmbient, t)
	Lighting.FogColor = from.FogColor:Lerp(to.FogColor, t)
	local current = atmosphere()
	if current then
		current.Color = from.AtmosphereColor:Lerp(to.AtmosphereColor, t)
		current.Decay = from.AtmosphereDecay:Lerp(to.AtmosphereDecay, t)
	end
end

local function targetPreset(): Snapshot
	return if DayNight.isDaytime() then Config.DayNight.Day else Config.DayNight.Night
end

local function startFade()
	fadeFrom = capture()
	fadeTo = targetPreset()
	fadeStartedAt = os.clock()
	fading = true
end

function DayNight.init()
	-- Jump straight to the current phase when you join, then fade on every change.
	fadeTo = targetPreset()
	apply(capture(), fadeTo, 1)
	Workspace:GetAttributeChangedSignal("Daytime"):Connect(startFade)
	RunService.RenderStepped:Connect(function()
		local from = fadeFrom
		if not fading or not from then
			return
		end
		local t = math.clamp((os.clock() - fadeStartedAt) / Config.DayNight.FadeTime, 0, 1)
		local eased = t * t * (3 - 2 * t)
		apply(from, fadeTo, eased)
		if t >= 1 then
			fading = false
		end
	end)
end

return DayNight
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000000000000000000000000002646">
					<Properties>
						<string name="Name">Hud</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Hud
	---
	The always-on-screen interface, restyled after the current top games
	(Steal a Brainrot / Pet Simulator 99 / Adopt Me!):
	  * A gold gradient cash pill with an icon disc (top left), income chip
	    under it, and a glass stats panel (bag / warehouse / speed)
	  * A right-edge rail of big square gradient buttons (SHOP / STORAGE /
	    LOOT INDEX) with pop-bounce presses, the way Pet Sim 99 does it
	  * A cinematic night/daytime clock (top centre) with a phase progress bar
	  * A pulsing full-width alarm banner while a house's guards chase you
	  * A pill objective hint telling new players what to do next
	  * Floating treadmill gain numbers above the runner (owned by TreadmillController)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local DayNight = require(script.Parent.DayNight)
local UI = require(script.Parent.UI)

local Hud = {}

local player = Players.LocalPlayer
local Theme = UI.Theme

export type Callbacks = {
	OnShop: () -> (),
	OnStorage: () -> (),
	OnIndex: () -> (),
}

export type Elements = {
	IndexButton: TextButton,
}

local function getNumber(name: string, default: number): number
	local value = player:GetAttribute(name)
	return if type(value) == "number" then value else default
end

local function getString(name: string): string
	local value = player:GetAttribute(name)
	return if type(value) == "string" then value else ""
end

-- A stat row with a glossy icon chip on the left (the Pet Sim look).
local function makeStatRow(parent: Instance, y: number, icon: string, title: string, color: Color3, colorDark: Color3): TextLabel
	local row: Frame = UI.new("Frame", {
		Name = title,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, y),
		Size = UDim2.new(1, -20, 0, 32),
		Parent = parent,
	})
	UI.iconChip(row, icon, color, colorDark, 28, UDim2.fromOffset(0, 2))
	UI.new("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(38, 0),
		Size = UDim2.new(0.55, -38, 1, 0),
		Font = Theme.BoldFont,
		Text = title,
		TextColor3 = Theme.Text,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 3,
		Parent = row,
	})
	local value: TextLabel = UI.new("TextLabel", {
		Name = "Value",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.45, 0, 1, 0),
		Font = Theme.TitleFont,
		Text = "0",
		TextColor3 = Theme.Text,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 3,
		Parent = row,
	})
	return value
end

-- A big square gradient button for the right-edge rail. The background carries
-- the accent colour; the label is crisp white Fredoka with NO text stroke (a
-- partial dark stroke muddies small text on a saturated background).
local function makeRailButton(parent: Instance, order: number, text: string, color: Color3, colorDark: Color3, callback: () -> ()): TextButton
	local button: TextButton = UI.new("TextButton", {
		Name = text,
		AutoButtonColor = true,
		BackgroundColor3 = color,
		Size = UDim2.fromOffset(132, 58),
		LayoutOrder = order,
		Font = Theme.TitleFont,
		Text = text,
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 19,
		ZIndex = 3,
		Parent = parent,
	}, {
		UI.corner(16),
		UI.stroke(Color3.new(1, 1, 1), 2.5, 0.25),
		UI.gloss(),
	})
	UI.bounce(button)
	button.Activated:Connect(function()
		UI.playSound(UI.Sounds.Click, 0.4, 1.4)
		callback()
	end)
	return button
end

function Hud.init(screen: ScreenGui, callbacks: Callbacks): Elements
	----------------------------------------------------------------------------
	-- Top-left cluster: cash pill + income chip + stats panel
	----------------------------------------------------------------------------
	local column: Frame = UI.new("Frame", {
		Name = "LeftColumn",
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.fromOffset(14, 14),
		Size = UDim2.fromOffset(260, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		UI.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		UI.scaled(),
	})

	----------------------------------------------------------------------------
	-- Cash pill (gold gradient — the Steal a Brainrot / Pet Sim counter)
	----------------------------------------------------------------------------
	local cashPanel: Frame = UI.new("Frame", {
		Name = "CashPanel",
		Size = UDim2.fromOffset(260, 76),
		BackgroundColor3 = Theme.Gold,
		LayoutOrder = 1,
		ZIndex = 2,
		Parent = column,
	}, {
		UI.shadow(18, 7),
		UI.corner(18),
		UI.stroke(Color3.new(1, 1, 1), 2.5, 0.2),
		UI.gradient(Theme.Gold, Theme.GoldDark),
	})
	UI.iconChip(cashPanel, "💰", Color3.new(1, 1, 1), Color3.fromRGB(255, 236, 180), 48, UDim2.fromOffset(12, 14))
	local cashLabel: TextLabel = UI.new("TextLabel", {
		Name = "Cash",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(72, 6),
		Size = UDim2.new(1, -82, 0, 40),
		Font = Theme.TitleFont,
		Text = "$0",
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 34,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextStrokeTransparency = 0.5,
		ZIndex = 3,
		Parent = cashPanel,
	})
	-- Income sits in its own little white chip under the cash (keeps the gold readable).
	local incomeChip: Frame = UI.new("Frame", {
		Name = "IncomeChip",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.3,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -10, 1, -8),
		Size = UDim2.fromOffset(0, 24),
		AutomaticSize = Enum.AutomaticSize.X,
		ZIndex = 4,
		Parent = cashPanel,
	}, {
		UI.corner(12),
		UI.new("UIPadding", {
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
		}),
	})
	local incomeLabel: TextLabel = UI.new("TextLabel", {
		Name = "Income",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Font = Theme.BoldFont,
		Text = "+$0 / sec",
		TextColor3 = Theme.GreenDark,
		TextSize = 16,
		ZIndex = 5,
		Parent = incomeChip,
	})

	----------------------------------------------------------------------------
	-- Stats panel (glass card with icon-chip rows; fixed height, manually placed
	-- rows — a UIListLayout would treat the Shadow frame as a list item)
	----------------------------------------------------------------------------
	local statsPanel: Frame = UI.new("Frame", {
		Name = "StatsPanel",
		Size = UDim2.fromOffset(260, 120),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.12,
		LayoutOrder = 2,
		ZIndex = 2,
		Parent = column,
	}, {
		UI.shadow(16, 5),
		UI.corner(16),
		UI.stroke(Theme.Stroke, 1.5, 0.15),
		UI.bodyGradient(),
	})
	local bagValue = makeStatRow(statsPanel, 10, "🎒", "Loot Bag", Theme.Orange, Theme.OrangeDark)
	local storageValue = makeStatRow(statsPanel, 46, "📦", "Warehouse", Theme.Blue, Theme.BlueDark)
	local speedValue = makeStatRow(statsPanel, 82, "👟", "Speed", Theme.Cyan, Theme.CyanDark)

	----------------------------------------------------------------------------
	-- Right-edge button rail (Pet Sim 99 style)
	----------------------------------------------------------------------------
	local rail: Frame = UI.new("Frame", {
		Name = "ButtonsRail",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(132, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		UI.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
		UI.scaled(),
	})
	makeRailButton(rail, 1, "🛒 SHOP", Theme.Orange, Theme.OrangeDark, callbacks.OnShop)
	makeRailButton(rail, 2, "📦 STORAGE", Theme.Green, Theme.GreenDark, callbacks.OnStorage)
	local indexButton = makeRailButton(rail, 3, "📖 LOOT INDEX", Theme.Purple, Theme.PurpleDark, callbacks.OnIndex)

	----------------------------------------------------------------------------
	-- Night / daytime clock (cinematic pill + phase progress bar)
	----------------------------------------------------------------------------
	local clock: Frame = UI.new("Frame", {
		Name = "Clock",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(330, 66),
		BackgroundColor3 = Theme.Night,
		BackgroundTransparency = 0.04,
		ZIndex = 2,
		Parent = screen,
	}, {
		UI.shadow(20, 5),
		UI.corner(20),
		UI.stroke(Color3.new(1, 1, 1), 2, 0.2),
		UI.gloss(),
		UI.scaled(),
	})
	local clockTitle: TextLabel = UI.new("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 4),
		Size = UDim2.new(1, 0, 0, 30),
		Font = Theme.TitleFont,
		Text = "",
		TextColor3 = Theme.Text,
		TextSize = 26,
		ZIndex = 3,
		Parent = clock,
	})
	local clockHint: TextLabel = UI.new("TextLabel", {
		Name = "Hint",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 34),
		Size = UDim2.new(1, 0, 0, 18),
		Font = Theme.BoldFont,
		Text = "",
		TextColor3 = Theme.SubText,
		TextSize = 14,
		ZIndex = 3,
		Parent = clock,
	})
	local clockBarBack: Frame = UI.new("Frame", {
		Name = "Progress",
		BackgroundColor3 = Color3.fromRGB(94, 90, 122),
		BackgroundTransparency = 0.75,
		Position = UDim2.fromOffset(14, 55),
		Size = UDim2.new(1, -28, 0, 6),
		ZIndex = 3,
		Parent = clock,
	}, { UI.corner(3) })
	local clockBarFill: Frame = UI.new("Frame", {
		Name = "Fill",
		BackgroundColor3 = Theme.Cyan,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 4,
		Parent = clockBarBack,
	}, { UI.corner(3) })

	----------------------------------------------------------------------------
	-- Alarm banner (99 Nights-style red alert, wide and pulsing)
	----------------------------------------------------------------------------
	local alarmBanner: Frame = UI.new("Frame", {
		Name = "AlarmBanner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 86),
		Size = UDim2.fromOffset(620, 70),
		BackgroundColor3 = Theme.Red,
		Visible = false,
		ZIndex = 4,
		Parent = screen,
	}, {
		UI.shadow(18, 7),
		UI.corner(18),
		UI.stroke(Color3.new(1, 1, 1), 3, 0.15),
		UI.gradient(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190)),
		UI.scaled(),
	})
	local alarmText: TextLabel = UI.new("TextLabel", {
		Name = "Text",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 0.62),
		Font = Theme.TitleFont,
		Text = "🚨 ALARM! RUN! 🚨",
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 30,
		TextStrokeTransparency = 0.45,
		ZIndex = 5,
		Parent = alarmBanner,
	})
	local alarmHint: TextLabel = UI.new("TextLabel", {
		Name = "Hint",
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0, 0.58),
		Size = UDim2.fromScale(1, 0.4),
		Font = Theme.BoldFont,
		Text = "Get off the property before the guards catch you!",
		TextColor3 = Color3.fromRGB(255, 228, 228),
		TextSize = 16,
		ZIndex = 5,
		Parent = alarmBanner,
	})

	----------------------------------------------------------------------------
	-- Objective hint (bottom pill)
	----------------------------------------------------------------------------
	local objective: TextLabel = UI.new("TextLabel", {
		Name = "Objective",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(660, 42),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.08,
		Font = Theme.BoldFont,
		Text = "",
		TextColor3 = Theme.Text,
		TextSize = 17,
		TextWrapped = true,
		ZIndex = 2,
		Parent = screen,
	}, {
		UI.corner(21),
		UI.stroke(Theme.Stroke, 1.5, 0.15),
		UI.padding(6),
		UI.scaled(),
	})


	----------------------------------------------------------------------------
	-- Updating
	----------------------------------------------------------------------------
	local displayedCash = getNumber("Cash", 0)
	local targetCash = displayedCash

	local function updateStats()
		incomeLabel.Text = "+" .. Format.money(getNumber("Income", 0)) .. " / sec"
		local carried, bag = getNumber("Carried", 0), getNumber("BagCapacity", 2)
		bagValue.Text = string.format("%d / %d", carried, bag)
		bagValue.TextColor3 = if carried >= bag then Theme.Red else Theme.Text
		local stored, storage = getNumber("StoredCount", 0), getNumber("StorageCapacity", 10)
		storageValue.Text = string.format("%d / %d", stored, storage)
		storageValue.TextColor3 = if stored >= storage then Theme.Orange else Theme.Text
		-- The server's display stat is always five times the physical WalkSpeed.
		speedValue.Text = Format.commas(getNumber("Speed", Config.speedStatForPoints(getNumber("SpeedPoints", 0))))
	end

	local function updateObjective()
		local carried, bag = getNumber("Carried", 0), getNumber("BagCapacity", 2)
		local text: string
		if getString("AlarmHouse") ~= "" then
			text = "🚨 Alarm! Run back up the street — defenders chase you to the yard mouth."
		elseif player:GetAttribute("DataLoaded") ~= true then
			text = "Loading your hideout..."
		elseif player:GetAttribute("Training") == true then
			text = "🏃 Training! You can go AFK, you'll keep getting faster. Press ESCAPE to hop off."
		elseif carried >= bag then
			text = "🎒 Bag full! Drop the loot on your warehouse's green DEPOSIT pad."
		elseif carried > 0 then
			text = "💰 Bring your loot to the green DEPOSIT pad in your warehouse (or keep stealing!)"
		elseif DayNight.isDaytime() then
			text = "☀️ Daytime: the owners are home and every house is locked. Upgrade or train until dark!"
		elseif getNumber("StoredCount", 0) == 0 then
			text = "🏠 Run down the street to a house, pick the lock and steal something!"
		else
			text = "🦝 Houses get harder down the street. Train on your treadmill to outrun the faster defenders!"
		end
		objective.Text = text
	end

	local function updateAlarm()
		local house = getString("AlarmHouse")
		alarmBanner.Visible = house ~= ""
		if house ~= "" then
			alarmText.Text = "🚨 ALARM AT THE " .. string.upper(house) .. "! 🚨"
			local guard = getString("AlarmGuard")
			alarmHint.Text = string.format("Get off the property before %s catch%s you!", if guard ~= "" then guard else "the guards", if guard ~= "" and string.sub(guard, -1) ~= "s" then "es" else "")
		end
	end

	for _, name in { "Income", "Carried", "BagCapacity", "StoredCount", "StorageCapacity", "WalkSpeed", "Speed" } do
		player:GetAttributeChangedSignal(name):Connect(function()
			updateStats()
			updateObjective()
		end)
	end
	player:GetAttributeChangedSignal("AlarmHouse"):Connect(function()
		updateAlarm()
		updateObjective()
	end)
	player:GetAttributeChangedSignal("DataLoaded"):Connect(updateObjective)
	local shownSeconds = -1
	local function updateClock(force: boolean?)
		local daytime = DayNight.isDaytime()
		local seconds = math.ceil(DayNight.getTimeLeft())
		if seconds == shownSeconds and not force then
			return
		end
		shownSeconds = seconds
		local countdown = string.format("%d:%02d", seconds // 60, seconds % 60)
		if daytime then
			clockTitle.Text = "☀️ DAYTIME · " .. countdown
			clockHint.Text = "Houses closed · restocking loot"
		else
			clockTitle.Text = "🌙 NIGHT · " .. countdown
			clockHint.Text = "Houses open · loot restocks at sunrise"
		end
		clock.BackgroundColor3 = if daytime then Theme.Day else Theme.Night
		-- Phase progress: how much of the night / daytime is still to come.
		local length = if daytime then Config.DayNight.DayLength else Config.DayNight.NightLength
		clockBarFill.Size = UDim2.fromScale(math.clamp(seconds / length, 0, 1), 1)
		clockBarFill.BackgroundColor3 = if daytime then Theme.GoldDark else Theme.CyanDark
	end
	Workspace:GetAttributeChangedSignal("Daytime"):Connect(function()
		updateClock(true)
		updateObjective()
	end)
	player:GetAttributeChangedSignal("Training"):Connect(updateObjective)
	player:GetAttributeChangedSignal("Cash"):Connect(function()
		targetCash = getNumber("Cash", 0)
	end)

	updateStats()
	updateObjective()
	updateAlarm()
	updateClock(true)

	local pulse = 0
	RunService.RenderStepped:Connect(function(dt: number)
		-- Count the cash up/down smoothly (and pop the panel when it moves).
		if displayedCash ~= targetCash then
			local difference = targetCash - displayedCash
			if math.abs(difference) < 1 then
				displayedCash = targetCash
			else
				displayedCash += difference * math.min(dt * 10, 1)
			end
			cashLabel.Text = Format.money(math.floor(displayedCash + 0.5))
		end
		-- Pulse the alarm banner.
		if alarmBanner.Visible then
			pulse += dt * 8
			alarmBanner.BackgroundColor3 = Color3.fromRGB(150 + math.floor(70 * math.abs(math.sin(pulse))), 20, 30)
		end
		updateClock()
	end)
	cashLabel.Text = Format.money(displayedCash)
	return { IndexButton = indexButton }
end

return Hud
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000000000000000000000000002647">
					<Properties>
						<string name="Name">LootIndex</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	LootIndex
	---------
	The collection book: every stealable item in the game, grouped by the house
	it comes from, each with a little 3D picture. Items you haven't stolen yet
	are black silhouettes marked "???"; steal one and it's unlocked for good
	(the server saves the list and mirrors it in the "Discovered" attribute).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Items = require(ReplicatedStorage.Shared.Items)
local UI = require(script.Parent.UI)

local LootIndex = {}

local player = Players.LocalPlayer
local Theme = UI.Theme

type Card = {
	Item: Items.ItemDef,
	Frame: Frame,
	Picture: ViewportFrame,
	Name: TextLabel,
	Info: TextLabel,
	Unlocked: boolean,
}

type Section = {
	House: Config.HouseInfo,
	Count: TextLabel,
	Cards: { Card },
}

local window: Frame? = nil
local windowScale: UIScale? = nil
local progressLabel: TextLabel? = nil
local progressFill: Frame? = nil
local badge: TextLabel? = nil
local sections: { Section } = {}
local isOpen = false
local seen: { [string]: boolean } = {} -- discoveries already shown to the player
local unseen = 0
local baselined = false -- true once the saved collection has arrived (it never counts as "new")

local LOCKED_TINT = Color3.fromRGB(0, 0, 0)

-- Tier title colours darkened for the light theme (the bright candy tier
-- colours wash out on cream cards).
local TIER_INK = {
	Color3.fromRGB(52, 152, 62),
	Color3.fromRGB(32, 116, 215),
	Color3.fromRGB(142, 76, 215),
	Color3.fromRGB(205, 128, 22),
}

local function getDiscovered(): { [string]: boolean }
	local result: { [string]: boolean } = {}
	local value = player:GetAttribute("Discovered")
	if type(value) == "string" then
		for itemId in string.gmatch(value, "[^,]+") do
			result[itemId] = true
		end
	end
	return result
end

local function updateBadge()
	local label = badge
	if label then
		label.Visible = unseen > 0
		label.Text = if unseen > 9 then "9+" else tostring(unseen)
	end
end

local function makePicture(parent: Instance, def: Items.ItemDef): ViewportFrame
	-- UI.itemPicture strips the rarity aura, so the card shows the item itself.
	local picture = UI.itemPicture(parent, def.Id, UDim2.new(1, -10, 0, 92), UDim2.fromOffset(5, 5))
	picture.ImageColor3 = LOCKED_TINT
	return picture
end

local function setCard(card: Card, unlocked: boolean)
	card.Unlocked = unlocked
	local def = card.Item
	card.Picture.ImageColor3 = if unlocked then Color3.new(1, 1, 1) else LOCKED_TINT
	card.Picture.ImageTransparency = if unlocked then 0 else 0.15
	card.Name.Text = if unlocked then def.DisplayName else "???"
	card.Name.TextColor3 = if unlocked then Theme.Text else Theme.SubText
	card.Info.Text = if unlocked then string.format("%s · %s", def.Rarity, Format.money(def.Value)) else def.Rarity .. " · ???"
end

local function makeCard(parent: Instance, order: number, def: Items.ItemDef): Card
	local frame: Frame = UI.new("Frame", {
		Name = def.Id,
		BackgroundColor3 = Theme.Panel,
		LayoutOrder = order,
		ZIndex = 4,
		Parent = parent,
	}, {
		UI.corner(12),
		UI.gradient(Theme.PanelTop, Theme.Panel),
		UI.stroke(UI.rarityInk(def.Rarity), 2, 0.3),
	})
	local picture = makePicture(frame, def)
	local name: TextLabel = UI.new("TextLabel", {
		Name = "ItemName",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(4, 100),
		Size = UDim2.new(1, -8, 0, 22),
		Font = Theme.TitleFont,
		Text = "???",
		TextColor3 = Theme.Text,
		TextScaled = true,
		ZIndex = 5,
		Parent = frame,
	})
	local info: TextLabel = UI.new("TextLabel", {
		Name = "Info",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(4, 123),
		Size = UDim2.new(1, -8, 0, 18),
		Font = Theme.BoldFont,
		Text = def.Rarity,
		TextColor3 = UI.rarityInk(def.Rarity),
		TextSize = 14,
		ZIndex = 5,
		Parent = frame,
	})
	local card: Card = { Item = def, Frame = frame, Picture = picture, Name = name, Info = info, Unlocked = false }
	setCard(card, false)
	return card
end

local function makeSection(parent: Instance, order: number, house: Config.HouseInfo): Section
	local tier = Config.HouseTiers[house.Tier]
	local guard = Config.Guards[house.Guard]
	local guardCount = house.GuardCount or 1
	local frame: Frame = UI.new("Frame", {
		Name = house.Id,
		BackgroundColor3 = Theme.PanelLight,
		BackgroundTransparency = 0.15,
		Size = UDim2.new(1, -10, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order,
		ZIndex = 3,
		Parent = parent,
	}, {
		UI.corner(16),
		UI.cardGradient(),
		UI.stroke(tier.Color, 1.5, 0.65),
		UI.padding(12),
		UI.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local header: Frame = UI.new("Frame", {
		Name = "Header",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 48),
		LayoutOrder = 1,
		Parent = frame,
	})
	UI.iconChip(header, guard.Icon, tier.Color, Theme.Panel, 44, UDim2.fromOffset(0, 2))
	UI.new("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(56, 0),
		Size = UDim2.new(1, -160, 0, 26),
		Font = Theme.TitleFont,
		Text = string.upper(house.DisplayName),
		TextColor3 = TIER_INK[house.Tier] or Theme.Text,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 4,
		Parent = header,
	})
	UI.new("TextLabel", {
		Name = "Guard",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(56, 26),
		Size = UDim2.new(1, -160, 0, 18),
		Font = Theme.BodyFont,
		Text = string.format(
			"%s%s %s · guarded by %s · %s speed",
			string.rep("★", tier.Stars),
			string.rep("☆", 4 - tier.Stars),
			tier.Name,
			if guardCount == 1 then "a " .. guard.DisplayName else string.format("%d %ss", guardCount, guard.DisplayName),
			Format.commas(guard.Speed)
		),
		TextColor3 = Theme.SubText,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 4,
		Parent = header,
	})
	local count: TextLabel = UI.new("TextLabel", {
		Name = "Count",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 8),
		Size = UDim2.fromOffset(96, 30),
		Font = Theme.TitleFont,
		Text = "0/0",
		TextColor3 = Theme.Gold,
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 4,
		Parent = header,
	})
	local grid: Frame = UI.new("Frame", {
		Name = "Items",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
		Parent = frame,
	}, {
		UI.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(126, 146),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local cards: { Card } = {}
	for index, def in Items.forHouse(house.Id) do
		table.insert(cards, makeCard(grid, index, def))
	end
	return { House = house, Count = count, Cards = cards }
end

local function refresh()
	local discovered = getDiscovered()
	local found, total = 0, 0
	for _, section in sections do
		local houseFound = 0
		for _, card in section.Cards do
			local unlocked = discovered[card.Item.Id] == true
			if unlocked ~= card.Unlocked then
				setCard(card, unlocked)
			end
			if unlocked then
				houseFound += 1
			end
		end
		found += houseFound
		total += #section.Cards
		local complete = houseFound == #section.Cards and houseFound > 0
		section.Count.Text = string.format("%s%d/%d", if complete then "✅ " else "", houseFound, #section.Cards)
		section.Count.TextColor3 = if complete then Theme.GreenDark else Theme.GoldDark
	end
	local label, fill = progressLabel, progressFill
	if label and fill then
		label.Text = string.format("%d / %d found", found, total)
		fill.Size = UDim2.fromScale(if total > 0 then found / total else 0, 1)
	end
	-- Count discoveries the player hasn't looked at yet (for the HUD badge).
	if isOpen or not baselined then
		seen = discovered
		unseen = 0
	else
		unseen = 0
		for itemId in discovered do
			if not seen[itemId] then
				unseen += 1
			end
		end
	end
	updateBadge()
end

function LootIndex.init(screen: ScreenGui)
	local scale = UI.scaled()
	local frame: Frame = UI.new("Frame", {
		Name = "LootIndex",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(780, 600),
		BackgroundColor3 = Theme.Panel,
		Visible = false,
		ZIndex = 2,
		Parent = screen,
	}, {
		UI.shadow(20, 10),
		UI.corner(20),
		UI.stroke(Theme.Purple, 2.5, 0.2),
		UI.bodyGradient(),
		scale,
	})
	window = frame
	windowScale = scale

	UI.titleBar(frame, "📖", "LOOT INDEX", Theme.Purple, Theme.PurpleDark, 58)
	local close = UI.closeButton(frame, UDim2.new(1, -10, 0, 8))
	close.Activated:Connect(function()
		LootIndex.close()
	end)
	progressLabel = UI.new("TextLabel", {
		Name = "Progress",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(24, 66),
		Size = UDim2.fromOffset(240, 26),
		Font = Theme.TitleFont,
		Text = "",
		TextColor3 = Theme.GoldDark,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 4,
		Parent = frame,
	})
	local bar: Frame = UI.new("Frame", {
		Name = "ProgressBar",
		Position = UDim2.fromOffset(24, 94),
		Size = UDim2.new(1, -48, 0, 10),
		BackgroundColor3 = Color3.fromRGB(94, 90, 122),
		BackgroundTransparency = 0.78,
		ZIndex = 4,
		Parent = frame,
	}, { UI.corner(5), UI.stroke(Color3.new(1, 1, 1), 1, 0.88) })
	progressFill = UI.new("Frame", {
		Name = "Fill",
		BackgroundColor3 = Theme.Purple,
		Size = UDim2.fromScale(0, 1),
		ZIndex = 5,
		Parent = bar,
	}, { UI.corner(5), UI.gradient(Theme.Purple, Theme.PurpleDark) })

	local list: ScrollingFrame = UI.new("ScrollingFrame", {
		Name = "List",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(16, 114),
		Size = UDim2.new(1, -28, 1, -166),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Theme.Purple,
		ZIndex = 3,
		Parent = frame,
	}, {
		UI.new("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for order, house in Config.Houses do
		table.insert(sections, makeSection(list, order, house))
	end

	local tipBar: Frame = UI.new("Frame", {
		Name = "TipBar",
		BackgroundColor3 = Theme.PanelTop,
		BackgroundTransparency = 0.35,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -10),
		Size = UDim2.new(1, -32, 0, 36),
		ZIndex = 3,
		Parent = frame,
	}, { UI.corner(12), UI.stroke(Color3.new(1, 1, 1), 1, 0.88) })
	UI.new("TextLabel", {
		Name = "Tip",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Font = Theme.BodyFont,
		Text = "💡 Every house has its own loot. Steal an item once to unlock it here forever. Rarer items show up less often!",
		TextColor3 = Theme.SubText,
		TextSize = 14,
		TextWrapped = true,
		ZIndex = 4,
		Parent = tipBar,
	})

	-- Everything you'd discovered before this session counts as already seen. The server
	-- sets "Discovered" before "DataLoaded", so take the baseline once your data has loaded.
	local function takeBaseline()
		if not baselined and player:GetAttribute("DataLoaded") == true then
			seen = getDiscovered()
			baselined = true
		end
	end
	takeBaseline()
	player:GetAttributeChangedSignal("DataLoaded"):Connect(function()
		takeBaseline()
		refresh()
	end)
	player:GetAttributeChangedSignal("Discovered"):Connect(refresh)
	refresh()
end

-- Adds the little "NEW" counter to the HUD button that opens the index.
function LootIndex.attachBadge(button: GuiButton)
	badge = UI.new("TextLabel", {
		Name = "NewBadge",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -4, 0, 4),
		Size = UDim2.fromOffset(30, 30),
		BackgroundColor3 = Theme.Red,
		Font = Theme.TitleFont,
		Text = "",
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 17,

		Visible = false,
		ZIndex = 6,
		Parent = button,
	}, {
		UI.corner(15),
		UI.gloss(),
		UI.stroke(Color3.new(1, 1, 1), 2, 0.1),
	})
	updateBadge()
end

function LootIndex.open()
	local frame, scale = window, windowScale
	if not frame or not scale or isOpen then
		return
	end
	isOpen = true
	refresh()
	frame.Visible = true
	local target = UI.CurrentScale
	scale.Scale = target * 0.8
	UI.tween(scale, 0.18, { Scale = target }, Enum.EasingStyle.Back)
end

function LootIndex.close()
	local frame = window
	if not frame or not isOpen then
		return
	end
	isOpen = false
	frame.Visible = false
end

function LootIndex.toggle()
	if isOpen then
		LootIndex.close()
	else
		LootIndex.open()
	end
end

function LootIndex.isOpen(): boolean
	return isOpen
end

return LootIndex
]]></ProtectedString>
					</Properties>
