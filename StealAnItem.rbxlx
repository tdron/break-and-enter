		Costs = { 0, 150, 600, 2000, 6000, 18000, 55000, 160000 },
		Format = "%d items",
	},
	{
		Id = "Engine",
		DisplayName = "Getaway Engine",
		Icon = "🏎️",
		Description = "A faster getaway car. New paint job included!",
		Values = { 45, 55, 66, 78, 92, 110 },
		Costs = { 0, 400, 1600, 6000, 22000, 80000 },
