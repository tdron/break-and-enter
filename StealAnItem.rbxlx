--------------------------------------------------------------------------------
-- Building
--------------------------------------------------------------------------------
local function newPart(model: Model, name: string, shape: Enum.PartType, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = shape
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.Parent = model
	return part
end

local function rotation(degrees: Vector3?): CFrame
	if not degrees then
		return CFrame.identity
	end
	return CFrame.Angles(math.rad(degrees.X), math.rad(degrees.Y), math.rad(degrees.Z))
end

local function statusBubble(root: BasePart, height: number): TextLabel
	local gui = Instance.new("BillboardGui")
	gui.Name = "Status"
	gui.Size = UDim2.fromOffset(60, 60)
	gui.StudsOffsetWorldSpace = Vector3.new(0, height, 0)
	gui.MaxDistance = 70
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Parent = root
	local label = Instance.new("TextLabel")
	label.Name = "Icon"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.Text = ""
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.4
	label.Parent = gui
	return label
end

local function weldAll(model: Model, root: BasePart, pinned: { [BasePart]: boolean })
	for _, part in model:GetChildren() do
		if part:IsA("BasePart") and part ~= root and not pinned[part] then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = part
			weld.Parent = part
		end
	end
end

local function weldTo(part0: BasePart, part1: BasePart)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = part0
	weld.Part1 = part1
	weld.Parent = part1
end

--------------------------------------------------------------------------------
-- Physics body and legs
--------------------------------------------------------------------------------
-- The box a defender bumps into the world with: as wide and as tall as it looks, but *round* in
-- plan (the same box whichever way it is facing). Height is never capped - the box is centred on
-- the model, so shortening it would lift the defender off the floor.
--
-- Round in plan matters: a body that is 3 studs long and 1 wide sweeps its length through a wall
-- every time it turns on the spot next to one, and a defender pinned inside a wall cannot be
-- trusted to walk anywhere. Round, turning on the spot changes nothing, so a defender can always
-- turn wherever it can stand - which is what lets it line itself up with a doorway.
local COLLIDER_CAP = V(4.0, math.huge, 4.0)
local COLLIDER_CAPS: { [string]: Vector3 } = {
	Cat = V(1.1, math.huge, 1.1),
	Dog = V(2.8, math.huge, 2.8),
	Human = V(2.4, math.huge, 2.4),
	Wizard = V(2.6, math.huge, 2.6),
	Beast = V(3.6, math.huge, 3.6), -- the tail is 13 studs long; the body it walks with is not
	Robot = V(2.6, math.huge, 2.6),
	Vehicle = V(4.0, math.huge, 4.0),
	Drone = V(2.4, math.huge, 2.4),
}

local function colliderSize(bounds: Vector3, kind: string): Vector3
	local cap = COLLIDER_CAPS[kind] or COLLIDER_CAP
	local width = math.clamp(bounds.X, 0.4, cap.X)
	return V(width, bounds.Y, math.clamp(width, 0.4, cap.Z))
end

-- Only the kinds that walk are given legs. A drone hovers, the security bots run on tracks and
-- the cars on wheels: animating any of those would look plain wrong, so they keep rigid parts.
local WALKING = { Cat = true, Dog = true, Human = true, Wizard = true, Beast = true }
local GROUND_MARGIN = 0.09 -- how close to the floor a part has to sit to count as a foot
-- One paw or foot per stride, opposite legs half a stride apart (so a four-legged trot is
-- front-left/back-right together, which is what a real dog does).
local TROT_PHASES = { 0, 0.5, 0.5, 0 }

type LimbCluster = {
	X: number,
	Z: number,
	Top: number,
	Index: number, -- the part the joint drives: the leg itself, not the paw
	Members: { number },
}

-- Finds the limbs by looking for the parts that stand on the floor and grouping them into feet.
-- Returns nothing when the parts under the body are not legs (they are one blob, like the
-- wizard's robe, or there is only one of them) - those defenders just keep sliding.
local function findLimbs(home: CFrame, root: BasePart, look: Look, visual: { BasePart }, size: Vector3, kind: string): { WalkCycle.Limb }
	local limbs: { WalkCycle.Limb } = {}
	if not WALKING[kind] then
		return limbs
	end
	local ground = math.huge
	for _, spec in look.Parts do
		ground = math.min(ground, spec.Position.Y - spec.Size.Y / 2)
	end
	local radius = math.clamp(size.X * 0.22, 0.32, 0.9)
	local clusters: { LimbCluster } = {}
	for index, spec in look.Parts do
		if spec.Position.Y - spec.Size.Y / 2 <= ground + GROUND_MARGIN then
			local cluster: LimbCluster? = nil
			local closest = radius
			for _, other in clusters do
				local gap = (Vector3.new(other.X, 0, other.Z) - Vector3.new(spec.Position.X, 0, spec.Position.Z)).Magnitude
				if gap <= closest then
					cluster, closest = other, gap
				end
			end
			if cluster then
				local count = #cluster.Members
				cluster.X = (cluster.X * count + spec.Position.X) / (count + 1)
				cluster.Z = (cluster.Z * count + spec.Position.Z) / (count + 1)
				table.insert(cluster.Members, index)
				if spec.Position.Y + spec.Size.Y / 2 > cluster.Top then
					cluster.Top = spec.Position.Y + spec.Size.Y / 2
					cluster.Index = index
				end
			else
				table.insert(clusters, {
					X = spec.Position.X,
					Z = spec.Position.Z,
					Top = spec.Position.Y + spec.Size.Y / 2,
					Index = index,
					Members = { index },
				})
			end
		end
	end
	if #clusters < 2 then
		return limbs
	end
	table.sort(clusters, function(a, b)
		if a.Z ~= b.Z then
			return a.Z < b.Z -- front legs (-Z) first
		end
		return a.X < b.X
	end)
	for order, cluster in clusters do
		local part = visual[cluster.Index]
		if part then
			-- The pivot: the hip the leg swings around, turning with the guard.
			local pivot = home * CFrame.new(Vector3.new(cluster.X, cluster.Top, cluster.Z))
			local joint = Instance.new("Motor6D")
			joint.Name = "Leg" .. order
			joint.Part0 = root
			joint.Part1 = part
			joint.C0 = root.CFrame:Inverse() * pivot
			joint.C1 = part.CFrame:Inverse() * pivot
			joint.Parent = part
			local phase = TROT_PHASES[order] or ((order - 1) % 2) * 0.5
			table.insert(limbs, { Joint = joint, Base = joint.C0, Phase = phase })
			for _, member in cluster.Members do
				local other = visual[member]
				if other and other ~= part then
					weldTo(part, other)
				end
			end
		end
	end
	return limbs
end

local function buildDrone(home: CFrame): GuardModel
	local model = Instance.new("Model")
	model.Name = "Guard"
	local body = newPart(model, "Body", BALL, V(2.2, 2.2, 2.2), home, C(46, 48, 56), M.Metal)
	body.Massless = false
	body.CanCollide = true -- the rotors are decoration, but the drone itself is solid
	local eye = newPart(model, "Eye", BALL, V(0.95, 0.95, 0.95), home * CFrame.new(0, 0, -0.75), C(70, 200, 255), M.Neon)
	newPart(model, "Ring", CYLINDER, V(0.25, 3.7, 3.7), home * CFrame.new(0, 0.35, 0) * CFrame.Angles(0, 0, math.rad(90)), C(28, 28, 32), M.Metal)
	for _, offset in { V(1.3, 0.75, 1.3), V(-1.3, 0.75, 1.3), V(1.3, 0.75, -1.3), V(-1.3, 0.75, -1.3) } do
		newPart(model, "Rotor", CYLINDER, V(0.12, 1.4, 1.4), home * CFrame.new(offset) * CFrame.Angles(0, 0, math.rad(90)), C(205, 205, 215), M.SmoothPlastic)
	end
	newPart(model, "Antenna", BLOCK, V(0.12, 0.9, 0.12), home * CFrame.new(0, 1.35, 0.35), C(28, 28, 32), M.Metal)

	local light = Instance.new("PointLight")
	light.Color = Guards.AlertEyeColor
	light.Range = 14
	light.Brightness = 3
	light.Enabled = false
	light.Parent = eye

	weldAll(model, body, {})
	model.PrimaryPart = body
	return {
		Model = model,
		Root = body,
		Eyes = { eye },
		Limbs = {}, -- it hovers; there is nothing to step with
		Light = light,
		Status = statusBubble(body, 2.4),
		RootHeight = 0,
		Size = V(2.2, 2.2, 2.2),
		Kind = "Drone",
	}
end

-- What a guard looks like (nil for drones, which are built separately).
function Guards.getLook(guardId: string): Look?
	return looks[guardId]
end

-- Builds a guard model (unanchored, welded, non-colliding) at `home`.
-- For animals `home` is the ground point they stand on; for drones it's where they hover.
function Guards.build(guardId: string, home: CFrame): GuardModel
	local info = Config.Guards[guardId]
	local look = looks[guardId]
	if not info or info.Kind == "Drone" or not look then
		return buildDrone(home)
	end

	local model = Instance.new("Model")
	model.Name = "Guard"

	-- Bounds of the visible parts (ignoring rotation; close enough for the physics root).
	local minCorner = V(math.huge, math.huge, math.huge)
	local maxCorner = -minCorner
	for _, spec in look.Parts do
		local half = spec.Size / 2
		minCorner = minCorner:Min(spec.Position - half)
		maxCorner = maxCorner:Max(spec.Position + half)
	end
	local size = maxCorner - minCorner
	local center = (maxCorner + minCorner) / 2

	-- The body it is allowed to be stopped by: a box over the visible parts, on the floor.
	local root = newPart(model, "Root", BLOCK, colliderSize(size, info.Kind), home * CFrame.new(center), C(255, 255, 255), M.SmoothPlastic)
	root.Transparency = 1
	root.CanCollide = true
	root.Massless = false

	local visual: { BasePart } = {}
	for index, spec in look.Parts do
		visual[index] = newPart(model, "Piece" .. index, spec.Shape, spec.Size, home * CFrame.new(spec.Position) * rotation(spec.Rotation), spec.Color, spec.Material or M.SmoothPlastic)
	end
	local eyes: { BasePart } = {}
	for _, position in look.Eyes do
		local eye = newPart(model, "Eye", BALL, V(look.EyeSize, look.EyeSize, look.EyeSize), home * CFrame.new(position), look.EyeColor, if look.EyeGlows then M.Neon else M.SmoothPlastic)
		table.insert(eyes, eye)
	end

	local limbs = findLimbs(home, root, look, visual, size, info.Kind)
	local pinned: { [BasePart]: boolean } = {}
	for _, limb in limbs do
		local part = limb.Joint.Part1
		if part then
			pinned[part] = true
		end
	end
	weldAll(model, root, pinned)
	model.PrimaryPart = root
	return {
		Model = model,
		Root = root,
		Eyes = eyes,
		Limbs = limbs,
		Light = nil,
		Status = statusBubble(root, size.Y / 2 + 1.4),
		RootHeight = center.Y,
		Size = size,
		Kind = info.Kind,
	}
end

-- Calm / alert eye colours.
function Guards.setAlert(guard: GuardModel, guardId: string, alert: boolean)
	local look = looks[guardId]
	for _, eye in guard.Eyes do
		if alert then
			eye.Color = Guards.AlertEyeColor
			eye.Material = M.Neon
		elseif look then
			eye.Color = look.EyeColor
			eye.Material = if look.EyeGlows then M.Neon else M.SmoothPlastic
		else
			eye.Color = C(70, 200, 255)
			eye.Material = M.Neon
		end
	end
	local light = guard.Light
	if light then
		light.Enabled = alert
	end
end

return Guards
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000000000000000000000000262A">
				<Properties>
					<string name="Name">ItemModels</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	ItemModels
	----------
	Turns an item definition from the Items module into a real Model made of
	anchored, non-colliding parts. The model's pivot is the bottom-centre of
	the item, so `model:PivotTo(surfaceCFrame)` sets it neatly on a surface.
]]

local Config = require(script.Parent.Config)
local Items = require(script.Parent.Items)

local ItemModels = {}

local SHAPES: { [string]: Enum.PartType } = {
	Block = Enum.PartType.Block,
	Ball = Enum.PartType.Ball,
	Cylinder = Enum.PartType.Cylinder,
	Wedge = Enum.PartType.Wedge,
}

-- Rotates a vector exactly like CFrame.Angles(rx, ry, rz) would (degrees in, R = Rx * Ry * Rz).
local function rotate(v: Vector3, degrees: Vector3): Vector3
	local rx, ry, rz = math.rad(degrees.X), math.rad(degrees.Y), math.rad(degrees.Z)
	local x, y, z = v.X, v.Y, v.Z
	x, y = x * math.cos(rz) - y * math.sin(rz), x * math.sin(rz) + y * math.cos(rz)
	x, z = x * math.cos(ry) + z * math.sin(ry), -x * math.sin(ry) + z * math.cos(ry)
	y, z = y * math.cos(rx) - z * math.sin(rx), y * math.sin(rx) + z * math.cos(rx)
	return Vector3.new(x, y, z)
end

-- Bounding box (size, centre) of an item model, taking part rotations into account.
function ItemModels.getBounds(itemId: string): (Vector3, Vector3)
	local def = Items.get(itemId)
	if not def then
		return Vector3.one, Vector3.new(0, 0.5, 0)
	end
	local minCorner = Vector3.new(math.huge, math.huge, math.huge)
	local maxCorner = -minCorner
	for _, spec in def.Parts do
		local half = spec.Size / 2
		local rotation = spec.Rotation
		for _, sx in { -1, 1 } do
			for _, sy in { -1, 1 } do
				for _, sz in { -1, 1 } do
					local corner = Vector3.new(half.X * sx, half.Y * sy, half.Z * sz)
					local point = spec.Position + (if rotation then rotate(corner, rotation) else corner)
					minCorner = minCorner:Min(point)
					maxCorner = maxCorner:Max(point)
				end
			end
		end
	end
	return maxCorner - minCorner, (maxCorner + minCorner) / 2
end

function ItemModels.build(itemId: string): Model?
	local def = Items.get(itemId)
	if not def then
		warn("[ItemModels] Unknown item id: " .. tostring(itemId))
		return nil
	end

	local model = Instance.new("Model")
	model.Name = def.Id
	model:SetAttribute("ItemId", def.Id)
	if Items.hasAura(itemId) then
		model:SetAttribute("Glowing", true)
	end

	-- An invisible root part the size of the item. Prompts and labels attach to it.
	local size, center = ItemModels.getBounds(itemId)
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(math.max(size.X, 1), math.max(size.Y, 1), math.max(size.Z, 1))
	root.CFrame = CFrame.new(center)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.CastShadow = false
	root.Parent = model
	model.PrimaryPart = root

	for index, spec in def.Parts do
		local part = Instance.new("Part")
		part.Name = "Piece" .. index
		part.Shape = SHAPES[spec.Shape] or Enum.PartType.Block
		part.Size = spec.Size
		local cf = CFrame.new(spec.Position)
		local rotation = spec.Rotation
		if rotation then
			cf *= CFrame.Angles(math.rad(rotation.X), math.rad(rotation.Y), math.rad(rotation.Z))
		end
		part.CFrame = cf
		part.Color = spec.Color
		part.Material = spec.Material or Enum.Material.SmoothPlastic
		part.Transparency = spec.Transparency or 0
		part.Reflectance = spec.Reflectance or 0
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		local light = spec.Light
		if light then
			local pointLight = Instance.new("PointLight")
			pointLight.Color = light.Color
			pointLight.Range = light.Range
			pointLight.Brightness = light.Brightness
			pointLight.Parent = part
		end
		part.Parent = model
	end

	-- Put the pivot at the bottom-centre (the model was built around the origin).
	model.WorldPivot = CFrame.new()

	-- Rare loot glows: an Epic or Legendary item gets a shell plus an outline in its rarity's colour.
	local rarity = Items.getRarity(itemId)
	if rarity and rarity.Order >= Config.Aura.MinOrder then
		local aura = Config.Aura
		local widest = math.max(size.X, size.Y, size.Z)
		local shell = Instance.new("Part")
		shell.Name = "Aura"
		shell.Shape = Enum.PartType.Ball
		shell.Size = Vector3.one * math.max(widest * aura.Size, 1.6)
		shell.CFrame = CFrame.new(center)
		shell.Color = rarity.Color
		shell.Material = Enum.Material.Neon
		shell.Transparency = aura.Transparency
		shell.Anchored = true
		shell.CanCollide = false
		shell.CanQuery = false
		shell.CanTouch = false
		shell.CastShadow = false
		shell:SetAttribute("AuraSize", shell.Size.X) -- the client pulses around this size
		shell.Parent = model
		-- The client animates the shell's glow (see client/WorldEffects.luau).
		local glow = Instance.new("Highlight")
		glow.Name = "AuraGlow"
		glow.FillColor = rarity.Color
		glow.FillTransparency = aura.FillTransparency
		glow.OutlineColor = rarity.Color
		glow.OutlineTransparency = aura.OutlineTransparency
		glow.DepthMode = Enum.HighlightDepthMode.Occluded
		glow.Parent = model
	end
	return model
end

return ItemModels
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000000000000000000000000262B">
				<Properties>
					<string name="Name">Items</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Items
	-----
	Every stealable item: its name, value, rarity, the one house it can be found
	in, and a little 3D model made from plain parts (no uploaded meshes needed).
	Every house has its own set of loot, so collecting them all (see the Loot
	Index in the HUD) means robbing every house on the street.

	Model conventions:
	  * The origin (0, 0, 0) is the bottom-centre of the item, so it sits on a surface.
	  * The item's "front" faces -Z (Roblox's LookVector direction).
	  * Keep items under ~4 studs tall and ~3.6 studs wide so they fit on shelves.
]]

local Config = require(script.Parent.Config)

export type LightSpec = { Color: Color3, Range: number, Brightness: number }

export type PartSpec = {
	Shape: string, -- "Block" | "Ball" | "Cylinder" | "Wedge"
	Size: Vector3,
	Position: Vector3,
	Rotation: Vector3?, -- degrees
	Color: Color3,
	Material: Enum.Material?,
	Transparency: number?,
	Reflectance: number?,
	Light: LightSpec?,
}

export type ItemDef = {
	Id: string,
	DisplayName: string,
	House: string, -- Config.Houses id of the only house this item spawns in
	Tier: number, -- that house's tier
	Value: number,
	Rarity: string,
	Parts: { PartSpec },
}

export type Rarity = { Color: Color3, Weight: number, Order: number }

type Extra = {
	Rotation: Vector3?,
	Transparency: number?,
	Reflectance: number?,
	Light: LightSpec?,
}

local Items = {}

Items.Rarities = {
	Common = { Color = Color3.fromRGB(225, 225, 225), Weight = 60, Order = 1 },
	Rare = { Color = Color3.fromRGB(80, 170, 255), Weight = 28, Order = 2 },
	Epic = { Color = Color3.fromRGB(190, 100, 255), Weight = 10, Order = 3 },
	Legendary = { Color = Color3.fromRGB(255, 190, 40), Weight = 2, Order = 4 },
} :: { [string]: Rarity }

local V = Vector3.new
local C = Color3.fromRGB
local M = Enum.Material

local VERTICAL = V(0, 0, 90) -- rotate a cylinder so its axis points up
local FACING = V(0, 90, 0) -- rotate a cylinder so its axis points forward

local GOLD = C(255, 196, 54)
local SILVER = C(200, 202, 208)
local BLACK = C(28, 28, 32)
local WHITE = C(240, 240, 240)

local function P(
	shape: string,
	size: Vector3,
	position: Vector3,
	color: Color3,
	material: Enum.Material?,
	extra: Extra?
): PartSpec
	local spec: PartSpec = {
		Shape = shape,
		Size = size,
		Position = position,
		Color = color,
		Material = material,
	}
	if extra then
		spec.Rotation = extra.Rotation
		spec.Transparency = extra.Transparency
		spec.Reflectance = extra.Reflectance
		spec.Light = extra.Light
	end
	return spec
end

local list: { ItemDef } = {}
local byId: { [string]: ItemDef } = {}

local function define(id: string, displayName: string, houseId: string, value: number, rarity: string, parts: { PartSpec })
	assert(Items.Rarities[rarity], "Unknown rarity " .. rarity)
	assert(byId[id] == nil, "Duplicate item id " .. id)
	local house = Config.getHouse(houseId)
	assert(house, "Unknown house " .. houseId .. " for item " .. id)
	local def: ItemDef = {
		Id = id,
		DisplayName = displayName,
		House = houseId,
		Tier = house.Tier,
		Value = value,
		Rarity = rarity,
		Parts = parts,
	}
	table.insert(list, def)
	byId[id] = def
end

