				<Item class="ModuleScript" referent="RBX00000000000000000000000000001E3F">
					<Properties>
						<string name="Name">SellPoint</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	SellPoint
	---------
	The trader's window at the yard's market stall. Opens from the stall's prompt
	and lists everything you could sell right now:

	  * the loot in your bag,
	  * plus the loot in your car's trunk while the car is parked at the stall.

	One button sells a single item, the big button sells the lot. The server
	(Market.luau) decides what really gets sold and pays the cash.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Items = require(ReplicatedStorage.Shared.Items)
local Notifications = require(script.Parent.Notifications)
local UI = require(script.Parent.UI)

local SellRemote = ReplicatedStorage.Remotes.Sell

local SellPoint = {}

local player = Players.LocalPlayer
local Theme = UI.Theme

local ROW_HEIGHT = 84
local CARD_COLOR = Color3.fromRGB(36, 40, 62)

local window: Frame? = nil
local windowScale: UIScale? = nil
local list: ScrollingFrame? = nil
local cashLabel: TextLabel? = nil
local totalLabel: TextLabel? = nil
local empty: TextLabel? = nil
local trunkHint: TextLabel? = nil
local sellAll: TextButton? = nil
local isOpen = false
local busy = false
local lastSignature: string? = nil

local function number(name: string, default: number): number
	local value = player:GetAttribute(name)
	return if type(value) == "number" then value else default
end

local function request(action: string?, itemId: string?, source: string?): { [string]: any }?
	if busy then
		return nil
	end
	busy = true
	local ok, result = pcall(function()
		if action then
			return SellRemote:InvokeServer(action, itemId, source)
		end
		return SellRemote:InvokeServer("List")
	end)
	busy = false
	if not ok or type(result) ~= "table" then
		Notifications.show("The trader is busy, try again!", "error")
		return nil
	end
	return result
end

local function totalValue(sales: { any }): number
	local total = 0
	for _, sale in sales do
		total += Items.getSellValue(tostring(sale.ItemId))
	end
	return total
end

local function makeRow(parent: Instance, order: number, sale: any): Frame?
	local def = Items.get(tostring(sale.ItemId))
	if not def then
		return nil
	end
	local rarity = Items.getRarity(def.Id)
	local color = if rarity then rarity.Color else Theme.SubText
	local fromTrunk = sale.Source == "Trunk"
	local frame: Frame = UI.new("Frame", {
		Name = def.Id .. order,
		BackgroundColor3 = CARD_COLOR,
		Size = UDim2.new(1, -8, 0, ROW_HEIGHT),
		LayoutOrder = order,
		Parent = parent,
	}, {
		UI.corner(12),
		UI.stroke(color, 2, 0.55),
	})
	UI.itemPicture(frame, def.Id, UDim2.fromOffset(72, 72), UDim2.fromOffset(6, 6))
	UI.new("TextLabel", {
		Name = "ItemName",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(88, 8),
		Size = UDim2.new(1, -300, 0, 24),
		Font = Theme.TitleFont,
		Text = def.DisplayName,
		TextColor3 = Theme.Text,
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	UI.new("TextLabel", {
		Name = "Info",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(88, 32),
		Size = UDim2.new(1, -300, 0, 20),
		Font = Theme.BoldFont,
		Text = string.format("%s · %s%s", def.Rarity, if fromTrunk then "🚗 trunk · " else "🎒 bag · ",
			Format.money(Items.getSellValue(def.Id))),
		TextColor3 = color,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	UI.new("TextLabel", {
		Name = "House",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(88, 52),
		Size = UDim2.new(1, -300, 0, 18),
		Font = Theme.BodyFont,
		Text = "from " .. def.House,
		TextColor3 = Theme.SubText,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})

	local button: TextButton = UI.new("TextButton", {
		Name = "Sell",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(120, 46),
		BackgroundColor3 = Theme.Green,
		Font = Theme.BoldFont,
		Text = "💰 " .. Format.money(Items.getSellValue(def.Id)),
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 18,
		Parent = frame,
	}, { UI.corner(10) })
	UI.bounce(button)
	button.Activated:Connect(function()
		local result = request("Sell", def.Id, tostring(sale.Source))
		if not result then
			return
		end
		UI.playSound(if result.Ok then UI.Sounds.Purchase else UI.Sounds.Error, 0.5, if result.Ok then 1.7 else 1)
		Notifications.show(tostring(result.Message), if result.Ok then "money" else "error")
		SellPoint.refresh()
	end)
	return frame
end

function SellPoint.refresh()
	local frame, container = window, list
	if not frame or not container then
		return
	end
	local result = request(nil)
	local sales: { any } = if result then result.Sales or {} else {}
	local bagCount, trunkCount = 0, 0
	local parts = {}
	for index, sale in sales do
		if sale.Source == "Trunk" then
			trunkCount += 1
		else
			bagCount += 1
		end
		table.insert(parts, string.format("%d:%s:%s", index, tostring(sale.ItemId), tostring(sale.Source)))
	end
	-- The car can drive up at any time, so only touch the rows when the list really changed.
	table.insert(parts, if result and result.TrunkReady == true then "trunk-ready" else "trunk-away")
	local signature = table.concat(parts, "|")
	if signature ~= lastSignature then
		lastSignature = signature
		container:ClearAllChildren()
		for index, sale in sales do
			makeRow(container, index, sale)
		end
	end

	local total = totalValue(sales)
	if cashLabel then
		cashLabel.Text = "💰 " .. Format.money(number("Cash", 0))
	end
	if totalLabel then
		if #sales == 0 then
			totalLabel.Text = "Nothing to sell — steal something first!"
		else
			totalLabel.Text = string.format("%d item%s in your bag%s · worth %s", bagCount,
				if bagCount == 1 then "" else "s",
				if trunkCount > 0 then string.format(" and %d in the trunk", trunkCount) else "", Format.money(total))
		end
	end
	if sellAll then
		sellAll.Text = if total > 0 then "🤑 SELL EVERYTHING (" .. Format.money(total) .. ")" else "🤑 NOTHING TO SELL"
		sellAll.BackgroundColor3 = if total > 0 then Theme.Green else Color3.fromRGB(70, 74, 96)
		sellAll.AutoButtonColor = total > 0
	end
	if empty then
		empty.Visible = #sales == 0
	end
	local hint = trunkHint
	if hint then
		local ready = result ~= nil and result.TrunkReady == true
		hint.Text = if ready
			then "🚗 Your car is at the stall — its trunk is included."
			else string.format("🚗 Park your car within %d studs of the stall to sell the trunk too.",
				Config.Market.TrunkRange)
		hint.TextColor3 = if ready then Theme.Green else Theme.SubText
	end
end

function SellPoint.init(screen: ScreenGui)
	local scale = UI.scaled()
	local frame: Frame = UI.new("Frame", {
		Name = "SellPoint",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(700, 540),
		BackgroundColor3 = Theme.Panel,
		Visible = false,
		Parent = screen,
	}, {
		UI.corner(18),
		UI.stroke(Theme.Green, 3, 0.1),
		scale,
	})
	window = frame
	windowScale = scale

	UI.new("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(20, 8),
		Size = UDim2.new(1, -90, 0, 44),
		Font = Theme.TitleFont,
		Text = "💰 SELL POINT",
		TextColor3 = Theme.Green,
		TextSize = 32,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	local cash: TextLabel = UI.new("TextLabel", {
		Name = "Cash",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -74, 0, 16),
		Size = UDim2.fromOffset(240, 32),
		Font = Theme.TitleFont,
		Text = "",
		TextColor3 = Theme.Green,
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = frame,
	})
	cashLabel = cash
	local close: TextButton = UI.new("TextButton", {
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 14),
		Size = UDim2.fromOffset(44, 44),
		BackgroundColor3 = Theme.Red,
		Font = Theme.TitleFont,
		Text = "X",
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 26,
		Parent = frame,
	}, { UI.corner(10) })
	UI.bounce(close)
	close.Activated:Connect(function()
		SellPoint.close()
	end)

	local baggage: TextLabel = UI.new("TextLabel", {
		Name = "Total",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(22, 50),
		Size = UDim2.new(1, -44, 0, 24),
		Font = Theme.BoldFont,
		Text = "",
		TextColor3 = Theme.SubText,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	totalLabel = baggage

	local scrolling: ScrollingFrame = UI.new("ScrollingFrame", {
		Name = "List",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(16, 80),
		Size = UDim2.new(1, -28, 1, -186),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Theme.Green,
		Parent = frame,
	}, {
		UI.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	list = scrolling

	local hint: TextLabel = UI.new("TextLabel", {
		Name = "TrunkHint",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(22, 396),
		Size = UDim2.new(1, -44, 0, 22),
		Font = Theme.BodyFont,
		Text = "",
		TextColor3 = Theme.SubText,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	trunkHint = hint
	UI.new("TextLabel", {
		Name = "Empty",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(22, 120),
		Size = UDim2.new(1, -44, 0, 40),
		Font = Theme.BodyFont,
		Text = "Your bag is empty. Rob a house, then bring the loot here for cash on the spot.",
		TextColor3 = Theme.SubText,
		TextSize = 18,
		TextWrapped = true,
		Parent = frame,
	})
	empty = frame:FindFirstChild("Empty") :: TextLabel

	local all: TextButton = UI.new("TextButton", {
		Name = "SellAll",
		Position = UDim2.new(0, 20, 1, -74),
		Size = UDim2.new(1, -40, 0, 52),
		BackgroundColor3 = Theme.Green,
		Font = Theme.TitleFont,
		Text = "🤑 SELL EVERYTHING",
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 24,
		Parent = frame,
	}, { UI.corner(12) })
	sellAll = all
	UI.bounce(all)
	all.Activated:Connect(function()
		local result = request("All")
		if not result then
			return
		end
		UI.playSound(if result.Ok then UI.Sounds.Purchase else UI.Sounds.Error, 0.6, if result.Ok then 1.9 else 1)
		Notifications.show(tostring(result.Message), if result.Ok then "money" else "error")
		SellPoint.refresh()
	end)

	player:GetAttributeChangedSignal("Cash"):Connect(function()
		if cash then
			cash.Text = "💰 " .. Format.money(number("Cash", 0))
		end
	end)
	for _, name in { "Carried", "TrunkCount" } do
		player:GetAttributeChangedSignal(name):Connect(function()
			task.spawn(SellPoint.refresh)
		end)
	end
	cash.Text = "💰 " .. Format.money(number("Cash", 0))
end

function SellPoint.open()
	local frame, scale = window, windowScale
	if not frame or not scale or isOpen then
		return
	end
	isOpen = true
	lastSignature = nil
	frame.Visible = true
	local target = UI.CurrentScale
	scale.Scale = target * 0.8
	UI.tween(scale, 0.18, { Scale = target }, Enum.EasingStyle.Back)
	task.spawn(SellPoint.refresh)
	task.spawn(function()
		-- Keep an eye out for the car pulling up at the stall while the trader's window is open.
		while isOpen do
			task.wait(1)
			if isOpen then
				SellPoint.refresh()
			end
		end
	end)
end

function SellPoint.close()
	local frame = window
	if not frame or not isOpen then
		return
	end
	isOpen = false
	frame.Visible = false
end

function SellPoint.toggle()
	if isOpen then
		SellPoint.close()
	else
		SellPoint.open()
	end
end

function SellPoint.isOpen(): boolean
	return isOpen
end

return SellPoint
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000000000000000000000000001E40">
					<Properties>
						<string name="Name">Shop</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Shop
	----
	The upgrade shop window. Opens from the HUD button or the shop counter in
	the hub. Purchases are validated by the server (Economy module).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Notifications = require(script.Parent.Notifications)
local UI = require(script.Parent.UI)

local PurchaseRemote = ReplicatedStorage.Remotes.Purchase

local Shop = {}

local player = Players.LocalPlayer
local Theme = UI.Theme

type Card = {
	Upgrade: Config.Upgrade,
	Level: TextLabel,
	Value: TextLabel,
	Button: TextButton,
}

local window: Frame? = nil
local windowScale: UIScale? = nil
local cards: { Card } = {}
local busy = false
local isOpen = false

local function getNumber(name: string, default: number): number
	local value = player:GetAttribute(name)
	return if type(value) == "number" then value else default
end

local function describeValue(upgrade: Config.Upgrade, level: number): string
	return Config.describeUpgrade(upgrade.Id, level)
end

local function refreshCard(card: Card)
	local upgrade = card.Upgrade
	local level = getNumber("Level_" .. upgrade.Id, 1)
	local maxLevel = #upgrade.Values
	local cash = getNumber("Cash", 0)

	card.Level.Text = string.format("LV %d / %d", level, maxLevel)
	if level >= maxLevel then
		card.Value.Text = describeValue(upgrade, level) .. "  (max)"
	else
		card.Value.Text = string.format(
			"%s  ➜  %s",
			describeValue(upgrade, level),
			describeValue(upgrade, level + 1)
		)
	end

	if level >= maxLevel then
		card.Button.Text = "MAXED"
		card.Button.BackgroundColor3 = Color3.fromRGB(70, 74, 96)
		card.Button.AutoButtonColor = false
	else
		local cost = upgrade.Costs[level + 1]
		card.Button.Text = Format.money(cost)
		card.Button.AutoButtonColor = true
		card.Button.BackgroundColor3 = if cash >= cost then Theme.Green else Color3.fromRGB(150, 60, 60)
	end
end

local function refreshAll()
	for _, card in cards do
		refreshCard(card)
	end
end

local function buy(upgrade: Config.Upgrade)
	if busy then
		return
	end
	busy = true
	local ok, result = pcall(function()
		return PurchaseRemote:InvokeServer(upgrade.Id)
	end)
	busy = false
	if ok and type(result) == "table" then
		local success = result.Ok == true
		Notifications.show(tostring(result.Message), if success then "success" else "error")
		if success then
			UI.playSound(UI.Sounds.Purchase, 0.6, 1.8)
		end
	else
		Notifications.show("The shop is busy, try again!", "error")
	end
	refreshAll()
end

local function makeCard(parent: Instance, order: number, upgrade: Config.Upgrade): Card
	local frame: Frame = UI.new("Frame", {
		Name = upgrade.Id,
		BackgroundColor3 = Theme.PanelLight,
		Size = UDim2.new(1, -8, 0, 92),
		LayoutOrder = order,
		Parent = parent,
	}, {
		UI.corner(12),
		UI.stroke(Theme.Stroke, 1, 0.3),
	})
	UI.new("TextLabel", {
		Name = "Icon",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 10),
		Size = UDim2.fromOffset(72, 72),
		Font = Theme.TitleFont,
		Text = upgrade.Icon,
		TextScaled = true,
		Parent = frame,
	})
	UI.new("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(92, 10),
		Size = UDim2.new(1, -260, 0, 28),
		Font = Theme.TitleFont,
		Text = upgrade.DisplayName,
		TextColor3 = Theme.Text,
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	local levelLabel: TextLabel = UI.new("TextLabel", {
		Name = "Level",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -164, 0, 12),
		Size = UDim2.fromOffset(110, 24),
		Font = Theme.BoldFont,
		Text = "",
		TextColor3 = Theme.Gold,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = frame,
	})
	local valueLabel: TextLabel = UI.new("TextLabel", {
		Name = "Value",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(92, 42),
		Size = UDim2.new(1, -260, 0, 40),
		Font = Theme.BodyFont,
		Text = "",
		TextColor3 = Theme.SubText,
		TextSize = 16,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = frame,
	})
	local button: TextButton = UI.new("TextButton", {
		Name = "Buy",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(140, 52),
		BackgroundColor3 = Theme.Green,
		Font = Theme.TitleFont,
		Text = "",
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 22,
		TextStrokeTransparency = 0.6,
		Parent = frame,
	}, {
		UI.corner(10),
	})
	UI.bounce(button)
	button.Activated:Connect(function()
		task.spawn(buy, upgrade)
	end)

	-- Description under the title.
	UI.new("TextLabel", {
		Name = "Description",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(92, 66),
		Size = UDim2.new(1, -260, 0, 20),
		Font = Theme.BodyFont,
		Text = upgrade.Description,
		TextColor3 = Color3.fromRGB(130, 136, 160),
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})
	valueLabel.Size = UDim2.new(1, -260, 0, 22)

	return { Upgrade = upgrade, Level = levelLabel, Value = valueLabel, Button = button }
end

function Shop.init(screen: ScreenGui)
	local scale = UI.scaled()
	local frame: Frame = UI.new("Frame", {
		Name = "Shop",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(660, 560),
		BackgroundColor3 = Theme.Panel,
		Visible = false,
		Parent = screen,
	}, {
		UI.corner(18),
		UI.stroke(Theme.Gold, 3, 0.1),
		scale,
	})
	window = frame
	windowScale = scale

	UI.new("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(20, 10),
		Size = UDim2.new(1, -90, 0, 50),
		Font = Theme.TitleFont,
		Text = "🛒 UPGRADE SHOP",
		TextColor3 = Theme.Gold,
		TextSize = 36,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	local cashLabel: TextLabel = UI.new("TextLabel", {
		Name = "Cash",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -74, 0, 18),
		Size = UDim2.fromOffset(240, 36),
		Font = Theme.TitleFont,
		Text = "",
		TextColor3 = Theme.Green,
		TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = frame,
	})
	local close: TextButton = UI.new("TextButton", {
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 14),
		Size = UDim2.fromOffset(44, 44),
		BackgroundColor3 = Theme.Red,
		Font = Theme.TitleFont,
		Text = "X",
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 26,
		Parent = frame,
	}, { UI.corner(10) })
	UI.bounce(close)
	close.Activated:Connect(function()
		Shop.close()
	end)

	local list: ScrollingFrame = UI.new("ScrollingFrame", {
		Name = "List",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(16, 70),
		Size = UDim2.new(1, -28, 1, -116),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Theme.Gold,
		Parent = frame,
	}, {
		UI.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for index, upgrade in Config.Upgrades do
		table.insert(cards, makeCard(list, index, upgrade))
	end

	UI.new("TextLabel", {
		Name = "Tip",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 20, 1, -10),
		Size = UDim2.new(1, -40, 0, 30),
		Font = Theme.BodyFont,
		Text = "💡 Stored items earn cash every second. Run on your warehouse treadmill (even AFK!) to outrun faster guard dogs.",
		TextColor3 = Theme.SubText,
		TextSize = 15,
		TextWrapped = true,
		Parent = frame,
	})

	local function updateCash()
		cashLabel.Text = "💰 " .. Format.money(getNumber("Cash", 0))
		if isOpen then
			refreshAll()
		end
	end
	player:GetAttributeChangedSignal("Cash"):Connect(updateCash)
	for _, upgrade in Config.Upgrades do
		player:GetAttributeChangedSignal("Level_" .. upgrade.Id):Connect(refreshAll)
	end
	updateCash()
	refreshAll()
end

function Shop.open()
	local frame, scale = window, windowScale
	if not frame or not scale or isOpen then
		return
	end
	isOpen = true
	refreshAll()
	frame.Visible = true
	local target = UI.CurrentScale
	scale.Scale = target * 0.8
	UI.tween(scale, 0.18, { Scale = target }, Enum.EasingStyle.Back)
end

function Shop.close()
	local frame = window
	if not frame or not isOpen then
		return
	end
	isOpen = false
	frame.Visible = false
end

function Shop.toggle()
	if isOpen then
		Shop.close()
	else
		Shop.open()
	end
end

function Shop.isOpen(): boolean
	return isOpen
end

return Shop
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000000000000000000000000001E41">
					<Properties>
						<string name="Name">Storage</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Storage
	-------
	The warehouse storage window. Opens from any shelf prompt in your own warehouse
	(or from the HUD's STORAGE button) and lists everything on your shelves:

	  * TAKE  — unequips an item: it comes off the shelf and back into your bag.
	  * SELL  — sells it for cash on the spot.

	Nothing is taken for granted on the client: the server (Plots.storageList /
	Plots.take / Plots.sell, reached through the Storage remote) checks that the
	warehouse is really yours and that the bag has room.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage.Shared.Format)
local Items = require(ReplicatedStorage.Shared.Items)
local Notifications = require(script.Parent.Notifications)
local UI = require(script.Parent.UI)

local StorageRemote = ReplicatedStorage.Remotes.Storage

local Storage = {}

local player = Players.LocalPlayer
local Theme = UI.Theme

local ROW_HEIGHT = 96
local CARD_COLOR = Color3.fromRGB(36, 40, 62)

local window: Frame? = nil
local windowScale: UIScale? = nil
local list: ScrollingFrame? = nil
local header: TextLabel? = nil
local empty: TextLabel? = nil
local isOpen = false
local busy = false

local function number(name: string, default: number): number
	local value = player:GetAttribute(name)
	return if type(value) == "number" then value else default
end

local function updateHeader()
	local label = header
	if label then
		label.Text = string.format(
			"📦 Shelves %d / %d   ·   🎒 Bag %d / %d   ·   💰 %s",
			number("StoredCount", 0),
			number("StorageCapacity", 0),
			number("Carried", 0),
			number("BagCapacity", 0),
			Format.money(number("Cash", 0))
		)
	end
	local hint = empty
	if hint then
		hint.Visible = #(list and list:GetChildren() or {}) == 0
	end
end

local function request(action: string?, itemId: string?): { [string]: any }?
	if busy then
		return nil
	end
	busy = true
	local ok, result = pcall(function()
		if action then
			return StorageRemote:InvokeServer(action, itemId)
		end
		return StorageRemote:InvokeServer("List")
	end)
	busy = false
	if not ok or type(result) ~= "table" then
		Notifications.show("The warehouse is busy, try again!", "error")
		return nil
	end
	return result
end

local function act(action: string, itemId: string)
	local result = request(action, itemId)
	if not result then
		return
	end
	if result.Ok then
		UI.playSound(UI.Sounds.Purchase, 0.5, if action == "Take" then 1.3 else 1.7)
	else
		UI.playSound(UI.Sounds.Error, 0.4, 1)
	end
	Notifications.show(tostring(result.Message), if result.Ok then "success" else "error")
	Storage.refresh()
end

local function makeRow(parent: Instance, order: number, itemId: string): Frame?
	local def = Items.get(itemId)
	if not def then
		return nil
	end
	local rarity = Items.getRarity(itemId)
	local color = if rarity then rarity.Color else Theme.SubText
	local frame: Frame = UI.new("Frame", {
		Name = itemId .. order,
		BackgroundColor3 = CARD_COLOR,
		Size = UDim2.new(1, -8, 0, ROW_HEIGHT),
		LayoutOrder = order,
		Parent = parent,
	}, {
		UI.corner(12),
		UI.stroke(color, 2, 0.55),
	})
	UI.itemPicture(frame, itemId, UDim2.fromOffset(84, 84), UDim2.fromOffset(6, 6))

	UI.new("TextLabel", {
		Name = "ItemName",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(100, 8),
		Size = UDim2.new(1, -320, 0, 26),
		Font = Theme.TitleFont,
		Text = def.DisplayName,
		TextColor3 = Theme.Text,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	UI.new("TextLabel", {
		Name = "Rarity",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(100, 34),
		Size = UDim2.new(1, -320, 0, 20),
		Font = Theme.BoldFont,
		Text = string.format("%s · from %s", def.Rarity, def.House),
		TextColor3 = color,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	UI.new("TextLabel", {
		Name = "Worth",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(100, 58),
		Size = UDim2.new(1, -320, 0, 24),
		Font = Theme.BoldFont,
		Text = string.format("💵 %s   ·   +%s / sec", Format.money(def.Value), Format.money(Items.getIncome(itemId))),
		TextColor3 = Theme.Green,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})

	local function button(name: string, text: string, x: number, color: Color3, callback: () -> ()): TextButton
		local button: TextButton = UI.new("TextButton", {
			Name = name,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, x, 0.5, 0),
			Size = UDim2.fromOffset(96, 46),
			BackgroundColor3 = color,
			Font = Theme.BoldFont,
			Text = text,
			TextColor3 = Color3.new(1, 1, 1),
			TextSize = 18,
			Parent = frame,
		}, { UI.corner(10) })
		UI.bounce(button)
		button.Activated:Connect(callback)
		return button
	end

	button("Take", "🎒 TAKE", -14, Theme.Blue, function()
		act("Take", itemId)
	end)
	button("Sell", "💰 " .. Format.money(Items.getSellValue(itemId)), -118, Theme.Green, function()
		act("Sell", itemId)
	end)
	return frame
end

-- Asks the server what is on the shelves and rebuilds the list.
function Storage.refresh()
	local frame, container = window, list
	if not frame or not container then
		return
	end
	local result = request(nil)
	container:ClearAllChildren()
	if result then
		for index, itemId in result.Items or {} do
			makeRow(container, index, itemId)
		end
	end
	updateHeader()
end

function Storage.init(screen: ScreenGui)
	local scale = UI.scaled()
	local frame: Frame = UI.new("Frame", {
		Name = "Storage",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(700, 520),
		BackgroundColor3 = Theme.Panel,
		Visible = false,
		Parent = screen,
	}, {
		UI.corner(18),
		UI.stroke(Theme.Blue, 3, 0.1),
		scale,
	})
	window = frame
	windowScale = scale

	UI.new("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(20, 8),
		Size = UDim2.new(1, -90, 0, 44),
		Font = Theme.TitleFont,
		Text = "📦 WAREHOUSE STORAGE",
		TextColor3 = Theme.Blue,
		TextSize = 32,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	local headerLabel: TextLabel = UI.new("TextLabel", {
		Name = "Header",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(22, 50),
		Size = UDim2.new(1, -44, 0, 24),
		Font = Theme.BoldFont,
		Text = "",
		TextColor3 = Theme.SubText,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	header = headerLabel
	local close: TextButton = UI.new("TextButton", {
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 14),
		Size = UDim2.fromOffset(44, 44),
		BackgroundColor3 = Theme.Red,
		Font = Theme.TitleFont,
		Text = "X",
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 26,
		Parent = frame,
	}, { UI.corner(10) })
	UI.bounce(close)
	close.Activated:Connect(function()
		Storage.close()
	end)

	local scrolling: ScrollingFrame = UI.new("ScrollingFrame", {
		Name = "List",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(16, 80),
		Size = UDim2.new(1, -28, 1, -142),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Theme.Blue,
		Parent = frame,
	}, {
		UI.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	list = scrolling

	UI.new("TextLabel", {
		Name = "Empty",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(20, 110),
		Size = UDim2.new(1, -40, 0, 40),
		Font = Theme.BodyFont,
		Text = "Your shelves are empty — steal something and drop it on the green DEPOSIT pad.",
		TextColor3 = Theme.SubText,
		TextSize = 18,
		TextWrapped = true,
		Parent = frame,
	})
	empty = frame:FindFirstChild("Empty") :: TextLabel

	UI.new("TextLabel", {
		Name = "Tip",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 20, 1, -10),
		Size = UDim2.new(1, -40, 0, 34),
		Font = Theme.BodyFont,
		Text = "🎒 TAKE puts an item back in your bag (sell it at the 💰 SELL POINT, or stash it again).  "
			.. "💰 SELL pays cash on the spot and frees the shelf.",
		TextColor3 = Theme.SubText,
		TextSize = 15,
		TextWrapped = true,
		Parent = frame,
	})

	for _, name in { "StoredCount", "StorageCapacity", "Carried", "BagCapacity", "Cash" } do
		player:GetAttributeChangedSignal(name):Connect(updateHeader)
	end
	updateHeader()
end

function Storage.open()
	local frame, scale = window, windowScale
	if not frame or not scale or isOpen then
		return
	end
	isOpen = true
	frame.Visible = true
	local target = UI.CurrentScale
	scale.Scale = target * 0.8
	UI.tween(scale, 0.18, { Scale = target }, Enum.EasingStyle.Back)
	task.spawn(Storage.refresh)
end

function Storage.close()
	local frame = window
	if not frame or not isOpen then
		return
	end
	isOpen = false
	frame.Visible = false
end

function Storage.toggle()
	if isOpen then
		Storage.close()
	else
		Storage.open()
	end
end

function Storage.isOpen(): boolean
	return isOpen
end

return Storage
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000000000000000000000000001E42">
					<Properties>
						<string name="Name">TreadmillController</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	TreadmillController
	-------------------
	Your personal treadmill (outside your warehouse), client side:
	  * Walk onto the belt and your character starts running by itself. You're
	    held in place on the belt, your movement keys are switched off and the
	    run animation loops, so you can go AFK. The server hands out the speed.
	  * The ESCAPE button (keybind: Space, or A on a gamepad) hops you off
	    beside the treadmill. Walk back on to start running again.
	  * A floating "YOUR TREADMILL" sign helps you find it.

	The server (Treadmills.luau) decides whether you're really training. If it
	stops you (you died, got moved away, ...) you're hopped off here too.
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Notifications = require(script.Parent.Notifications)
local UI = require(script.Parent.UI)

local TreadmillController = {}

local player = Players.LocalPlayer
local Theme = UI.Theme

local ESCAPE_ACTION = "StealAnItemTreadmillEscape"
local CONFIRM_TIMEOUT = 5 -- seconds to wait for the server to confirm before giving up
local HOLD_FORCE = 100000
local HOLD_TORQUE = 100000
local HINT_COOLDOWN = 6
-- Used if the character has no Animate script to borrow its run animation from.
local DEFAULT_RUN_R15 = "rbxassetid://507767714"
local DEFAULT_RUN_R6 = "rbxassetid://180426354"

type Mount = {
	Character: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	Treadmill: Model,
	Constraints: { Instance },
	Track: AnimationTrack?,
	TrackSpeed: number,
	AutoRotate: boolean,
	JumpEnabled: boolean,
	Confirmed: boolean,
	StartedAt: number,
}

local mount: Mount? = nil
local mountCount = 0
local armed = true -- false after hopping off until you step off the belt
local cooldownUntil = 0
local hintAt = -math.huge
local controls: any = nil

local allTreadmills: { Model } = {}

local escapeFrame: Frame? = nil
local keyCap: TextLabel? = nil
local escapeLabel: TextLabel? = nil
local signGui: BillboardGui? = nil

--------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------
-- Every warehouse's treadmill (found once the map has loaded).
local function getTreadmills(): { Model }
	if #allTreadmills > 0 then
		return allTreadmills
	end
	local map = Workspace:FindFirstChild("Map")
	local warehouses = if map then map:FindFirstChild("Warehouses") else nil
	if warehouses then
		for _, plot in warehouses:GetChildren() do
			local treadmill = plot:FindFirstChild("Treadmill")
			if treadmill and treadmill:IsA("Model") then
				table.insert(allTreadmills, treadmill)
			end
		end
	end
	return allTreadmills
end

local function getMyTreadmill(): Model?
	local index = player:GetAttribute("PlotIndex")
	if type(index) ~= "number" then
		return nil
	end
	local map = Workspace:FindFirstChild("Map")
	local warehouses = if map then map:FindFirstChild("Warehouses") else nil
	local plot = if warehouses then warehouses:FindFirstChild("Plot" .. index) else nil
	local treadmill = if plot then plot:FindFirstChild("Treadmill") else nil
	return if treadmill and treadmill:IsA("Model") then treadmill else nil
end

local function getPart(model: Model, name: string): BasePart?
	local part = model:FindFirstChild(name)
	return if part and part:IsA("BasePart") then part else nil
end

-- True when `position` (the character's root) is above the treadmill's belt.
local function isOnBelt(treadmill: Model, position: Vector3): boolean
	local belt = getPart(treadmill, "Belt")
	if not belt then
		return false
	end
	local relative = belt.CFrame:PointToObjectSpace(position)
	local half = belt.Size / 2
	return math.abs(relative.X) <= half.X + 0.25 and math.abs(relative.Z) <= half.Z and relative.Y >= 0 and relative.Y <= 7
end

local function treadmillLevel(): number
	local level = player:GetAttribute("Level_Treadmill")
	return if type(level) == "number" then level else 1
end

local function runAnimationSpeed(): number
	local settings = Config.Treadmill
	return settings.RunAnimSpeedBase + (treadmillLevel() - 1) * settings.RunAnimSpeedPerLevel
end

-- The default PlayerModule's controls, used to switch movement off while you run.
local function getControls(): any
	if controls ~= nil then
		return controls
	end
	local playerScripts = player:FindFirstChild("PlayerScripts")
	local module = if playerScripts then playerScripts:FindFirstChild("PlayerModule") else nil
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(function()
			return (require :: any)(module):GetControls()
		end)
		if ok then
			controls = result
		end
	end
	return controls
end

local function setControlsEnabled(enabled: boolean)
	local found = getControls()
	if found then
		pcall(function()
			if enabled then
				found:Enable()
			else
				found:Disable()
			end
		end)
	end
end

-- Borrows the character's own run animation (so animation packs work), with a fallback.
local function loadRunTrack(character: Model, humanoid: Humanoid): AnimationTrack?
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return nil
	end
	local animation: Animation? = nil
	local animate = character:FindFirstChild("Animate")
	local runFolder = if animate then animate:FindFirstChild("run") else nil
	if runFolder then
		animation = runFolder:FindFirstChildWhichIsA("Animation")
	end
	if not animation then
		local fallback = Instance.new("Animation")
		fallback.Name = "TreadmillRun"
		fallback.AnimationId = if humanoid.RigType == Enum.HumanoidRigType.R15 then DEFAULT_RUN_R15 else DEFAULT_RUN_R6
		animation = fallback
	end
	local ok, track = pcall(function()
		return animator:LoadAnimation(animation :: Animation)
	end)
	if not ok or not track then
		return nil
	end
	track.Priority = Enum.AnimationPriority.Action
	track.Looped = true
	return track
end

local function invokeServer(action: string): (boolean, string)
	local ok, result = pcall(function()
		return ReplicatedStorage.Remotes.Treadmill:InvokeServer(action)
	end)
	if ok and type(result) == "table" then
		return result.Ok == true, tostring(result.Message or "")
	end
	return false, "Couldn't reach the server. Try again!"
end

--------------------------------------------------------------------------------
-- UI
--------------------------------------------------------------------------------
local function updateEscapeButton()
	local frame = escapeFrame
	if not frame then
		return
	end
	frame.Visible = mount ~= nil
	local cap, label = keyCap, escapeLabel
	if cap and label then
		local key = if UserInputService.KeyboardEnabled
			then "SPACE"
			elseif UserInputService.GamepadEnabled then "A"
			else nil
		cap.Visible = key ~= nil
		cap.Text = key or ""
		label.Size = if key then UDim2.new(1, -104, 1, 0) else UDim2.fromScale(1, 1)
	end
	if signGui then
		signGui.Enabled = mount == nil
	end
end

local function createEscapeButton(screen: ScreenGui)
	local frame: Frame = UI.new("Frame", {
		Name = "TreadmillEscape",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -140),
		Size = UDim2.fromOffset(264, 60),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = screen,
	}, { UI.scaled() })
	local button: TextButton = UI.new("TextButton", {
		Name = "EscapeButton",
		AutoButtonColor = true,
		BackgroundColor3 = Theme.Red,
		Size = UDim2.fromScale(1, 1),
		Text = "",
		Parent = frame,
	}, {
		UI.corner(14),
		UI.stroke(Color3.new(1, 1, 1), 2, 0.4),
		UI.gradient(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190)),
	})
	escapeLabel = UI.new("TextLabel", {
		Name = "Label",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(1, -104, 1, 0),
		Font = Theme.TitleFont,
		Text = "ESCAPE",
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 28,
		TextStrokeTransparency = 0.5,
		Parent = button,
	})
	keyCap = UI.new("TextLabel", {
		Name = "Key",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(80, 36),
		BackgroundColor3 = Color3.fromRGB(40, 12, 16),
		BackgroundTransparency = 0.25,
		Font = Theme.BoldFont,
		Text = "SPACE",
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 18,
		Parent = button,
	}, {
		UI.corner(8),
		UI.stroke(Color3.new(1, 1, 1), 1.5, 0.5),
	})
	UI.bounce(button)
	button.Activated:Connect(function()
		UI.playSound(UI.Sounds.Click, 0.4, 1.4)
		TreadmillController.hopOff()
	end)
	escapeFrame = frame
end

-- "YOUR TREADMILL" sign over your own treadmill (hidden while you're on it).
local function attachSign()
	if signGui then
		signGui:Destroy()
		signGui = nil
	end
	local treadmill = getMyTreadmill()
	local belt = if treadmill then getPart(treadmill, "Belt") else nil
	if not belt then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "MyTreadmillSign"
	gui.Size = UDim2.fromOffset(230, 70)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 9, 0)
	gui.MaxDistance = 70
	gui.LightInfluence = 0
	gui.Adornee = belt
	gui.Parent = belt
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Size = UDim2.fromScale(1, 0.58)
	title.Font = Theme.TitleFont
	title.Text = "🏃 YOUR TREADMILL"
	title.TextScaled = true
	title.TextColor3 = Theme.Cyan
	title.TextStrokeTransparency = 0.2
	title.Parent = gui
	local subtitle = Instance.new("TextLabel")
	subtitle.Name = "Subtitle"
	subtitle.BackgroundTransparency = 1
	subtitle.Position = UDim2.fromScale(0, 0.58)
	subtitle.Size = UDim2.fromScale(1, 0.42)
	subtitle.Font = Theme.BoldFont
	subtitle.Text = "Walk on to train speed (AFK works!)"
	subtitle.TextScaled = true
	subtitle.TextColor3 = Color3.new(1, 1, 1)
	subtitle.TextStrokeTransparency = 0.3
	subtitle.Parent = gui
	signGui = gui
	updateEscapeButton()
end

--------------------------------------------------------------------------------
-- Getting on and off
--------------------------------------------------------------------------------
local function onEscapeInput(_actionName: string, state: Enum.UserInputState, _input: InputObject): Enum.ContextActionResult?
	if state == Enum.UserInputState.Begin then
		TreadmillController.hopOff()
	end
	return Enum.ContextActionResult.Sink
end

-- Puts your character back to normal. `stepOff` moves you beside the treadmill.
local function release(stepOff: boolean)
	local current = mount
	if not current then
		return
	end
	mount = nil
	ContextActionService:UnbindAction(ESCAPE_ACTION)
	for _, instance in current.Constraints do
		instance:Destroy()
	end
	if current.Track then
		current.Track:Stop(0.2)
	end
	local humanoid = current.Humanoid
	humanoid.AutoRotate = current.AutoRotate
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, current.JumpEnabled)
	setControlsEnabled(true)

	local root = current.Root
	local exitPoint = getPart(current.Treadmill, "ExitPoint")
	local alive = current.Character.Parent ~= nil and humanoid.Health > 0 and humanoid.SeatPart == nil
	if stepOff and alive and exitPoint and root.Parent then
		local target = exitPoint.Position
		root.CFrame = CFrame.new(target.X, math.max(root.Position.Y, target.Y), target.Z) * exitPoint.CFrame.Rotation
		root.AssemblyLinearVelocity = Vector3.zero
	end

	armed = false
	cooldownUntil = os.clock() + Config.Treadmill.RemountCooldown
	updateEscapeButton()
	-- Always tell the server (it's a no-op there if it already stopped you).
	task.spawn(invokeServer, "Stop")
end

local function getOn(treadmill: Model, character: Model, humanoid: Humanoid, root: BasePart)
	local runPoint = getPart(treadmill, "RunPoint")
	if not runPoint then
		return
	end
	mountCount += 1
	local myMount = mountCount

	-- Hold the character over the middle of the belt, facing the console. Only
	-- sideways forces, so the humanoid still stands on the belt normally.
	local attachment = Instance.new("Attachment")
	attachment.Name = "TreadmillAttachment"
	attachment.Parent = root
	local hold = Instance.new("AlignPosition")
	hold.Name = "TreadmillHold"
	hold.Mode = Enum.PositionAlignmentMode.OneAttachment
	hold.Attachment0 = attachment
	hold.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	hold.ForceRelativeTo = Enum.ActuatorRelativeTo.World
	hold.MaxAxesForce = Vector3.new(HOLD_FORCE, 0, HOLD_FORCE)
	hold.MaxVelocity = 40
	hold.Responsiveness = 60
	hold.Position = Vector3.new(runPoint.Position.X, root.Position.Y, runPoint.Position.Z)
	hold.Parent = root
	local facing = Instance.new("AlignOrientation")
	facing.Name = "TreadmillFacing"
	facing.Mode = Enum.OrientationAlignmentMode.OneAttachment
	facing.Attachment0 = attachment
	facing.MaxTorque = HOLD_TORQUE
	facing.Responsiveness = 40
	facing.CFrame = runPoint.CFrame.Rotation
	facing.Parent = root

	local current: Mount = {
		Character = character,
		Humanoid = humanoid,
		Root = root,
		Treadmill = treadmill,
		Constraints = { hold, facing, attachment },
		Track = loadRunTrack(character, humanoid),
		TrackSpeed = runAnimationSpeed(),
		AutoRotate = humanoid.AutoRotate,
		JumpEnabled = humanoid:GetStateEnabled(Enum.HumanoidStateType.Jumping),
		Confirmed = false,
		StartedAt = os.clock(),
	}
	mount = current

	humanoid.AutoRotate = false
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	setControlsEnabled(false)
	if current.Track then
		current.Track:Play(0.25)
		current.Track:AdjustSpeed(current.TrackSpeed)
	end
	ContextActionService:BindActionAtPriority(
		ESCAPE_ACTION,
		onEscapeInput,
		false,
		Enum.ContextActionPriority.High.Value,
		Enum.KeyCode.Space,
		Enum.KeyCode.ButtonA
	)
	updateEscapeButton()

	task.spawn(function()
		local ok, message = invokeServer("Start")
		if mount ~= current or mountCount ~= myMount then
			return -- already hopped off
		end
		if not ok then
			release(false)
			Notifications.show(message ~= "" and message or "Couldn't start training. Try again!", "error")
		elseif player:GetAttribute("Training") == true then
			current.Confirmed = true
		end
	end)
end

-- Hops off the treadmill (what the ESCAPE button and Space do).
function TreadmillController.hopOff()
	release(true)
end

function TreadmillController.isRunning(): boolean
	return mount ~= nil
end

local function step()
	local current = mount
	local character = player.Character
	if current then
		local humanoid = current.Humanoid
		if current.Character ~= character or current.Root.Parent == nil or humanoid.Health <= 0 then
			release(false)
		elseif humanoid.SeatPart ~= nil or humanoid.Sit then
			release(false)
		elseif not current.Confirmed and os.clock() - current.StartedAt > CONFIRM_TIMEOUT then
			release(false)
			Notifications.show("Couldn't start training. Try again!", "error")
		else
			local speed = runAnimationSpeed()
			if current.Track and speed ~= current.TrackSpeed then
				current.TrackSpeed = speed
				current.Track:AdjustSpeed(speed)
			end
		end
		return
	end

	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root and root:IsA("BasePart")) or humanoid.Health <= 0 or humanoid.SeatPart ~= nil then
		return
	end

	local mine = getMyTreadmill()
	if not (mine and isOnBelt(mine, root.Position)) then
		armed = true -- stepped off: walking back on starts you running again
		local now = os.clock()
		if now - hintAt > HINT_COOLDOWN then
			for _, treadmill in getTreadmills() do
				if treadmill ~= mine and isOnBelt(treadmill, root.Position) then
					hintAt = now
					Notifications.show(
						if mine
							then "🏃 That's someone else's treadmill. Yours is outside your own warehouse!"
							else "🏃 You need a warehouse to have a treadmill.",
						"info"
					)
					break
				end
			end
		end
		return
	end
	if armed and os.clock() >= cooldownUntil and player:GetAttribute("DataLoaded") == true then
		getOn(mine, character, humanoid, root)
	end
end

function TreadmillController.init(screen: ScreenGui)
	createEscapeButton(screen)
	player:GetAttributeChangedSignal("PlotIndex"):Connect(attachSign)
	task.spawn(attachSign)

	player:GetAttributeChangedSignal("Training"):Connect(function()
		local current = mount
		if not current then
			return
		end
		if player:GetAttribute("Training") == true then
			current.Confirmed = true
		elseif current.Confirmed then
			release(false) -- the server stopped your training
		end
	end)
	player.CharacterAdded:Connect(function()
		release(false)
	end)
	RunService.Heartbeat:Connect(step)
end

return TreadmillController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000000000000000000000000001E43">
					<Properties>
						<string name="Name">UI</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	UI
	--
	Tiny helpers for building the interface in code, plus the shared theme.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local ItemModels = require(ReplicatedStorage.Shared.ItemModels)

local UI = {}

UI.Theme = {
	Panel = Color3.fromRGB(28, 30, 46),
	PanelLight = Color3.fromRGB(44, 48, 72),
	Stroke = Color3.fromRGB(70, 76, 110),
	Text = Color3.fromRGB(245, 245, 250),
	SubText = Color3.fromRGB(170, 176, 200),
	Gold = Color3.fromRGB(255, 200, 60),
	Green = Color3.fromRGB(80, 220, 120),
	Red = Color3.fromRGB(255, 75, 75),
	Blue = Color3.fromRGB(70, 160, 255),
	Orange = Color3.fromRGB(255, 145, 40),
	Purple = Color3.fromRGB(185, 115, 255),
	Cyan = Color3.fromRGB(80, 230, 255),
	TitleFont = Enum.Font.FredokaOne,
	BodyFont = Enum.Font.BuilderSansMedium,
	BoldFont = Enum.Font.BuilderSansBold,
}

-- Every UIScale created through UI.scaled(), so the HUD can resize for small screens.
UI.Scales = {} :: { UIScale }
UI.CurrentScale = 1

-- Creates an instance, applies properties, and parents children.
function UI.new(className: string, props: { [string]: any }?, children: { any }?): any
	local instance = Instance.new(className)
	local parent: Instance? = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function UI.corner(radius: number?): Instance
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 10)
	return corner
end

function UI.stroke(color: Color3?, thickness: number?, transparency: number?): Instance
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or UI.Theme.Stroke
	stroke.Thickness = thickness or 2
	stroke.Transparency = transparency or 0
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	return stroke
end

function UI.padding(pixels: number): Instance
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, pixels)
	padding.PaddingBottom = UDim.new(0, pixels)
	padding.PaddingLeft = UDim.new(0, pixels)
	padding.PaddingRight = UDim.new(0, pixels)
	return padding
end

function UI.gradient(top: Color3, bottom: Color3): Instance
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(top, bottom)
	gradient.Rotation = 90
	return gradient
end

-- A UIScale that follows the global HUD scale.
function UI.scaled(): UIScale
	local scale = Instance.new("UIScale")
	scale.Scale = UI.CurrentScale
	table.insert(UI.Scales, scale)
	return scale
end

-- A little 3D picture of an item, framed to fit, for the Loot Index and the storage / sell windows.
-- Rarity auras are stripped, so the picture shows the item itself (the card's outline carries the colour).
function UI.itemPicture(parent: Instance, itemId: string, size: UDim2, position: UDim2?): ViewportFrame
	local picture: ViewportFrame = UI.new("ViewportFrame", {
		Name = "Picture",
		BackgroundColor3 = Color3.fromRGB(56, 62, 92),
		Position = position or UDim2.fromOffset(6, 6),
		Size = size,
		Ambient = Color3.fromRGB(165, 165, 175),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-0.6, -1, -0.8),
		Parent = parent,
	}, { UI.corner(10) })
	local camera = Instance.new("Camera")
	camera.FieldOfView = 34
	camera.Parent = picture
	picture.CurrentCamera = camera

	local model = ItemModels.build(itemId)
	if model then
		for _, child in model:GetChildren() do
			if child.Name == "Aura" or child.Name == "AuraGlow" then
				child:Destroy()
			end
		end
		model:PivotTo(CFrame.new())
		model.Parent = picture
	end

	-- Frame the whole item, seen from the front, a little from the right and above.
	local itemSize, center = ItemModels.getBounds(itemId)
	local radius = math.max(itemSize.Magnitude / 2, 0.5)
	local distance = radius / math.sin(math.rad(camera.FieldOfView / 2)) * 1.02
	local direction = Vector3.new(0.5, 0.42, -1).Unit
	camera.CFrame = CFrame.lookAt(center + direction * distance, center)
	return picture
end

function UI.setScale(value: number)
	UI.CurrentScale = value
	for _, scale in UI.Scales do
		scale.Scale = value
	end
end

function UI.tween(instance: Instance, seconds: number, goal: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): Tween
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		goal
	)
	tween:Play()
	return tween
end

-- Makes a button grow a little when hovered and shrink when pressed.
function UI.bounce(button: GuiButton)
	local scale = Instance.new("UIScale")
	scale.Parent = button
	button.MouseEnter:Connect(function()
		UI.tween(scale, 0.12, { Scale = 1.06 })
	end)
	button.MouseLeave:Connect(function()
		UI.tween(scale, 0.12, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		UI.tween(scale, 0.08, { Scale = 0.94 })
	end)
	button.MouseButton1Up:Connect(function()
		UI.tween(scale, 0.12, { Scale = 1.06 })
	end)
end

local soundCache: { [string]: Sound } = {}

function UI.playSound(soundId: string, volume: number?, pitch: number?)
	local key = string.format("%s|%.2f", soundId, pitch or 1)
	local sound = soundCache[key]
	if not sound then
		local newSound = Instance.new("Sound")
		newSound.SoundId = soundId
		newSound.PlaybackSpeed = pitch or 1
		newSound.Parent = SoundService
		soundCache[key] = newSound
		sound = newSound
	end
	sound.Volume = volume or 0.5
	sound:Play()
end

UI.Sounds = Config.Sounds

return UI
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000000000000000000000000001E44">
					<Properties>
						<string name="Name">VehicleController</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	VehicleController
	-----------------
	Drives your getaway car while you sit in its DriverSeat. The server gives
	the driver network ownership, so the car responds instantly.

	Controls: W/S or Up/Down = throttle, A/D or Left/Right = steer
	(gamepads and the mobile thumbstick work too, through the default
	Roblox vehicle controls that fill in VehicleSeat.ThrottleFloat/SteerFloat).

	It's an arcade hover car: a raycast keeps it floating at a fixed height
	above whatever is below it, and a LinearVelocity pushes it around.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)

local VehicleController = {
	Driving = false,
	Speed = 0,
}

local player = Players.LocalPlayer
local currentSeat: VehicleSeat? = nil
local yaw = 0
local speed = 0

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true
rayParams.IgnoreWater = true

local function yawOf(cf: CFrame): number
	local look = cf.LookVector
	return math.atan2(-look.X, -look.Z)
end

local function approach(current: number, target: number, maxDelta: number): number
	if math.abs(target - current) <= maxDelta then
		return target
	end
	return current + math.sign(target - current) * maxDelta
end

local function stopDriving()
	currentSeat = nil
	speed = 0
	VehicleController.Driving = false
	VehicleController.Speed = 0
end

local function step(dt: number)
	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	local seat = if humanoid then humanoid.SeatPart else nil
	if not (character and seat and seat:IsA("VehicleSeat") and seat.Name == "DriverSeat") then
		if currentSeat then
			stopDriving()
		end
		return
	end

	local car = seat.Parent
	if not (car and car:IsA("Model")) then
		return
	end
	local chassis = car.PrimaryPart
	if not chassis then
		return
	end
	local drive = chassis:FindFirstChild("Drive")
	local orient = chassis:FindFirstChild("Orient")
	if not (drive and drive:IsA("LinearVelocity") and orient and orient:IsA("AlignOrientation")) then
		return
	end

	if currentSeat ~= seat then
		currentSeat = seat
		yaw = yawOf(chassis.CFrame)
		speed = 0
		rayParams.FilterDescendantsInstances = { car, character }
	end

	local settings = Config.Vehicle
	local maxSpeedAttribute = car:GetAttribute("MaxSpeed")
	local maxSpeed = if type(maxSpeedAttribute) == "number" then maxSpeedAttribute else 45
	local throttle = seat.ThrottleFloat
	local steer = seat.SteerFloat

	-- Don't keep "imaginary" speed after crashing into something.
	local forward = CFrame.Angles(0, yaw, 0).LookVector
	local actual = chassis.AssemblyLinearVelocity:Dot(forward)
	if math.abs(speed) > math.abs(actual) + 8 then
		speed = actual + math.sign(speed) * 8
	end

	local target = 0
	if throttle > 0 then
		target = throttle * maxSpeed
	elseif throttle < 0 then
		target = throttle * maxSpeed * settings.ReverseFactor
	end
	local rate = settings.Acceleration
	if throttle == 0 then
		rate = settings.Coast
	elseif math.abs(speed) > 1 and math.sign(throttle) ~= math.sign(speed) then
		rate = settings.Braking
	end
	speed = approach(speed, target, rate * dt)

	-- Steering gets stronger as you speed up (and flips when reversing, like a real car).
	local turnFactor = math.clamp(math.abs(speed) / 14, 0, 1)
	local direction = if speed >= 0 then 1 else -1
	yaw -= steer * settings.TurnRate * turnFactor * direction * dt
	local rotation = CFrame.Angles(0, yaw, 0)
	orient.CFrame = rotation
	forward = rotation.LookVector

	-- Hover a fixed height above the ground.
	local origin = chassis.Position
	local hit = Workspace:Raycast(origin + Vector3.new(0, 2, 0), Vector3.new(0, -(settings.HoverHeight + 16), 0), rayParams)
	local verticalSpeed: number
	if hit then
		local desiredY = hit.Position.Y + settings.HoverHeight
		verticalSpeed = math.clamp((desiredY - origin.Y) * 8, -60, 35)
	else
		verticalSpeed = math.max(chassis.AssemblyLinearVelocity.Y - Workspace.Gravity * dt, -90)
	end

	drive.VectorVelocity = forward * speed + Vector3.new(0, verticalSpeed, 0)
	VehicleController.Driving = true
	VehicleController.Speed = math.abs(speed)
end

function VehicleController.init()
	RunService.Heartbeat:Connect(step)
end

return VehicleController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000000000000000000000000001E45">
					<Properties>
						<string name="Name">WorldEffects</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	WorldEffects
	------------
	Purely visual/audio touches that only the local player needs:
	  * Flashing sirens + beeping on houses whose alarm is going off
	  * Moving stripes on the warehouse treadmills while someone runs on them
	  * Breathing the rarity aura around Epic and Legendary loot
	  * A "YOUR WAREHOUSE" marker so you can always find your way home
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)

local WorldEffects = {}

local player = Players.LocalPlayer

type SirenHouse = {
	Model: Model,
	Sirens: { BasePart },
	Lights: { PointLight },
	BaseColors: { Color3 },
	Beeper: Sound?,
}

type Belt = {
	Model: Model,
	Part: BasePart,
	Stripes: { BasePart },
	Offset: number,
}

local SIREN_RED = Color3.fromRGB(255, 30, 30)
local SIREN_OFF = Color3.fromRGB(90, 10, 10)
local STRIPES_PER_BELT = 7

local function getMap(): Instance
	return Workspace:WaitForChild("Map")
end

--------------------------------------------------------------------------------
-- Sirens
--------------------------------------------------------------------------------
local function setupSirens(map: Instance)
	local houses: { SirenHouse } = {}
	local folder = map:WaitForChild("Houses")
	for _, model in folder:GetChildren() do
		if not model:IsA("Model") then
			continue
		end
		local sirenFolder = model:WaitForChild("Sirens", 10)
		if not sirenFolder then
			continue
		end
		local entry: SirenHouse = { Model = model, Sirens = {}, Lights = {}, BaseColors = {}, Beeper = nil }
		for _, siren in sirenFolder:GetChildren() do
			if siren:IsA("BasePart") then
				local light = Instance.new("PointLight")
				light.Color = SIREN_RED
				light.Range = 18
				light.Brightness = 4
				light.Enabled = false
				light.Parent = siren
				table.insert(entry.Sirens, siren)
				table.insert(entry.Lights, light)
				table.insert(entry.BaseColors, siren.Color)
				if not entry.Beeper then
					local beeper = Instance.new("Sound")
					beeper.Name = "AlarmBeeper"
					beeper.SoundId = Config.Sounds.AlarmBeep
					beeper.Volume = 1
					beeper.RollOffMode = Enum.RollOffMode.InverseTapered
					beeper.RollOffMinDistance = 20
					beeper.RollOffMaxDistance = 180
					beeper.Parent = siren
					entry.Beeper = beeper
				end
			end
		end
		table.insert(houses, entry)
	end

	task.spawn(function()
		local flip = false
		while true do
			flip = not flip
			for _, house in houses do
				local active = house.Model:GetAttribute("AlarmActive") == true
				for index, siren in house.Sirens do
					if active then
						siren.Color = if flip then SIREN_RED else SIREN_OFF
						house.Lights[index].Enabled = flip
					elseif house.Lights[index].Enabled or siren.Color ~= house.BaseColors[index] then
						siren.Color = house.BaseColors[index]
						house.Lights[index].Enabled = false
					end
				end
				local beeper = house.Beeper
				if active and beeper then
					-- Alternate the pitch for a "wee-woo" siren.
					beeper.PlaybackSpeed = if flip then 1.6 else 1.15
					beeper:Play()
				end
			end
			task.wait(0.25)
		end
	end)
end

--------------------------------------------------------------------------------
-- Treadmills: the belt scrolls while its owner is running on it (the server sets
-- the Running and Level attributes on each warehouse's Treadmill model).
--------------------------------------------------------------------------------
local function addBelt(belts: { Belt }, treadmill: Model)
	local beltPart = treadmill:WaitForChild("Belt", 10)
	if not (beltPart and beltPart:IsA("BasePart")) then
		return
	end
	local belt: Belt = { Model = treadmill, Part = beltPart, Stripes = {}, Offset = 0 }
	for _ = 1, STRIPES_PER_BELT do
		local stripe = Instance.new("Part")
		stripe.Name = "BeltStripe"
		stripe.Anchored = true
		stripe.CanCollide = false
		stripe.CanQuery = false
		stripe.CanTouch = false
		stripe.CastShadow = false
		stripe.Size = Vector3.new(beltPart.Size.X - 0.1, 0.02, 0.3)
		stripe.Color = Color3.fromRGB(70, 70, 78)
		stripe.Material = Enum.Material.SmoothPlastic
		stripe.Parent = beltPart
		table.insert(belt.Stripes, stripe)
	end
	table.insert(belts, belt)
end

local function setupTreadmills(map: Instance)
	local folder = map:WaitForChild("Warehouses")
	local belts: { Belt } = {}
	for _, plot in folder:GetChildren() do
		local treadmill = plot:FindFirstChild("Treadmill")
		if treadmill and treadmill:IsA("Model") then
			addBelt(belts, treadmill)
		end
	end

	local settings = Config.Treadmill
	RunService.RenderStepped:Connect(function(dt: number)
		for _, belt in belts do
			local part = belt.Part
			local length = part.Size.Z
			local spacing = length / STRIPES_PER_BELT
			if belt.Model:GetAttribute("Running") == true then
				local level = belt.Model:GetAttribute("Level")
				local speed = settings.BeltSpeedBase
					+ (if type(level) == "number" then level - 1 else 0) * settings.BeltSpeedPerLevel
				-- The belt runs from the console towards the back, under the runner's feet.
				belt.Offset = (belt.Offset + speed * dt) % spacing
			end
			for index, stripe in belt.Stripes do
				local z = -length / 2 + ((index - 1) * spacing + belt.Offset) % length
				stripe.CFrame = part.CFrame * CFrame.new(0, part.Size.Y / 2 + 0.012, z)
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- Rarity auras: Epic and Legendary loot carries a glowing shell (built by
-- shared/ItemModels.luau in the item's rarity colour). Breathe it gently, and
-- keep the outline glow in step with it.
--------------------------------------------------------------------------------
local AURA_RANGE = 260 -- studs; further away than this the glow is only wasted work

type Aura = {
	Shell: BasePart,
	Glow: Highlight?,
	Size: number,
}

local function setupAuras()
	local camera = Workspace.CurrentCamera
	local auras: { Aura } = {}
	local elapsed = 0

	local function add(instance: Instance)
		if instance:IsA("BasePart") and instance.Name == "Aura" and instance.Parent then
			local stored = instance:GetAttribute("AuraSize")
			table.insert(auras, {
				Shell = instance,
				Glow = instance.Parent:FindFirstChild("AuraGlow") :: Highlight?,
				Size = if type(stored) == "number" then stored else instance.Size.X,
			})
		end
	end

	Workspace.DescendantAdded:Connect(function(instance)
		if instance.Name == "Aura" then
			add(instance)
		end
	end)
	for _, instance in Workspace:GetDescendants() do
		add(instance)
	end

	RunService.RenderStepped:Connect(function(dt: number)
		elapsed += dt
		local view = camera and camera.CFrame.Position
		local wave = math.sin(elapsed * 2.2)
		for index = #auras, 1, -1 do
			local aura = auras[index]
			local shell = aura.Shell
			if not shell.Parent then
				table.remove(auras, index)
				continue
			end
			-- Only animate what the player could actually see.
			if view and (shell.Position - view).Magnitude > AURA_RANGE then
				continue
			end
			shell.Transparency = Config.Aura.Transparency + wave * Config.Aura.Pulse
			shell.Size = Vector3.one * (aura.Size * (1 + wave * 0.04))
			local glow = aura.Glow
			if glow then
				glow.FillTransparency = math.clamp(Config.Aura.FillTransparency + wave * 0.08, 0, 0.95)
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- Warehouse marker
--------------------------------------------------------------------------------
local function setupWarehouseMarker(map: Instance)
	local folder = map:WaitForChild("Warehouses")
	local billboard: BillboardGui? = nil
	local distanceLabel: TextLabel? = nil
	local target: BasePart? = nil

	local function attach()
		if billboard then
			billboard:Destroy()
			billboard = nil
		end
		local index = player:GetAttribute("PlotIndex")
		if type(index) ~= "number" then
			return
		end
		local plot = folder:FindFirstChild("Plot" .. index)
		local marker = if plot then plot:FindFirstChild("Marker") else nil
		if not (marker and marker:IsA("BasePart")) then
			return
		end
		target = marker
		local gui = Instance.new("BillboardGui")
		gui.Name = "HomeMarker"
		gui.Size = UDim2.fromOffset(200, 64)
		gui.AlwaysOnTop = true
		gui.LightInfluence = 0
		gui.MaxDistance = 100000
		gui.Adornee = marker
		gui.Parent = marker
		local title = Instance.new("TextLabel")
		title.BackgroundTransparency = 1
		title.Size = UDim2.fromScale(1, 0.6)
		title.Font = Enum.Font.FredokaOne
		title.Text = "🏠 YOUR WAREHOUSE"
		title.TextScaled = true
		title.TextColor3 = Color3.fromRGB(120, 255, 150)
		title.TextStrokeTransparency = 0.2
		title.Parent = gui
		local distance = Instance.new("TextLabel")
		distance.BackgroundTransparency = 1
		distance.Position = UDim2.fromScale(0, 0.6)
		distance.Size = UDim2.fromScale(1, 0.4)
		distance.Font = Enum.Font.BuilderSansBold
		distance.TextScaled = true
		distance.TextColor3 = Color3.new(1, 1, 1)
		distance.TextStrokeTransparency = 0.3
		distance.Parent = gui
		billboard = gui
		distanceLabel = distance
	end

	player:GetAttributeChangedSignal("PlotIndex"):Connect(attach)
	attach()

	task.spawn(function()
		while true do
			task.wait(0.3)
			local gui, label, marker = billboard, distanceLabel, target
			local character = player.Character
			local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
			if gui and label and marker and root and root:IsA("BasePart") then
				local studs = (root.Position - marker.Position).Magnitude
				gui.Enabled = studs > 45
				label.Text = string.format("%d studs", math.floor(studs))
			end
		end
	end)
end

function WorldEffects.init()
	local map = getMap()
	task.spawn(setupSirens, map)
	task.spawn(setupTreadmills, map)
	task.spawn(setupWarehouseMarker, map)
	setupAuras()
end

return WorldEffects
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
	</Item>
</roblox>
